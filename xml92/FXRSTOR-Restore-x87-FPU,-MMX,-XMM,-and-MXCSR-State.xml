 <operation name="FXRSTOR" variant_kind="Standard variant" mnemonic="FXRSTOR64">
  <code>let linear_address := Compute_Linear_Address(segment, effective_address);</code>
  <code></code>
  <code>if Is_Alignment_Checking_Enabled() then</code>
  <code>    Check_Alignment?(linear_address, 16);</code>
  <code>endif;</code>
  <code>if not Is_Aligned(linear_address, 16) then</code>
  <code>    Report_General_Protection_Exception!(Zero(32));</code>
  <code>endif;</code>
  <code></code>
  <code>// check readability of the last byte</code>
  <code>Check_Logical_Address_Is_Readable?(segment, effective_address + 511, 8);</code>
  <code></code>
  <code>let cw_sw      := Logical_Mem_Read?(segment, effective_address + 0, 32);</code>
  <code>let tag_opcode := Logical_Mem_Read?(segment, effective_address + 4, 32);</code>
  <code>let fip_fcs    := Logical_Mem_Read?(segment, effective_address + 8, 64);</code>
  <code>let fdp_fds    := Logical_Mem_Read?(segment, effective_address + 16, 64);</code>
  <code></code>
  <code>let new_mxcsr : MXCSR_Type := Logical_Mem_Read?(segment, effective_address + 24, 32);</code>
  <code>Check_MXCSR_Reserved_Bits?(new_mxcsr);</code>
  <code>MXCSR := new_mxcsr;</code>
  <code></code>
  <code>// begin to commit FP state</code>
  <code>FP87_Control := cw_sw[0 +: 16];</code>
  <code>FP87_Control.RESERVED_ONE := 0b1;</code>
  <code>FP87_Control.RESERVED_ZERO := Zero(4);</code>
  <code></code>
  <code>FP87_Status := cw_sw[16 +: 16];</code>
  <code>FP87_Status.ES := 0b0;</code>
  <code>FP87_Status.B := 0b0;</code>
  <code></code>
  <code>FP87_FOP := tag_opcode[16 +: 11];</code>
  <code></code>
  <code>if is_FXRSTOR64 then</code>
  <code>    FP87_FIP := Set_Canonical_Wrt_Max_Size(fip_fcs);</code>
  <code>    FP87_FCS := Zero(16);</code>
  <code>    FP87_FDP := fdp_fds;</code>
  <code>    FP87_FDS := Zero(16);</code>
  <code>else</code>
  <code>    FP87_FIP := Zero_Extend(fip_fcs[0 +: 32], 64);</code>
  <code>    FP87_FCS := fip_fcs[32 +: 16];</code>
  <code>    FP87_FDP := Zero_Extend(fdp_fds[0 +: 32], 64);</code>
  <code>    FP87_FDS := fdp_fds[32 +: 16];</code>
  <code>endif;</code>
  <code></code>
  <code>FP87::Process_Exceptions(FP87_Status.Exception_Flags);</code>
  <code></code>
  <code>// FP registers</code>
  <code>let fp_offset := 32;</code>
  <code>for i := 0 to 7 do</code>
  <code>    ST[i] := Logical_Mem_Read?(segment, effective_address + fp_offset + (i * 16), 80);</code>
  <code>endfor;</code>
  <code></code>
  <code>// now that FP regsister are loaded, update tag word information</code>
  <code>FP87_Tag_Word := FP87::Expand_Abridged_Tag_Word(tag_opcode[0 +: 8]);</code>
  <code></code>
  <code>if CR4.OSFXSR == 0b1 then</code>
  <code>    // XMM registers</code>
  <code>    let xmm_offset := 160;</code>
  <code>    let num_xmm_regs := if In_64Bit_Mode() then 16 else 8;</code>
  <code>    for i := 0 to num_xmm_regs - 1 do</code>
  <code>        XMM[i] := Logical_Mem_Read?(segment, effective_address + xmm_offset + (i * 16), 128);</code>
  <code>    endfor;</code>
  <code>endif;</code>
