 <operation name="LLDT" variant_kind="Standard variant" mnemonic="LLDT">
  <code>let ldtr_selector : Segment_Selector := segment_selector;</code>
  <code></code>
  <code>if Is_Local_Segment_Selector(ldtr_selector) then</code>
  <code>    Report_General_Protection_Exception!(Get_Error_Code_From_Selector(ldtr_selector));</code>
  <code>endif;</code>
  <code></code>
  <code>if Is_Null_Segment_Selector(ldtr_selector) then</code>
  <code>    LDTR := Null_Segment(LDTR);</code>
  <code>    LDTR.selector := ldtr_selector;</code>
  <code>else</code>
  <code>    if Is_Local_Segment_Selector(ldtr_selector) then</code>
  <code>        Report_General_Protection_Exception!(Get_Error_Code_From_Selector(ldtr_selector));</code>
  <code>    endif;</code>
  <code></code>
  <code>    var new_ldtr := Load_Segment_Descriptor?(ldtr_selector, LDTR);</code>
