 <operation name="LSS" variant_kind="Standard variant" mnemonic="LSS">
  <code>let ss_selector : Segment_Selector := segment_selector;</code>
  <code>let mode := Current_Mode();</code>
  <code></code>
  <code>if mode in { Real_Address_Mode, Virtual_8086_Mode } then</code>
  <code>    SS := Load_Real_Or_VM86_Segment(mode, ss_selector, SS);</code>
  <code>else</code>
  <code>    if In_64Bit_Mode() then</code>
  <code>        if Is_Null_Segment_Selector(ss_selector) then</code>
  <code>            if Unsigned(ss_selector.RPL) == 3 or Unsigned(ss_selector.RPL) != CPL then</code>
  <code>                Report_General_Protection_Exception!(Zero(32));</code>
  <code>            endif;</code>
  <code>        endif;</code>
  <code>    else // protected mode</code>
  <code>        if Is_Null_Segment_Selector(ss_selector) then</code>
  <code>            Report_General_Protection_Exception!(Zero(32));</code>
  <code>        endif;</code>
  <code>    endif;</code>
  <code></code>
  <code>    if Unsigned(ss_selector.RPL) != CPL then</code>
  <code>        Report_General_Protection_Exception!(Get_Error_Code_From_Selector(ss_selector));</code>
  <code>    endif;</code>
  <code></code>
  <code>    var new_ss  := Load_Segment_Descriptor?(ss_selector, SS);</code>
  <code></code>
  <code>    if Unsigned(new_ss.descriptor.DPL) != CPL</code>
  <code>        or not Is_Data_Segment(new_ss)</code>
  <code>        or new_ss.descriptor.W == 0b0</code>
  <code>    then</code>
  <code>        Report_General_Protection_Exception!(Get_Error_Code_From_Selector(ss_selector));</code>
  <code>    endif;</code>
  <code></code>
  <code>    if new_ss.descriptor.P == 0b0 then</code>
  <code>        Report_Stack_Fault!(Get_Error_Code_From_Selector(ss_selector));</code>
  <code>    endif;</code>
  <code></code>
  <code>    if new_ss.descriptor.A == 0b0 then</code>
  <code>        new_ss := Set_Segment_Access_Bit?(new_ss);</code>
  <code>    endif;</code>
  <code></code>
  <code>    SS := new_ss;</code>
  <code>endif;</code>
  <code></code>
  <code>let result := offset;</code>
