 <operation name="LOAD_FARPTR" variant_kind="Standard variant" mnemonic="LFS">
  <code>let mode := Current_Mode(); // todo: this intermediate assigment is needed because of a limitation of the C code generator</code>
  <code>case mode of</code>
  <code>    when Real_Address_Mode =&gt;</code>
  <code>        Segment_Register[seg_reg] := Load_Real_Or_VM86_Segment(Real_Address_Mode, segment_selector, Segment_Register[seg_reg]);</code>
  <code></code>
  <code>    when Virtual_8086_Mode =&gt;</code>
  <code>        Segment_Register[seg_reg] := Load_Real_Or_VM86_Segment(Virtual_8086_Mode, segment_selector, Segment_Register[seg_reg]);</code>
  <code></code>
  <code>    when IA32e_Mode if In_64Bit_Mode() =&gt;</code>
  <code>        case seg_reg of</code>
  <code>            when Seg_Reg_DS, Seg_Reg_ES =&gt;</code>
  <code>                Report_Invalid_Opcode!();</code>
  <code>            when Seg_Reg_FS, Seg_Reg_GS =&gt;</code>
  <code>                Segment_Register[seg_reg] := Load_Data_Segment?(segment_selector, Segment_Register[seg_reg], RFLAGS);</code>
  <code>            otherwise =&gt;</code>
  <code>                Std::Unreachable();</code>
  <code>        endcase;</code>
  <code></code>
  <code>    otherwise =&gt; // Protected or compatibility mode</code>
  <code>        Segment_Register[seg_reg] := Load_Data_Segment?(segment_selector, Segment_Register[seg_reg], RFLAGS);</code>
  <code>endcase;</code>
  <code></code>
  <code>let result := offset;</code>
