 <operation name="PCMPISTRI" variant_kind="Standard variant" mnemonic="VPCMPISTRI">
  <code>let (num_bits, is_signed, aggregation_operation, polarity, output_selection) :=</code>
  <code>    PCMPxSTRx_Decode_Immediate(imm8);</code>
  <code></code>
  <code>let num_elements : {8, 16} := 128 / num_bits;</code>
  <code></code>
  <code>var cmp_result : array [16] of array [16] of Boolean;</code>
  <code></code>
  <code>for j := 0 to num_elements - 1 do</code>
  <code>    for i := 0 to num_elements - 1 do</code>
  <code>        cmp_result[j][i] :=</code>
  <code>            if num_bits == 16 then</code>
  <code>                PCMPxSTRx_Compare(16, src1[i *: 16], src2[j *: 16], i, is_signed, aggregation_operation)</code>
  <code>            else</code>
  <code>                PCMPxSTRx_Compare(8, src1[i *: 8], src2[j *: 8], i, is_signed, aggregation_operation);</code>
  <code>    endfor;</code>
  <code>endfor;</code>
  <code></code>
  <code>let src1_eos := PCMPxSTRx_Find_End_Of_String(num_bits, src1);</code>
  <code>let src2_eos := PCMPxSTRx_Find_End_Of_String(num_bits, src2);</code>
  <code></code>
  <code>let intermediate_result1 := PCMPxSTRx_Aggregation_Operation(</code>
  <code>                                aggregation_operation, cmp_result, src1, src2,</code>
  <code>                                src1_eos, src2_eos, num_elements);</code>
  <code></code>
  <code>let intermediate_result2 := PCMPxSTRx_Apply_Polarity(polarity, intermediate_result1, src2_eos, num_elements);</code>
  <code></code>
  <code>// Output Selection</code>
  <code>if Is_Zero(intermediate_result2[0 +: num_elements]) then</code>
  <code>    RCX := num_elements[0 +: 64];</code>
  <code>elsif output_selection == 0b0 then // Least significant index</code>
  <code>    let lowest_bit := Count_Trailing_Zero_Bits(intermediate_result2);</code>
  <code>    RCX := lowest_bit[0 +: 64];</code>
  <code>else // 0b1 -&gt; Most significant index</code>
  <code>    let highest_bit := 15 - Count_Leading_Zero_Bits(intermediate_result2);</code>
  <code>    RCX := highest_bit[0 +: 64];</code>
  <code>endif;</code>
  <code></code>
  <code>PCMPxSTRx_Update_Flags(intermediate_result2, src1_eos, src2_eos, num_elements);</code>
