 <operation name="TDPBF16PS" variant_kind="Standard variant" mnemonic="TDPBF16PS">
  <code>if srcdest_index == src1_index</code>
  <code>    or src1_index == src2_index</code>
  <code>    or srcdest_index == src2_index</code>
  <code>    or (TMM[srcdest_index].Colsb % 4) != 0</code>
  <code>    or (TMM[src1_index].Colsb % 4) != 0</code>
  <code>    or (TMM[src2_index].Colsb % 4) != 0</code>
  <code>    or TMM[srcdest_index].Colsb != TMM[src2_index].Colsb</code>
  <code>    or TMM[srcdest_index].Rows  != TMM[src1_index].Rows</code>
  <code>    or (TMM[src1_index].Colsb / 4) != TMM[src2_index].Rows</code>
  <code>    or TMM[srcdest_index].Colsb &gt; Unsigned(CPUID_TMUL_MAXN)</code>
  <code>    or TMM[src2_index].Colsb &gt; Unsigned(CPUID_TMUL_MAXN)</code>
  <code>    or (TMM[src1_index].Colsb / 4) &gt; Unsigned(CPUID_TMUL_MAXK)</code>
  <code>    or TMM[src2_index].Rows &gt; Unsigned(CPUID_TMUL_MAXK)</code>
  <code>then</code>
  <code>    Report_Invalid_Opcode!();</code>
  <code>endif;</code>
  <code></code>
  <code>let srcdest_elements_per_row := TMM[srcdest_index].Colsb / 4;</code>
  <code>let src1_elements_per_row := TMM[src1_index].Colsb / 4;</code>
  <code></code>
  <code>assert Tile::Palette_Table[Tile::Config.Palette].Bytes_Per_Row == 64;</code>
  <code></code>
  <code>for m := 0 to TMM[srcdest_index].Rows - 1 do</code>
  <code>    var temp_row_data := Zero(1024);</code>
  <code>    let src1_row := TMM[src1_index].Data[m *: 512];</code>
  <code>    var srcdest_row_data := TMM[srcdest_index].Data[m *: 512];</code>
  <code></code>
  <code>    for k := 0 to src1_elements_per_row - 1 do</code>
  <code>        let src2_row := TMM[src2_index].Data[k *: 512];</code>
  <code></code>
  <code>        // BF16 format is defined as the upper 16 bits of an IEEE-754 FP32 value;</code>
  <code>        // concatenating 16 zero bits in the low part (src ++ Zero(16)) produces</code>
  <code>        // the corresponding FP32 encoding for this instruction.</code>
  <code>        let src1_fp32_0 := src1_row[((2*k)+0) *: 16] ++ Zero(16);</code>
  <code>        let src1_fp32_1 := src1_row[((2*k)+1) *: 16] ++ Zero(16);</code>
  <code></code>
  <code>        for n := 0 to srcdest_elements_per_row - 1 do</code>
  <code>            let src2_fp32_0 := src2_row[((2*n)+0) *: 16] ++ Zero(16);</code>
  <code>            let src2_fp32_1 := src2_row[((2*n)+1) *: 16] ++ Zero(16);</code>
  <code></code>
  <code>            let (fma_0, _) := FP::FMA(src1_fp32_0, src2_fp32_0, temp_row_data[((2*n)+0) *: 32],</code>
  <code>                                      denormals_are_zeros=&gt;True,</code>
  <code>                                      rm=&gt;Rounding_Mode_RNE,</code>
  <code>                                      flush_subnormals=&gt;True);</code>
  <code>            let (fma_1, _) := FP::FMA(src1_fp32_1, src2_fp32_1, temp_row_data[((2*n)+1) *: 32],</code>
  <code>                                      denormals_are_zeros=&gt;True,</code>
  <code>                                      rm=&gt;Rounding_Mode_RNE,</code>
  <code>                                      flush_subnormals=&gt;True);</code>
  <code></code>
  <code>            temp_row_data[((2*n)+0) *: 32] := fma_0;</code>
  <code>            temp_row_data[((2*n)+1) *: 32] := fma_1;</code>
  <code>        endfor;</code>
  <code>    endfor;</code>
  <code></code>
  <code>    for n := 0 to srcdest_elements_per_row - 1 do</code>
  <code>        let (pair_sum, _) := FP::Arithmetic(FP_ADD,</code>
  <code>                                            temp_row_data[((2*n)+0) *: 32],</code>
  <code>                                            temp_row_data[((2*n)+1) *: 32],</code>
  <code>                                            denormals_are_zeros=&gt;True,</code>
  <code>                                            rm=&gt;Rounding_Mode_RNE,</code>
  <code>                                            flush_subnormals=&gt;True,</code>
  <code>                                            mask_underflow=&gt;True);</code>
  <code></code>
  <code>        let (r, _) := FP::Arithmetic(FP_ADD, srcdest_row_data[n *: 32], pair_sum,</code>
  <code>                                     denormals_are_zeros=&gt;True,</code>
  <code>                                     rm=&gt;Rounding_Mode_RNE,</code>
  <code>                                     flush_subnormals=&gt;True,</code>
  <code>                                     mask_underflow=&gt;True);</code>
  <code></code>
  <code>        srcdest_row_data[n *: 32] := r;</code>
  <code>    endfor;</code>
  <code></code>
  <code>    Tile::Write_Row_And_Zero_Extend(srcdest_index, m, srcdest_row_data);</code>
  <code>endfor;</code>
  <code></code>
  <code>Tile::Zero_Upper_Rows(srcdest_index);</code>
  <code>Tile::Config.Start_Row := 0;</code>
