 <operation name="SHA1RNDS4" variant_kind="Standard variant" mnemonic="SHA1RNDS4">
  <code>var result := Zero(128);</code>
  <code></code>
  <code>// K-constants</code>
  <code>let k0 := 0x5A82_7999;</code>
  <code>let k1 := 0x6ED9_EBA1;</code>
  <code>let k2 := 0x8F1B_BCDC;</code>
  <code>let k3 := 0xCA62_C1D6;</code>
  <code></code>
  <code>var a := src1[127:96];</code>
  <code>var b := src1[95:64];</code>
  <code>var c := src1[63:32];</code>
  <code>var d := src1[31:0];</code>
  <code></code>
  <code>var w0e := src2[127:96];</code>
  <code>var w1  := src2[95:64];</code>
  <code>var w2  := src2[63:32];</code>
  <code>var w3  := src2[31:0];</code>
  <code></code>
  <code>var e := Zero(32);</code>
  <code></code>
  <code>var t := Zero(32);</code>
  <code>case src3[1:0] of</code>
  <code>    when 0b00 =&gt; t := F0(b, c, d) + Rotate_Left(a, 5) + w0e + k0;</code>
  <code>    when 0b01 =&gt; t := F1(b, c, d) + Rotate_Left(a, 5) + w0e + k1;</code>
  <code>    when 0b10 =&gt; t := F2(b, c, d) + Rotate_Left(a, 5) + w0e + k2;</code>
  <code>    when 0b11 =&gt; t := F3(b, c, d) + Rotate_Left(a, 5) + w0e + k3;</code>
  <code>endcase;</code>
  <code></code>
  <code>e := d;</code>
  <code>d := c;</code>
  <code>c := Rotate_Left(b, 30);</code>
  <code>b := a;</code>
  <code>a := t;</code>
  <code></code>
  <code>for i := 1 to 3 do</code>
  <code>    t := Zero(32);</code>
  <code></code>
  <code>    case i[1:0] of</code>
  <code>        when 0b01 =&gt; t := Rotate_Left(a, 5) + w1 + e;</code>
  <code>        when 0b10 =&gt; t := Rotate_Left(a, 5) + w2 + e;</code>
  <code>        when 0b11 =&gt; t := Rotate_Left(a, 5) + w3 + e;</code>
  <code>    endcase;</code>
  <code>    case src3[1:0] of</code>
  <code>        when 0b00 =&gt; t := F0(b, c, d) + k0 + t;</code>
  <code>        when 0b01 =&gt; t := F1(b, c, d) + k1 + t;</code>
  <code>        when 0b10 =&gt; t := F2(b, c, d) + k2 + t;</code>
  <code>        when 0b11 =&gt; t := F3(b, c, d) + k3 + t;</code>
  <code>    endcase;</code>
  <code></code>
  <code>    e := d;</code>
  <code>    d := c;</code>
  <code>    c := Rotate_Left(b, 30);</code>
  <code>    b := a;</code>
  <code>    a := t;</code>
  <code>endfor;</code>
