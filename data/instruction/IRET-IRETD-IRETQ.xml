 <operation name="IRET" variant_kind="Standard variant" mnemonic="IRETD">
  <code>Serialize_Instructions();</code>
  <code></code>
  <code>let mode := Current_Mode();</code>
  <code>var new_rip := Zero(64);</code>
  <code>var new_rsp := Zero(64);</code>
  <code>var new_cs_selector : Segment_Selector;</code>
  <code>var new_flags := RFLAGS;</code>
  <code></code>
  <code>if VMX_Operation_Mode == VMX_Non_Root then</code>
  <code>    if VMCS::Pin_Based_VM_Exec_Controls.NMI_Exiting == 0b0 then</code>
  <code>        Event_Blocked.NMI_BLOCKED := False;</code>
  <code>    elsif VMCS::Pin_Based_VM_Exec_Controls.Virtual_NMIs == 0b1 then</code>
  <code>        Event_Blocked.VIRT_NMI_BLOCKED := False;</code>
  <code>    endif;</code>
  <code>else</code>
  <code>    Event_Blocked.NMI_BLOCKED := False;</code>
  <code>endif;</code>
  <code></code>
  <code>case mode of</code>
  <code>    when Real_Address_Mode =&gt;</code>
  <code>        (new_rip, new_cs_selector, new_flags, new_rsp) := Iret_Pop_RIP_CS_Flags?(operand_size);</code>
  <code></code>
  <code>        if operand_size == 32 then</code>
  <code>            new_flags.VM   := RFLAGS.VM;</code>
  <code>            new_flags.VIP  := RFLAGS.VIP;</code>
  <code>            new_flags.VIF  := RFLAGS.VIF;</code>
  <code>        endif;</code>
  <code></code>
  <code>        let new_cs := Load_Real_Or_VM86_Segment(Real_Address_Mode, new_cs_selector, CS);</code>
  <code>        Check_New_RIP?(new_cs, new_rip);</code>
  <code>        RFLAGS := new_flags;</code>
  <code>        RSP := new_rsp;</code>
  <code>        Branch_Far(new_cs, new_rip);</code>
  <code></code>
  <code>   when Virtual_8086_Mode =&gt;</code>
  <code>        if RFLAGS.IOPL != 0b11 then</code>
  <code>            if CR4.VME == 0b0 or operand_size == 32 then</code>
  <code>                Report_General_Protection_Exception!(Zero(32));</code>
  <code>            endif;</code>
  <code>        endif;</code>
  <code></code>
  <code>        (new_rip, new_cs_selector, new_flags, new_rsp) := Iret_Pop_RIP_CS_Flags?(operand_size);</code>
  <code></code>
  <code>        let new_cs := Load_Real_Or_VM86_Segment(Virtual_8086_Mode, new_cs_selector, CS);</code>
  <code>        Check_New_RIP?(new_cs, new_rip);</code>
  <code></code>
  <code>        if RFLAGS.IOPL != 0b11 then</code>
  <code>            if new_flags.TF == 0b1</code>
  <code>                or (RFLAGS.VIP == 0b1 and new_flags.IF == 0b1)</code>
  <code>            then</code>
  <code>                Report_General_Protection_Exception!(Zero(32));</code>
  <code>            endif;</code>
  <code></code>
  <code>            // transfer new IF to VIF</code>
  <code>            RFLAGS.VIF := new_flags.IF;</code>
  <code></code>
  <code>            // IF and TF not modified by popped value</code>
  <code>            new_flags.IF   := RFLAGS.IF;</code>
  <code>            new_flags.TF   := RFLAGS.TF;</code>
  <code>        endif;</code>
  <code></code>
  <code>        // IOPL not modified by popped value</code>
  <code>        new_flags.IOPL := RFLAGS.IOPL;</code>
  <code></code>
  <code>        if operand_size == 32 then</code>
  <code>            // VM, VIF and VIP not modified by popped value</code>
  <code>            new_flags.VM  := RFLAGS.VM;</code>
  <code>            new_flags.VIF := RFLAGS.VIF;</code>
  <code>            new_flags.VIP := RFLAGS.VIP;</code>
  <code>            RFLAGS := new_flags;</code>
  <code>        else // operand_size == 16</code>
  <code>            RFLAGS[0 +: 16] := new_flags[0 +: 16];</code>
  <code>        endif;</code>
  <code></code>
  <code>        RSP := new_rsp;</code>
  <code>        Branch_Far(new_cs, new_rip);</code>
  <code></code>
  <code>    when Protected_Mode =&gt;</code>
  <code>        if RFLAGS.NT == 0b1 then</code>
  <code>            Task_Return?(Next_IP);</code>
  <code>        else</code>
  <code>            (new_rip, new_cs_selector, new_flags, new_rsp) := Iret_Pop_RIP_CS_Flags?(operand_size);</code>
  <code></code>
  <code>            if new_flags.VM == 0b1 and CPL == 0 then</code>
  <code>                Iret_To_Virtual_8086_Mode?(operand_size, new_cs_selector, new_flags, new_rip, new_rsp);</code>
  <code>            else</code>
  <code>                Iret_Protected_Or_IA32e_Mode?(operand_size, new_cs_selector, new_rip, new_flags, new_rsp);</code>
  <code>            endif;</code>
  <code>        endif;</code>
  <code>    when IA32e_Mode =&gt;</code>
  <code>        if RFLAGS.NT == 0b1 then</code>
  <code>            Report_General_Protection_Exception!(Zero(32));</code>
  <code>        endif;</code>
  <code></code>
  <code>        (new_rip, new_cs_selector, new_flags, new_rsp) := Iret_Pop_RIP_CS_Flags?(operand_size);</code>
  <code></code>
  <code>        if CR4.FRED == 0b1 and Unsigned(new_cs_selector.RPL) &gt; CPL then</code>
  <code>            Report_General_Protection_Exception!(Get_Error_Code_From_Selector(new_cs_selector));</code>
  <code>        endif;</code>
  <code></code>
  <code>        Iret_Protected_Or_IA32e_Mode?(operand_size, new_cs_selector, new_rip, new_flags, new_rsp);</code>
  <code>endcase;</code>
