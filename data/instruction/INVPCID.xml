 <operation name="INVPCID" variant_kind="Standard variant" mnemonic="INVPCID">
  <code>if not Is_Zero(descriptor[63:12]) then</code>
  <code>    Report_General_Protection_Exception!(Zero(32));</code>
  <code>endif;</code>
  <code></code>
  <code>case Unsigned(src) of</code>
  <code>    when 0 =&gt; // individual-address invalidation</code>
  <code>        let pcid := descriptor[11:0];</code>
  <code>        let l_addr := descriptor[127:64];</code>
  <code></code>
  <code>        if (CR4.PCIDE == 0b0 and not Is_Zero(pcid))</code>
  <code>            or not Is_Canonical_Wrt_Max_Size(l_addr) then</code>
  <code>            Report_General_Protection_Exception!(Zero(32));</code>
  <code>        endif;</code>
  <code></code>
  <code>        // Invalidate mappings for l_addr associated with pcid except global translations;</code>
  <code>        TLB::Invalidate_By_PCID_And_Address(pcid, l_addr, invalidate_global_translations=&gt;False);</code>
  <code>    when 1 =&gt; // single PCID invalidation</code>
  <code>        let pcid := descriptor[11:0];</code>
  <code></code>
  <code>        if (CR4.PCIDE == 0b0 and not Is_Zero(pcid)) then</code>
  <code>            Report_General_Protection_Exception!(Zero(32));</code>
  <code>        endif;</code>
  <code></code>
  <code>        let current_pcid := if CR4.PCIDE == 0b1 then CR3[11:0] else Zero(12);</code>
  <code>        if pcid == current_pcid then</code>
  <code>            Monitor::Clear_FSM();</code>
  <code>        endif;</code>
  <code></code>
  <code>        // Invalidate all mappings associated with pcid except global translations;</code>
  <code>        TLB::Invalidate_By_PCID(pcid, invalidate_global_translations=&gt;False);</code>
  <code>    when 2 =&gt; // all PCID invalidation including global translations</code>
  <code>        TLB::Invalidate_All_Entries(invalidate_global_translations=&gt;True);</code>
  <code>    when 3 =&gt; // all PCID invalidation retaining global translations</code>
  <code>        TLB::Invalidate_All_Entries(invalidate_global_translations=&gt;False);</code>
  <code>    otherwise =&gt;</code>
  <code>        Report_General_Protection_Exception!(Zero(32));</code>
  <code>endcase;</code>
