      <text x="60.12632751464844" y="38.25" font-family="Verdana" font-size="9.9" fill="black"><tspan x="60.12632751464844" dy="11.88" font-family="Verdana" text-anchor="start">Fixed Point Length</tspan><tspan x="60.12632751464844" dy="11.88" font-family="Verdana" text-anchor="start">Number of fixed points to subtract</tspan></text>
      <text x="3" y="65.01" font-family="Verdana" font-size="9.9" fill="black"><tspan x="3" dy="11.88" font-family="Verdana" text-anchor="start">Suppress Precision Exceptions (SPE)</tspan><tspan x="3" dy="11.88" font-family="Verdana" text-anchor="start">imm8[3] = 0b0 : Use MXCSR exception mask</tspan><tspan x="3" dy="11.88" font-family="Verdana" text-anchor="start">imm8[3] = 0b1 : Suppress</tspan></text>
      <text x="933.6577663421631" y="38.25" font-family="Verdana" font-size="9.9" fill="black"><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">Round Control Override (RC)</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b00 : Round nearest even</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b01 : Round down</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b10 : Round up</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b11 : Truncate</tspan></text>
      <text x="933.6577663421631" y="100.65" font-family="Verdana" font-size="9.9" fill="black"><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">Round Select (RS)</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[2] = 0b0 : Use imm8[1:0]</tspan><tspan x="933.6577663421631" dy="11.88" font-family="Verdana" text-anchor="start">imm8[2] = 0b1 : Use MXCSR</tspan></text>
      <path d="M 440.6577663421631 23.25 v 26.880000000000003 h -209.2708339691162" stroke="white" stroke-width="2.7" fill="transparent" opacity="70%"/><path d="M 440.6577663421631 23.25 v 26.880000000000003 h -209.2708339691162" stroke="dimgray" stroke-width="0.7" fill="transparent"/><path d="M 640.6577663421631 23.25 v 59.58000000000001 h -409.2708339691162" stroke="white" stroke-width="2.7" fill="transparent" opacity="70%"/><path d="M 640.6577663421631 23.25 v 59.58000000000001 h -409.2708339691162" stroke="dimgray" stroke-width="0.7" fill="transparent"/><path d="M 840.6577663421631 23.25 v 44.7 h 93" stroke="white" stroke-width="2.7" fill="transparent" opacity="70%"/><path d="M 840.6577663421631 23.25 v 44.7 h 93" stroke="dimgray" stroke-width="0.7" fill="transparent"/><path d="M 720.6577663421631 23.25 v 95.22 h 213" stroke="white" stroke-width="2.7" fill="transparent" opacity="70%"/><path d="M 720.6577663421631 23.25 v 95.22 h 213" stroke="dimgray" stroke-width="0.7" fill="transparent"/></svg></imageobject></mediaobject></figure><para unique="1046225">Handling of special case of input values are listed in <link unique="1046224" linkend="#49295: 06_Table: Table 5-24. VREDUCEPD Special Cases" xrefstyle="TableNum">Table 5&#8209;27</link>.</para>
