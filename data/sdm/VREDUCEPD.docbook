     <td><para unique="1046266"/>
      </td>
     <td><para unique="1046268">RNI, Src1 &lt; 0</para>
      </td>
     <td><para unique="1046270">Round (Src1+2<superscript>-M</superscript>) *</para>
      </td>
     </tr>
