      <rect x="760.6577663421631" y="8.25" width="160" height="15" fill="whitesmoke" stroke="dimgray"/>
      <text x="840.6577663421631" y="18.72" font-family="Verdana" font-size="9.9" fill="black" text-anchor="middle">RC</text>
      <line x1="760.6577663421631" y1="8.25" x2="760.6577663421631" y2="0" stroke="gray"/><line x1="920.6577663421631" y1="8.25" x2="920.6577663421631" y2="0" stroke="gray"/><text x="762.6577663421631" y="6.25" font-family="Verdana" font-size="7.5" fill="gray">1</text>
      <text x="918.6577663421631" y="6.25" font-family="Verdana" font-size="7.5" fill="gray" text-anchor="end">0</text>
