   <tbody>
    <tr>
     <td colspan="2"><para unique="1091405">66 0F 38 17 /r</para>
      <para unique="1091406">PTEST xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091410">RM</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE4_1</para>
      </td>
     <td><para unique="1091416">Set ZF if xmm2/m128 AND xmm1 result is all 0s. Set CF if xmm2/m128 AND NOT xmm1 result is all 0s.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.66.0F38.WIG 17 /r</para>
      <para unique="1091419">VPTEST xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091423">RM</para>
      </td>
     <td><para unique="1091425">V/V</para>
      </td>
     <td><para unique="1091427">AVX</para>
      </td>
     <td><para unique="1091429">Set ZF and CF depending on bitwise AND and ANDN of sources.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091431">VEX.256.66.0F38.WIG 17 /r</para>
      <para unique="1091432">VPTEST ymm1, ymm2/m256</para>
      </td>
     <td><para unique="1091436">RM</para>
      </td>
     <td><para unique="1091438">V/V</para>
      </td>
     <td><para unique="1091440">AVX</para>
      </td>
     <td><para unique="1091442">Set ZF and CF depending on bitwise AND and ANDN of sources.</para>
      </td>
     </tr>
    </tbody>
   </table>
