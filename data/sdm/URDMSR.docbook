   <col width="50.92776pt"/>
   <col width="213.65352000000001pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1092278">F2 0F 38 F8 11:rrr:bbb </para>
      <para unique="1092279">URDMSR r64, r64</para>
      </td>
