     <td><para unique="1261225">A</para>
      </td>
     <td><para unique="1261227">V/V</para>
      </td>
     <td><para unique="1261232">AVX</para>
      </td>
     <td><para unique="1261234">Compare low single precision floating-point values in xmm1 and xmm2/mem32 and set the EFLAGS flags accordingly.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261664">EVEX.LLIG.0F.W0 2F /r</para>
      <para unique="1261665">VCOMISS xmm1, xmm2/m32{sae}</para>
      </td>
     <td><para unique="1261669">B</para>
