      </td>
     <td valign="middle"><para unique="1091735">VEX.vvvv (r)</para>
      </td>
     <td valign="middle"><para unique="1091737">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1091739">N/A</para>
      </td>
     </tr>
    <tr>
     <td valign="middle"><para unique="1091741">C</para>
      </td>
