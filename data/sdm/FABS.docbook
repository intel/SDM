<instruction name="FABS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Absolute Value</shortdesc>
 <encoding_table><table unique="1261192">
   <thead><tr>
     <th><para unique="1261194">Opcode</para>
      </th>
     <th><para unique="1261196">Instruction</para>
      </th>
     <th><para unique="1261198">64-Bit Mode</para>
      </th>
     <th><para unique="1261200">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261202">Description</para>
      </th>
     </tr>
    </thead><col width="86.46192pt"/>
   <col width="116.22024pt"/>
   <col width="35.72856pt"/>
   <col width="55.90872pt"/>
   <col width="216.80568pt"/>
   <tbody>
    <tr>
     <td><para unique="1261204">D9 E1</para>
      </td>
     <td><para unique="1261206">FABS</para>
      </td>
     <td><para unique="1261208">Valid</para>
      </td>
     <td><para unique="1261210">Valid</para>
      </td>
     <td><para unique="1261212">Replace ST with its absolute value.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <longdesc><para unique="1261215">Clears the sign bit of ST(0) to create the absolute value of the operand. The following table shows the results obtained when creating the absolute value of various classes of numbers.&#8232;</para>
  <table unique="1261216">
   <caption>Results Obtained from FABS </caption>
   <col width="246.62232pt"/>
   <col width="263.05416pt"/>
   <tbody>
    <tr>
     <th><para unique="1261222">ST(0) SRC</para>
      </th>
     <th><para unique="1261224">ST(0) DEST</para>
      </th>
     </tr>
    <tr>
     <td><para unique="1261226">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261228">+ &#8734;</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261230">&#8722; <sans>F</sans></para>
      </td>
     <td><para unique="1261232">+ <sans>F</sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261234">&#8722; <sans>0</sans></para>
      </td>
     <td><para unique="1261236">+ <sans>0</sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261238">+ 0</para>
      </td>
     <td><para unique="1261240">+ <sans>0</sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261242">+ <sans>F</sans></para>
      </td>
     <td><para unique="1261244">+ <sans>F</sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261246">+ &#8734;</para>
      </td>
     <td><para unique="1261248">+ &#8734;</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261250">NaN</para>
      </td>
     <td><para unique="1261252"><sans>NaN </sans></para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261254">NOTES:</para>
      <para unique="1261255">F	Means finite floating-point value.</para>
      </td>
     </tr>
    </tbody>
   </table>
  <para unique="1261258">This instruction&#8217;s operation is the same in non-64-bit modes and 64-bit mode.</para>
  </longdesc>
 <operation>
  <programlisting>ST(0) := |ST(0)|;</programlisting>
  </operation>
 <subsection title="FPU Flags Affected">
  <variablelist>
   <variablelistentry>
    <term>C1</term>
    <listitem><para unique="1261262">Set to 0.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>C0, C2, C3 </term>
    <listitem><para unique="1261263">Undefined.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Floating-Point Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#IS</term>
    <listitem><para unique="1261265">Stack underflow occurred.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#NM</term>
    <listitem><para unique="1261267">CR0.EM[bit 2] or CR0.TS[bit 3] = 1.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261268">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261270" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261272" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261274" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261276" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 </instruction>
