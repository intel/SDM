   <col width="269.25048000000004pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1012543">Opcode/Instruction</para>
      </th>
     <th><para unique="1012547">Op/ En</para>
      </th>
     <th><para unique="1012549">64/32bit Mode Support</para>
      </th>
     <th><para unique="1012551">CPUID Feature Flag</para>
      </th>
     <th><para unique="1012553">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1012555">C7 F8</para>
      <para unique="1012556">XBEGIN rel16</para>
      </td>
     <td><para unique="1012560">A</para>
      </td>
     <td><para unique="1012562">V/V</para>
      </td>
     <td><para unique="1012564">RTM</para>
      </td>
     <td><para unique="1012566">Specifies the start of an RTM region. Provides a 16-bit relative offset to compute the address of the fallback instruction address at which execution resumes following an RTM abort.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1012568">C7 F8</para>
      <para unique="1012569">XBEGIN rel32</para>
      </td>
     <td><para unique="1012573">A</para>
      </td>
     <td><para unique="1012575">V/V</para>
      </td>
     <td><para unique="1012577">RTM</para>
      </td>
     <td><para unique="1012579">Specifies the start of an RTM region. Provides a 32-bit relative offset to compute the address of the fallback instruction address at which execution resumes following an RTM abort.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012581">
   <col width="42.940079999999995pt"/>
