  <section level="7">
   <title unique="1092249">VPUNPCKLDQ (EVEX Encoded Instructions)</title>
   <programlisting>(KL, VL) = (4, 128), (8, 256), (16, 512)
FOR j := 0 TO KL-1
	i := j * 32
	IF (EVEX.b = 1) AND (SRC2 *is memory*)
		THEN TMP_SRC2[i+31:i] := SRC2[31:0]
		ELSE TMP_SRC2[i+31:i] := SRC2[i+31:i]
	FI;
ENDFOR;
IF VL = 128
	TMP_DEST[VL-1:0] := INTERLEAVE_DWORDS(SRC1[VL-1:0], TMP_SRC2[VL-1:0])
FI;
