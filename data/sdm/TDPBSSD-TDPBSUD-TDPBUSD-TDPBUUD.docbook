  </encoding_table>
 <operand_table><table unique="1091457">
   <col width="43.01352pt"/>
   <col width="61.01352pt"/>
   <col width="95.65272pt"/>
   <col width="104.62608pt"/>
   <col width="103.85784pt"/>
   <col width="102.5676pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091459">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091461">Tuple</para>
      </th>
     <th valign="middle"><para unique="1091463">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091465">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091467">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091469">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091471">A</para>
      </td>
     <td valign="middle"><para unique="1091473">N/A</para>
      </td>
     <td valign="middle"><para unique="1091475">ModRM:reg (r, w)</para>
      </td>
     <td valign="middle"><para unique="1091477">ModRM:r/m (r)</para>
      </td>
