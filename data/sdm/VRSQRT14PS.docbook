 <shortdesc>Compute Approximate Reciprocals of Square Roots of Packed Float32 Values</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="66.99816pt"/>
   <col width="66.99816pt"/>
   <col width="29.994480000000003pt"/>
