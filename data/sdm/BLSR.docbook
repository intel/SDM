   <thead><tr>
     <th colspan="2"><para unique="1261194">Opcode/<anchor id="+418410"/>Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64/32-bit Mode</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">VEX.LZ.0F38.W0 F3 /1</para>
      <para unique="1261207">BLSR r32, r/m32</para>
      </td>
     <td><para unique="1261211">VM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">BMI1</para>
      </td>
     <td><para unique="1261217">Reset lowest set bit of r/m32, keep all other bits of r/m32 and write result to r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.LZ.0F38.W1 F3 /1</para>
      <para unique="1261220">BLSR r64, r/m64</para>
      </td>
     <td><para unique="1261224">VM</para>
      </td>
     <td><para unique="1261226">V/N.E.</para>
      </td>
     <td><para unique="1261228">BMI1</para>
      </td>
     <td><para unique="1261230">Reset lowest set bit of r/m64, keep all other bits of r/m64 and write result to r64.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261232">
