 <shortdesc>Reset Lowest Set Bit</shortdesc>
 <encoding_table><table unique="1261191">
   <col width="49.89168pt"/>
   <col width="70.98336pt"/>
   <col width="26.87472pt"/>
   <col width="38.999520000000004pt"/>
