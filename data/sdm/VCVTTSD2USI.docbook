<instruction name="VCVTTSD2USI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert With Truncation Scalar Double Precision Floating-Point Value to Unsigned Integer</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="80.6652pt"/>
   <col width="80.6652pt"/>
