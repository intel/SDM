<instruction name="CVTPD2PI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Packed Double Precision Floating-Point Values to Packed Dword Integers</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="93.3408pt"/>
   <col width="105.88392pt"/>
   <col width="29.56824pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="190.25424pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 2D /r</para>
      <para unique="1261207">CVTPD2PI mm, xmm/m128</para>
      </td>
     <td><para unique="1261211">RM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE2</para>
      </td>
     <td><para unique="1261217">Convert two packed double precision floating-point values from xmm/m128 to two packed signed doubleword integers in mm.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261219">
   <col width="46.149840000000005pt"/>
   <col width="120.74688pt"/>
   <col width="120.51071999999999pt"/>
   <col width="109.61712pt"/>
   <col width="117.19512pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261221">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261223">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261225">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261227">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261229">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261231">RM</para>
      </td>
     <td valign="middle"><para unique="1261233">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261235">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261237">N/A</para>
