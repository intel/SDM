  <variablelist>
   <variablelistentry>
    <term>#GP</term>
    <listitem><para unique="1091573">If a memory operand effective address is outside the CS, DS, ES, FS, or GS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#SS</term>
    <listitem><para unique="1091574">If a memory operand effective address is outside the SS segment limit.</para>
     </listitem>
