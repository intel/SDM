<instruction name="VRSQRT14SD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Compute Approximate Reciprocal of Square Root of Scalar Float64 Value</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="71.6652pt"/>
   <col width="71.6652pt"/>
   <col width="28.494pt"/>
   <col width="48.74976pt"/>
   <col width="66.91608000000001pt"/>
   <col width="223.08408000000003pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046088">Op / En</para>
      </th>
     <th><para unique="1046090">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046092">CPUID Feature Flag</para>
      </th>
     <th><para unique="1046094">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046545">EVEX.LLIG.66.0F38.W1 4F /r</para>
      <para unique="1046546">VRSQRT14SD xmm1 {k1}{z}, xmm2, xmm3/m64</para>
      </td>
     <td><para unique="1046550">A</para>
      </td>
     <td><para unique="1046552">V/V</para>
      </td>
     <td><para unique="1046557">AVX512F</para>
      <para unique="1046561">OR AVX10.1<anchor id="+634464"/></para>
      </td>
     <td><para unique="1046563">Computes the approximate reciprocal square root of the scalar double precision floating-point value in xmm3/m64 and stores the result in the low quadword element of xmm1 using writemask k1. Bits[127:64] of xmm2 is copied to xmm1[127:64]. </para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1046112">
   <col width="35.15112pt"/>
   <col width="71.15039999999999pt"/>
   <col width="101.72232pt"/>
   <col width="101.14416pt"/>
   <col width="99.52776pt"/>
   <col width="101.24064pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1046114">Op/En</para>
      </th>
     <th valign="middle"><para unique="1046116">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1046118">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1046120">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1046122">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1046124">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1046126">A</para>
      </td>
     <td valign="middle"><para unique="1046128">Tuple1 Scalar</para>
      </td>
     <td valign="middle"><para unique="1046130">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1046132">EVEX.vvvv (r)</para>
      </td>
     <td valign="middle"><para unique="1046134">ModRM:r/m (r)</para>
