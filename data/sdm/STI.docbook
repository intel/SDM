      </th>
     <th><para unique="1091400">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="98.96256pt"/>
   <col width="112.26168000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="180.65448pt"/>
   <tbody>
    <tr>
     <td><para unique="1091404">FB</para>
      </td>
     <td><para unique="1091406">STI</para>
      </td>
     <td><para unique="1091408">ZO</para>
      </td>
     <td><para unique="1091410">Valid</para>
      </td>
     <td><para unique="1091412">Valid</para>
      </td>
     <td><para unique="1091414">Set interrupt flag; external, maskable interrupts enabled at the end of the next instruction.</para>
