<instruction name="VCVTSH2SD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Low FP16 Value to an FP64 Value</shortdesc>
 <longdesc><para unique="1045937">
   <string>This instruction converts the low FP16 element in the second source operand to a FP64 element in the low element of the destination operand.</string></para>
  <para unique="1045938">
   <string>Bits 127:64 of the destination operand are copied from the corresponding bits of the first source operand. Bits MAXVL-1:128 of the destination operand are zeroed. The low FP64 element of the destination is updated according to the writemask.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>VCVTSH2SD __m128d _mm_cvt_roundsh_sd (__m128d a, __m128h b, const int sae);</string><string>
</string><string>VCVTSH2SD __m128d _mm_mask_cvt_roundsh_sd (__m128d src, __mmask8 k, __m128d a, __m128h b, const int sae);</string><string>
</string><string>VCVTSH2SD __m128d _mm_maskz_cvt_roundsh_sd (__mmask8 k, __m128d a, __m128h b, const int sae);</string><string>
</string><string>VCVTSH2SD __m128d _mm_cvtsh_sd (__m128d a, __m128h b);</string><string>
</string><string>VCVTSH2SD __m128d _mm_mask_cvtsh_sd (__m128d src, __mmask8 k, __m128d a, __m128h b);</string><string>
</string><string>VCVTSH2SD __m128d _mm_maskz_cvtsh_sd (__mmask8 k, __m128d a, __m128h b);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1045957">
   <string>Invalid, Denormal.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1045962">
   <string>EVEX-encoded instructions, see </string><link linkend="63155: 06_Table: Table 2-47. Type E3 Class Exception Conditions"><string>Table&#160;2&#8209;49, &#8220;Type E3 Class Exception Conditions.&#8221;</string></link></para>
  </subsection>
 </instruction>
