<instruction name="KADDW/KADDB/KADDQ/KADDD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>ADD Two Masks</shortdesc>
 <longdesc><para unique="1261275">
   <string>Adds the vector mask k2 and the vector mask k3, and writes the result into vector mask k1.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>KADDW __mmask16 _kadd_mask16 (__mmask16 a, __mmask16 b);</string><string>
</string><string>KADDB __mmask8 _kadd_mask8 (__mmask8 a, __mmask8 b);</string><string>
</string><string>KADDQ __mmask64 _kadd_mask64 (__mmask64 a, __mmask64 b);</string><string>
</string><string>KADDD __mmask32 _kadd_mask32 (__mmask32 a, __mmask32 b);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1261298">
   <string>None.</string></para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1261300">
   <string>None.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1261305" format="xIndent1">
   <string>See </string><link linkend="42536: 06_Table: Table 2-63. TYPE K20 Exception Definition (VEX-Encoded OpMask"><string>Table&#160;2&#8209;65, &#8220;TYPE K20 Exception Definition (VEX-Encoded OpMask Instructions w/o Memory Arg).&#8221;</string></link></para>
  </subsection>
 </instruction>
