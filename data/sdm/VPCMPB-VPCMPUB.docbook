     <td colspan="2"><para unique="1046740">EVEX.128.66.0F3A.W0 3F /r ib</para>
      <para unique="1046741">VPCMPB k1 {k2}, xmm2, xmm3/m128, imm8</para>
      </td>
     <td><para unique="1046745">A</para>
      </td>
     <td><para unique="1046747">V/V</para>
      </td>
     <td><para unique="1046749">(AVX512VL AND</para>
      <para unique="1046750">AVX512BW) OR AVX10.1<anchor id="+723121"/></para>
      </td>
     <td><para unique="1046755">Compare packed signed byte values in xmm3/m128 and xmm2 using bits 2:0 of imm8 as a comparison predicate with writemask k2 and leave the result in mask register k1.</para>
      </td>
