  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1261371">If a memory operand effective address is outside the CS, DS, ES, FS or GS segments.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#SS(0)</term>
    <listitem><para unique="1261372">If a memory operand effective address is outside the SS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#PF (fault-code)</term>
    <listitem><para unique="1261373">For a page fault.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#AC(0)</term>
    <listitem><para unique="1261374">If alignment checking is enabled and an unaligned memory reference is made while the current privilege level is 3.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1261375">If CPUID.01H:ECX.SSE4_2[20] = 0.</para>
     </listitem>
    <listitem><para unique="1261376">If LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
