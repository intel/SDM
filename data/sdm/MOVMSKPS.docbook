      </th>
     <th valign="middle"><para unique="1091450">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091452">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091454">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091456">RM</para>
      </td>
     <td valign="middle"><para unique="1091458">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091460">ModRM:r/m (r)</para>
