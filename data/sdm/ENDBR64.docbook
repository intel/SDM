<instruction name="ENDBR64">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Terminate an Indirect Branch in 64-bit Mode</shortdesc>
 <longdesc><para unique="1261245">
   <string>Terminate an indirect branch in 64 bit mode. This opcode is a NOP when CET indirect branch tracking is not enabled, on processors that do not support CET, and outside 64-bit mode.</string></para>
  </longdesc>
 <subsection title="Flags Affected">
  <para unique="1261258">
   <string>None.</string></para>
  </subsection>
 <subsection title="Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
