      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">VEX.LZ.0F38.W0 F3 /3</para>
      <para unique="1261207">BLSI r32, r/m32</para>
      </td>
     <td><para unique="1261211">VM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">BMI1</para>
      </td>
     <td><para unique="1261217">Extract lowest set bit from r/m32 and set that bit in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.LZ.0F38.W1 F3 /3</para>
      <para unique="1261220">BLSI r64, r/m64</para>
      </td>
     <td><para unique="1261224">VM</para>
      </td>
     <td><para unique="1261226">V/N.E.</para>
      </td>
     <td><para unique="1261228">BMI1</para>
      </td>
     <td><para unique="1261230">Extract lowest set bit from r/m64, and set that bit in r64.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261232">
