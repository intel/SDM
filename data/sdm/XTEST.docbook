<instruction name="XTEST">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Test if in Transactional Execution</shortdesc>
 <encoding_table><table unique="1012542">
   <col width="51.955200000000005pt"/>
   <col width="73.91951999999999pt"/>
   <col width="27.49968pt"/>
   <col width="48.74976pt"/>
   <col width="44.24976pt"/>
   <col width="266.25023999999996pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1012544">Opcode/Instruction</para>
      </th>
     <th><para unique="1012548">Op/ En</para>
      </th>
     <th><para unique="1012550">64/32bit Mode Support</para>
      </th>
     <th><para unique="1012552">CPUID Feature Flag</para>
      </th>
     <th><para unique="1012554">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1012556">NP 0F 01 D6</para>
      <para unique="1012557">XTEST</para>
      </td>
     <td><para unique="1012561">ZO</para>
      </td>
     <td><para unique="1012563">V/V</para>
      </td>
     <td><para unique="1012565">HLE or RTM</para>
      </td>
     <td><para unique="1012567">Test if executing in a transactional region.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012569">
   <col width="44.52119999999999pt"/>
   <col width="110.65248pt"/>
   <col width="118.32624000000001pt"/>
   <col width="115.53551999999999pt"/>
   <col width="122.18544pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1012571">Op/En</para>
      </th>
     <th valign="middle"><para unique="1012573">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1012575">Operand2</para>
      </th>
     <th valign="middle"><para unique="1012577">Operand3</para>
      </th>
     <th valign="middle"><para unique="1012579">Operand4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1012581">ZO</para>
      </td>
     <td valign="middle"><para unique="1012583">N/A</para>
      </td>
     <td valign="middle"><para unique="1012585">N/A</para>
      </td>
     <td valign="middle"><para unique="1012587">N/A</para>
      </td>
