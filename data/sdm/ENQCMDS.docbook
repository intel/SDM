    <tr>
     <td colspan="2"><para unique="1261206">F3 0F 38 F8 !(11):rrr:bbb</para>
      <para unique="1261207">ENQCMDS r32/r64, m512</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">ENQCMD</para>
      </td>
     <td><para unique="1261217">Atomically enqueue 64-byte command with PASID from source memory operand to destination offset in ES segment specified in register operand as offset in ES segment.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261219">
   <col width="40.757760000000005pt"/>
   <col width="47.381040000000006pt"/>
   <col width="96.76512pt"/>
   <col width="109.79856pt"/>
   <col width="108.99216pt"/>
   <col width="107.63784pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261221">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261223">Tuple</para>
