</string><string>PADDB 	__m128i _mm_add_epi8 (__m128i a,__m128i b );</string><string>
</string><string>PADDW 	__m128i _mm_add_epi16 ( __m128i a, __m128i b);</string><string>
</string><string>PADDD 	 __m128i _mm_add_epi32 ( __m128i a, __m128i b);</string><string>
