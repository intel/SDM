 <shortdesc>Convert With Truncation Packed Single Precision Floating-Point Values to Packed Signed Doubleword Integer Values</shortdesc>
 <encoding_table><table unique="1261192">
   <col width="79.4988pt"/>
   <col width="79.4988pt"/>
   <col width="28.494pt"/>
