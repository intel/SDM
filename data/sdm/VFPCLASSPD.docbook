<instruction name="VFPCLASSPD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Tests Types of Packed Float64 Values</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="54.208079999999995pt"/>
   <col width="77.12496pt"/>
   <col width="28.499760000000002pt"/>
   <col width="50.83272pt"/>
   <col width="78.75pt"/>
   <col width="221.83416pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1045888">Opcode/</para>
      <para unique="1045889">Instruction</para>
      </th>
     <th><para unique="1045893">Op / En</para>
      </th>
     <th><para unique="1045895">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045897">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045899">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046610">EVEX.128.66.0F3A.W1 66 /r ib</para>
      <para unique="1046611">VFPCLASSPD k2 {k1}, xmm2/m128/m64bcst, imm8</para>
      </td>
     <td><para unique="1046615">A</para>
      </td>
     <td><para unique="1046617">V/V</para>
      </td>
     <td><para unique="1046619">(AVX512VL AND</para>
      <para unique="1046620">AVX512DQ) OR AVX10.1<anchor id="+955952"/></para>
      </td>
     <td><para unique="1046625">Tests the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046596">EVEX.256.66.0F3A.W1 66 /r ib</para>
      <para unique="1046597">VFPCLASSPD k2 {k1}, ymm2/m256/m64bcst, imm8</para>
      </td>
     <td><para unique="1046601">A</para>
      </td>
     <td><para unique="1046603">V/V</para>
      </td>
     <td><para unique="1046605">(AVX512VL AND</para>
      <para unique="1046606">AVX512DQ) OR AVX10.1<anchor id="+309912"/></para>
      </td>
     <td><para unique="1046608">Tests the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046582">EVEX.512.66.0F3A.W1 66 /r ib</para>
      <para unique="1046583">VFPCLASSPD k2 {k1}, zmm2/m512/m64bcst, imm8</para>
      </td>
     <td><para unique="1046587">A</para>
      </td>
     <td><para unique="1046589">V/V</para>
      </td>
     <td><para unique="1046591">AVX512DQ </para>
      <para unique="1046592">OR AVX10.1<anchor id="+181965"/></para>
      </td>
     <td><para unique="1046594">Tests the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
