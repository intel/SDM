    <tr>
     <td colspan="2"><para unique="1046737">EVEX.128.66.0F3A.W1 1F /r ib</para>
      <para unique="1046738">VPCMPQ k1 {k2}, xmm2, xmm3/m128/m64bcst, imm8</para>
      </td>
     <td><para unique="1046742">A</para>
      </td>
     <td><para unique="1046744">V/V</para>
      </td>
     <td><para unique="1046746">(AVX512VL AND</para>
      <para unique="1046750">AVX512F) OR AVX10.1<anchor id="+862748"/></para>
      </td>
     <td><para unique="1046755">Compare packed signed quadword integer values in xmm3/m128/m64bcst and xmm2 using bits 2:0 of imm8 as a comparison predicate with writemask k2 and leave the result in mask register k1.</para>
      </td>
     </tr>
