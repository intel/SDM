VFPCLASSPS __mmask8 _mm256_fpclass_ps_mask( __m256 a, int c)
VFPCLASSPS __mmask8 _mm256_mask_fpclass_ps_mask( __mmask8 m, __m256 a, int c)
VFPCLASSPS __mmask8 _mm_fpclass_ps_mask( __m128 a, int c)
VFPCLASSPS __mmask8 _mm_mask_fpclass_ps_mask( __mmask8 m, __m128 a, int c)</programlisting>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046033">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046038">See <link unique="1046036" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#79250: 06_Table: Table 2-49. Type E4 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;51, &#8220;Type E4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046039">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1046040">If EVEX.vvvv != 1111B.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
