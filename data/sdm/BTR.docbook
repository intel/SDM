   </variablelist>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261349" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#SS(0)</term>
    <listitem><para unique="1261351">If a memory address referencing the SS segment is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1261352">If the memory address is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#PF(fault-code)</term>
