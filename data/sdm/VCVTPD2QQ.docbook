 <shortdesc>Convert Packed Double Precision Floating-Point Values to Packed Quadword Integers</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="51.59448pt"/>
   <col width="73.40472pt"/>
   <col width="29.7pt"/>
   <col width="48.74976pt"/>
