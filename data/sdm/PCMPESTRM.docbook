   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091404">66 0F 3A 60 /r imm8</para>
      <para unique="1091405">PCMPESTRM xmm1, xmm2/m128, imm8</para>
