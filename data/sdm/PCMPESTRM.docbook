  <section level="7">
   <title unique="1091555"><string>SIMD Floating-Point Exceptions</string></title>
   <para unique="1091556">
    <string>None.</string></para>
   </section>
  <section level="7">
   <title unique="1091557"><string>Other Exceptions</string></title>
   <para unique="1091561" format="xIndent1">
    <string>See </string><link linkend="25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions"><string>Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions,&#8221;</string></link><string> additionally, this instruction does not cause #GP if the memory operand is not aligned to 16 Byte boundary, and:</string></para>
   <variablelist>
    <variablelistentry>
     <term><string>#UD</string></term>
     <listitem><string>If VEX.L = 1.</string></listitem>
     <listitem><string>If VEX.vvvv &#8800; 1111B.</string></listitem>
     </variablelistentry>
    </variablelist>
   </section>
  </longdesc>
 </instruction>
