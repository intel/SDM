  <para unique="1046256">VRCP14PS __m512 _mm512_mask_rcp14_ps(__m512 s, __mmask16 k, __m512 a);</para>
  <para unique="1046257">VRCP14PS __m512 _mm512_maskz_rcp14_ps( __mmask16 k, __m512 a);</para>
  <para unique="1046258">VRCP14PS __m256 _mm256_rcp14_ps( __m256 a);</para>
  <para unique="1046259">VRCP14PS __m256 _mm512_mask_rcp14_ps(__m256 s, __mmask8 k, __m256 a);</para>
  <para unique="1046260">VRCP14PS __m256 _mm512_maskz_rcp14_ps( __mmask8 k, __m256 a);</para>
  <para unique="1046261">VRCP14PS __m128 _mm_rcp14_ps( __m128 a);</para>
  <para unique="1046262">VRCP14PS __m128 _mm_mask_rcp14_ps(__m128 s, __mmask8 k, __m128 a);</para>
  <para unique="1046263">VRCP14PS __m128 _mm_maskz_rcp14_ps( __mmask8 k, __m128 a);</para>
  </subsection>
