      </th>
     </tr>
    <tr>
     <td><para unique="1046193" format="CellBodyL">
       <string>0 &#8804; X &#8804; 2</string><superscript><string>-128</string></superscript></para>
      </td>
     <td><para unique="1046195" format="CellBodyL">
       <string>INF</string></para>
      </td>
     <td><para unique="1046197" format="CellBodyL">
       <string>Very small denormal</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046199" format="CellBodyL">
       <string>-2</string><superscript><string>-128 </string></superscript><string>&#8804; X &#8804; -0</string></para>
      </td>
     <td><para unique="1046201" format="CellBodyL">
       <string>-INF</string></para>
      </td>
     <td><para unique="1046203" format="CellBodyL">
       <string>Very small denormal</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046205" format="CellBodyL">
       <string>X &gt; 2</string><superscript><string>126</string></superscript></para>
      </td>
     <td><para unique="1046207" format="CellBodyL">
       <string>Underflow</string></para>
      </td>
     <td><para unique="1046212" format="CellBodyL">
       <string>Up to 18 bits of fractions are returned</string><footnote><para unique="1046211" format="TableFootnote">
         <string>In this case, the mantissa is shifted right by one or two bits.</string></para>
        </footnote></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046214" format="CellBodyL">
       <string>X &lt; -2</string><superscript><string>126</string></superscript></para>
      </td>
     <td><para unique="1046216" format="CellBodyL">
       <string>-Underflow</string></para>
      </td>
     <td><para unique="1046218" format="CellBodyL">
       <string>Up to 18 bits of fractions are returned</string><superscript><string>1</string></superscript></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046220" format="CellBodyL">
       <string>X = 2</string><superscript><string>-n</string></superscript></para>
      </td>
     <td><para unique="1046222" format="CellBodyL">
       <string>2</string><superscript><string>n</string></superscript></para>
      </td>
     <td><para unique="1046224" format="CellBodyL">
       </para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046226" format="CellBodyL">
       <string>X = -2</string><superscript><string>-n</string></superscript></para>
      </td>
     <td><para unique="1046228" format="CellBodyL">
       <string>-2</string><superscript><string>n</string></superscript></para>
      </td>
     <td><para unique="1046230" format="CellBodyL">
       </para>
      </td>
     </tr>
    </tbody>
