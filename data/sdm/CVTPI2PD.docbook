<instruction name="CVTPI2PD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Packed Dword Integers to Packed Double Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64-Bit Mode</para>
      </th>
     <th><para unique="1261202">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.15424000000002pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 2A /r</para>
      <para unique="1261210">CVTPI2PD xmm, mm/m64<footnote><para unique="1261209" format="TableFootnote">Operation is different for different operand sets; see the Description section.</para>
        </footnote></para>
      </td>
     <td><para unique="1261214">RM</para>
      </td>
     <td><para unique="1261216">Valid</para>
      </td>
     <td><para unique="1261218">Valid</para>
      </td>
     <td><para unique="1261220">Convert two packed signed doubleword integers from mm/mem64 to two packed double precision floating-point values in xmm.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261222">
   <col width="43.83144pt"/>
   <col width="115.36848pt"/>
   <col width="120.78pt"/>
   <col width="112.28256pt"/>
   <col width="117.4572pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261224">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261226">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261228">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261230">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261232">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261234">RM</para>
      </td>
     <td valign="middle"><para unique="1261236">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261238">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261240">N/A</para>
