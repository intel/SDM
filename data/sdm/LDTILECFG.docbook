     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op/</para>
      <para unique="1261199">En</para>
      </th>
     <th><para unique="1261201">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261203">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261207">VEX.128.NP.0F38.W0 49 !(11):000:bbb</para>
      <para unique="1261208">LDTILECFG m512</para>
      </td>
     <td><para unique="1261212">A</para>
      </td>
     <td><para unique="1261214">V/N.E.</para>
      </td>
     <td><para unique="1261216">AMX_TILE</para>
      </td>
     <td><para unique="1261218">Load tile configuration as specified in m512.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261220">
   <col width="43.01352pt"/>
   <col width="61.01352pt"/>
   <col width="95.65272pt"/>
   <col width="104.62608pt"/>
   <col width="103.85784pt"/>
   <col width="102.5676pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261222">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261224">Tuple</para>
      </th>
     <th valign="middle"><para unique="1261226">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261228">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261230">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261232">Operand 4</para>
      </th>
