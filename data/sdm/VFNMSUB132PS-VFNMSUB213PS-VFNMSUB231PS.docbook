   <programlisting>(KL, VL) = (4, 128), (8, 256), (16, 512)
IF (VL = 512) AND (EVEX.b = 1)
	THEN
		SET_ROUNDING_MODE_FOR_THIS_INSTRUCTION(EVEX.RC);
	ELSE
		SET_ROUNDING_MODE_FOR_THIS_INSTRUCTION(MXCSR.RC);
FI;
FOR j := 0 TO KL-1
	i := j * 32
	IF k1[j] OR *no writemask*
		THEN 	DEST[i+31:i] :=
			RoundFPControl_MXCSR(-(SRC2[i+31:i]*DEST[i+31:i]) - SRC3[i+31:i])
		ELSE
			IF *merging-masking*								; merging-masking
				THEN *DEST[i+31:i] remains unchanged*
				ELSE 							; zeroing-masking
					DEST[i+31:i] := 0
			FI
	FI;
ENDFOR
DEST[MAXVL-1:VL] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1046294">VFNMSUB213PS DEST, SRC2, SRC3 (EVEX encoded version, when src3 operand is a memory source)</title>
   <programlisting>(KL, VL) = (4, 128), (8, 256), (16, 512)
FOR j := 0 TO KL-1
	i := j * 32
	IF k1[j] OR *no writemask*
		THEN
			IF (EVEX.b = 1)
				THEN
					DEST[i+31:i] :=
			RoundFPControl_MXCSR(-(SRC2[i+31:i]*DEST[i+31:i]) - SRC3[31:0])
				ELSE
					DEST[i+31:i] :=
			RoundFPControl_MXCSR(-(SRC2[i+31:i]*DEST[i+31:i]) - SRC3[i+31:i])
			FI;
		ELSE
			IF *merging-masking*								; merging-masking
				THEN *DEST[i+31:i] remains unchanged*
				ELSE 							; zeroing-masking
					DEST[i+31:i] := 0
			FI
	FI;
ENDFOR
DEST[MAXVL-1:VL] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1046319">VFNMSUB231PS DEST, SRC2, SRC3 (EVEX encoded version, when src3 operand is a register)</title>
   <programlisting>(KL, VL) = (4, 128), (8, 256), (16, 512)
IF (VL = 512) AND (EVEX.b = 1)
	THEN
		SET_ROUNDING_MODE_FOR_THIS_INSTRUCTION(EVEX.RC);
	ELSE
		SET_ROUNDING_MODE_FOR_THIS_INSTRUCTION(MXCSR.RC);
FI;
FOR j := 0 TO KL-1
	i := j * 32
	IF k1[j] OR *no writemask*
		THEN 	DEST[i+31:i] :=
			RoundFPControl_MXCSR(-(SRC2[i+31:i]*SRC3[i+31:i]) - DEST[i+31:i])
		ELSE
			IF *merging-masking*								; merging-masking
				THEN *DEST[i+31:i] remains unchanged*
				ELSE 							; zeroing-masking
					DEST[i+31:i] := 0
			FI
	FI;
ENDFOR
DEST[MAXVL-1:VL] := 0</programlisting>
