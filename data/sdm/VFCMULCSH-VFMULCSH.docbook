 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046011">Invalid, Underflow, Overflow, Precision, Denormal.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046016" format="xIndent1">EVEX-encoded instructions, see <link unique="1046014" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#31368: 06_Table: Table 2-58. Type E10 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;60, &#8220;Type E10 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046017" format="xIndent1">Additionally:</para>
  <para unique="1046018" format="xIndent1">#UD 	If (dest_reg == src1_reg) or (dest_reg == src2_reg).</para>
