 <shortdesc>Complex Multiply Scalar FP16 Values</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="27.40032pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="201.89952pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046329">EVEX.LLIG.F2.MAP6.W0 D7 /r</para>
      <para unique="1046330">VFCMULCSH xmm1{k1}{z}, xmm2, xmm3/m32 {er}</para>
      </td>
     <td><para unique="1046332">A</para>
      </td>
     <td><para unique="1046334">V/V</para>
      </td>
     <td><para unique="1046336">AVX512_FP16 </para>
      <para unique="1046340">OR AVX10.1<anchor id="+259264"/></para>
      </td>
     <td><para unique="1046342">Complex multiply a pair of FP16 values from xmm2 and xmm3/m32, and store the result in xmm1 subject to writemask k1. Bits 127:32 of xmm2 are copied to xmm1[127:32].</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046317">EVEX.LLIG.F3.MAP6.W0 D7 /r</para>
      <para unique="1046318">VFMULCSH xmm1{k1}{z}, xmm2, xmm3/m32 {er}</para>
      </td>
     <td><para unique="1046320">A</para>
      </td>
     <td><para unique="1046322">V/V</para>
      </td>
     <td><para unique="1046324">AVX512_FP16 </para>
      <para unique="1046325">OR AVX10.1<anchor id="+535262"/></para>
      </td>
     <td><para unique="1046327">Complex multiply a pair of FP16 values from xmm2 and the complex conjugate of xmm3/m32, and store the result in xmm1 subject to writemask k1. Bits 127:32 of xmm2 are copied to xmm1[127:32].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045921">
