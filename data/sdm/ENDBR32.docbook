<instruction name="ENDBR32">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Terminate an Indirect Branch in 32-bit and Compatibility Mode</shortdesc>
 <longdesc><para unique="1261246">
   <string>Terminate an indirect branch in 32 bit and compatibility mode. This opcode is a NOP when CET indirect branch tracking is not enabled, on processors that do not support CET, and in 64-bit mode.</string></para>
  </longdesc>
 <subsection title="Flags Affected">
  <para unique="1261259">
   <string>None.</string></para>
  </subsection>
 <subsection title="Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
