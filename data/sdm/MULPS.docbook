    <tr>
     <td colspan="2"><para unique="1091405">NP 0F 59 /r</para>
      <para unique="1091406">MULPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091410">A</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE</para>
      </td>
     <td><para unique="1091416">Multiply packed single precision floating-point values in xmm2/m128 with xmm1 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.0F.WIG 59 /r</para>
      <para unique="1091419">VMULPS xmm1,xmm2, xmm3/m128</para>
      </td>
