<instruction name="FFREE">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Free Floating-Point Register</shortdesc>
 <encoding_table><table unique="1261192">
   <thead><tr>
     <th><para unique="1261194">Opcode</para>
      </th>
     <th><para unique="1261196">Instruction</para>
      </th>
     <th><para unique="1261198">64-Bit Mode</para>
      </th>
     <th><para unique="1261200">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261202">Description</para>
      </th>
     </tr>
    </thead><col width="81.85392pt"/>
   <col width="107.05608000000001pt"/>
   <col width="46.3536pt"/>
   <col width="59.94936pt"/>
   <col width="216.70056pt"/>
   <tbody>
    <tr>
     <td><para unique="1261204">DD C0+i</para>
      </td>
     <td><para unique="1261206">FFREE ST(i)</para>
      </td>
     <td><para unique="1261208">Valid</para>
      </td>
     <td><para unique="1261210">Valid</para>
      </td>
     <td><para unique="1261212">Sets tag for ST(i) to empty.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <longdesc><para unique="1261215">Sets the tag in the FPU tag register associated with register ST(i) to empty (11B). The contents of ST(i) and the FPU stack-top pointer (TOP) are not affected.</para>
  <para unique="1261216">This instruction&#8217;s operation is the same in non-64-bit modes and 64-bit mode.</para>
  </longdesc>
 <operation>
  <programlisting>TAG(i) := 11B;</programlisting>
  </operation>
 <subsection title="FPU Flags Affected">
  <para unique="1261220">C0, C1, C2, C3 undefined.</para>
  </subsection>
 <subsection title="Floating-Point Exceptions">
  <para unique="1261222">None</para>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#NM</term>
    <listitem><para unique="1261224">CR0.EM[bit 2] or CR0.TS[bit 3] = 1.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#MF </term>
    <listitem><para unique="1261225">If there is a pending x87 FPU exception.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261226">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261228" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261230" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261232" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261234" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 </instruction>
