 <shortdesc>Multiply Packed Unsigned Integers and Store High Result</shortdesc>
 <encoding_table><table unique="1091391">
   <thead><tr>
     <th colspan="2"><para unique="1091393">Opcode/</para>
      <para unique="1091394">Instruction</para>
      </th>
