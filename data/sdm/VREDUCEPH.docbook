      </td>
     <td><para unique="1046196">Round(Src1 &#8722; 2&#8722;<superscript>M</superscript>)<footnote><para unique="1046195" format="TableFootnote">The Round(.) function uses rounding controls specified by (imm8[2]? MXCSR.RC: imm8[1:0]).</para>
        </footnote></para>
      </td>
