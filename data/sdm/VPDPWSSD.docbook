  <para unique="1046240">VPDPWSSD __m256i _mm256_maskz_dpwssd_epi32(__mmask8, __m256i, __m256i, __m256i);</para>
  <para unique="1046241">VPDPWSSD __m512i _mm512_dpwssd_epi32(__m512i, __m512i, __m512i);</para>
