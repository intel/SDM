      </td>
     </tr>
    <tr>
     <td><para unique="1261398">CMPLEPS xmm1, xmm2</para>
      </td>
     <td><para unique="1261400">CMPPS xmm1, xmm2, 2</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261402">CMPUNORDPS xmm1, xmm2</para>
