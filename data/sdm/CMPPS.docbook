</string><string>VCMPPS __mmask8 _mm_cmp_ps_mask( __m128 a, __m128 b, int imm);</string><string>
</string><string>VCMPPS __mmask8 _mm_mask_cmp_ps_mask( __mmask8 k1, __m128 a, __m128 b, int imm);</string><string>
