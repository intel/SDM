     <td><para unique="1046101">A</para>
      </td>
     <td><para unique="1046103">V/V</para>
      </td>
     <td><para unique="1046105">AVX2</para>
      </td>
     <td><para unique="1046107">Permute doublewords in ymm3/m256 using indices in ymm2 and store the result in ymm1.</para>
      </td>
     </tr>
