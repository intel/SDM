 <operand_table><table unique="1261286">
   <col width="45.10008pt"/>
   <col width="127.44432pt"/>
   <col width="117.77112pt"/>
   <col width="110.27232000000001pt"/>
   <col width="111.38256pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261288">Op/En</para>
