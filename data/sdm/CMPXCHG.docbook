    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261298">MR</para>
      </td>
     <td valign="middle"><para unique="1261300">ModRM:r/m (r, w)</para>
      </td>
     <td valign="middle"><para unique="1261302">ModRM:reg (r)</para>
      </td>
     <td valign="middle"><para unique="1261304">N/A</para>
