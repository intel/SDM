<instruction name="SAHF">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Store AH Into Flags</shortdesc>
 <encoding_table><table unique="1091391">
   <thead><tr>
     <th><para unique="1091396">Opcode</para>
      </th>
     <th><para unique="1091398">Instruction</para>
      </th>
     <th><para unique="1091400">Op/ En</para>
      </th>
     <th><para unique="1091402">64-Bit Mode</para>
      </th>
     <th><para unique="1091404">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091406">Description</para>
      </th>
     </tr>
    </thead><col width="86.89824pt"/>
   <col width="98.57664pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="206.6544pt"/>
   <tbody>
    <tr>
     <td><para unique="1091408">9E</para>
      </td>
     <td><para unique="1091410">SAHF</para>
      </td>
     <td><para unique="1091412">ZO</para>
      </td>
     <td><para unique="1091414">Valid<anchor id="+664258"/><bold><footnote><para unique="1091395" format="TableFootnote">Invalid if CPUID.80000001H:ECX.LAHF_SAHF_64 is enumerated as 0<anchor id="+293033"/>.</para>
         </footnote></bold></para>
      </td>
     <td><para unique="1091416">Valid</para>
      </td>
     <td><para unique="1091418">Loads SF, ZF, AF, PF, and CF from AH into the EFLAGS register.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091420">
   <col width="43.56216pt"/>
   <col width="113.97744pt"/>
   <col width="113.75424pt"/>
   <col width="119.43144000000001pt"/>
   <col width="119.74463999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091422">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091424">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091426">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091428">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091430">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091432">ZO</para>
      </td>
     <td valign="middle"><para unique="1091434">N/A</para>
      </td>
     <td valign="middle"><para unique="1091436">N/A</para>
      </td>
     <td valign="middle"><para unique="1091438">N/A</para>
      </td>
