 <shortdesc>Count the Number of Leading Zero Bits</shortdesc>
 <encoding_table><table unique="1261191">
   <col width="51.1812pt"/>
   <col width="72.81864pt"/>
   <col width="29.374560000000002pt"/>
   <col width="43.87536pt"/>
   <col width="44.24976pt"/>
   <col width="272.37528pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261723">Opcode/Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64/32-bit Mode</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F3 0F BD /r</para>
      <para unique="1261207">LZCNT r16, r/m16</para>
      </td>
     <td><para unique="1261211">RM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">LZCNT</para>
      </td>
     <td><para unique="1261217">Count the number of leading zero bits in r/m16, return result in r16.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">F3 0F BD /r</para>
