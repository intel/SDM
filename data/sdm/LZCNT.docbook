      </td>
     <td><para unique="1261230">Count the number of leading zero bits in r/m32, return result in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261232">F3 REX.W 0F BD /r</para>
      <para unique="1261233">LZCNT r64, r/m64</para>
      </td>
     <td><para unique="1261237">RM</para>
      </td>
