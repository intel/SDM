     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1261277">If second operand is not a memory location.</para>
     </listitem>
    <listitem><para unique="1261278">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#GP</term>
    <listitem><para unique="1261279">If a memory operand effective address is outside the CS, DS, ES, FS, or GS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#SS</term>
    <listitem><para unique="1261280">If a memory operand effective address is outside the SS segment limit.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
