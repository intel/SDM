<instruction name="BOUND">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Check Array Index Against Bounds</shortdesc>
 <encoding_table><table unique="1261193">
   <thead><tr>
     <th><para unique="1261195">Opcode</para>
      </th>
     <th><para unique="1261197">Instruction</para>
      </th>
     <th><para unique="1261199">Op/ En</para>
      </th>
     <th><para unique="1261201">64-bit Mode</para>
      </th>
     <th><para unique="1261203">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><col width="98.6112pt"/>
   <col width="111.8628pt"/>
   <col width="24.767999999999997pt"/>
   <col width="47.999520000000004pt"/>
   <col width="46.728pt"/>
   <col width="182.90448pt"/>
   <tbody>
    <tr>
     <td><para unique="1261207">62 /r</para>
      </td>
     <td><para unique="1261209">BOUND r16, m16&amp;16</para>
      </td>
     <td><para unique="1261211">RM</para>
      </td>
     <td><para unique="1261213">Invalid</para>
      </td>
     <td><para unique="1261215">Valid</para>
      </td>
     <td><para unique="1261217">Check if r16 (array index) is within bounds specified by m16&amp;16.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261219">62 /r</para>
      </td>
     <td><para unique="1261221">BOUND r32, m32&amp;32</para>
      </td>
     <td><para unique="1261223">RM</para>
      </td>
     <td><para unique="1261225">Invalid</para>
      </td>
     <td><para unique="1261227">Valid</para>
      </td>
     <td><para unique="1261229">Check if r32 (array index) is within bounds specified by m32&amp;32.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261231">
   <col width="45.146159999999995pt"/>
   <col width="118.61568pt"/>
   <col width="119.98367999999999pt"/>
   <col width="111.54239999999999pt"/>
   <col width="116.68248pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261233">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261235">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261237">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261239">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261241">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261243">RM</para>
      </td>
     <td valign="middle"><para unique="1261245">ModRM:reg (r)</para>
      </td>
     <td valign="middle"><para unique="1261247">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261249">N/A</para>
