<instruction name="MONITOR">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Set Up Monitor Address</shortdesc>
 <encoding_table><table unique="1091391">
   <thead><tr>
     <th><para unique="1091393">Opcode</para>
      </th>
     <th><para unique="1091395">Instruction</para>
      </th>
     <th><para unique="1091397">Op/ En</para>
      </th>
     <th><para unique="1091399">64-Bit Mode</para>
      </th>
     <th><para unique="1091401">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091403">Description</para>
      </th>
     </tr>
    </thead><col width="79.98768pt"/>
   <col width="90.73656pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="221.904pt"/>
   <tbody>
    <tr>
     <td><para unique="1091405">0F 01 C8</para>
      </td>
     <td><para unique="1091407">MONITOR</para>
      </td>
     <td><para unique="1091409">ZO</para>
      </td>
     <td><para unique="1091411">Valid</para>
      </td>
     <td><para unique="1091413">Valid</para>
      </td>
     <td><para unique="1091415">Sets up a linear address range to be monitored by hardware and activates the monitor. The address range should be a write-back memory caching type. The address is DS:RAX/EAX/AX.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091417">
   <col width="48.17304pt"/>
   <col width="116.24976pt"/>
   <col width="117.5904pt"/>
   <col width="114.03143999999999pt"/>
   <col width="115.92576pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091419">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091421">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091423">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091425">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091427">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091429">ZO</para>
      </td>
     <td valign="middle"><para unique="1091431">N/A</para>
      </td>
     <td valign="middle"><para unique="1091433">N/A</para>
      </td>
     <td valign="middle"><para unique="1091435">N/A</para>
