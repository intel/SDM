  </operand_table>
 <longdesc><para unique="1091435">The SHA1MSG2 instruction is one of two SHA1 message scheduling instructions. The instruction performs the final calculation to derive the next four SHA1 message dwords.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1091437">SHA1MSG2 </title>
   <programlisting>W13 := SRC2[95:64] ;
W14 := SRC2[63: 32] ;
W15 := SRC2[31: 0] ;
W16 := (SRC1[127:96] XOR W13 ) ROL 1;
W17 := (SRC1[95:64] XOR W14) ROL 1;
W18 := (SRC1[63: 32] XOR W15) ROL 1;
W19 := (SRC1[31: 0] XOR W16) ROL 1;
DEST[127:96] := W16;
DEST[95:64] := W17;
DEST[63:32] := W18;
DEST[31:0] := W19;</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>SHA1MSG2 __m128i _mm_sha1msg2_epu32(__m128i, __m128i);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1091453">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1091455">None.</para>
  </subsection>
