<instruction name="CVTTPD2PI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert With Truncation Packed Double Precision Floating-Point Values to Packed Dword Integers</shortdesc>
 <encoding_table><table unique="1261192">
   <thead><tr>
     <th colspan="2"><para unique="1261194">Opcode/</para>
      <para unique="1261195">Instruction</para>
      </th>
     <th><para unique="1261199">Op/ En</para>
      </th>
     <th><para unique="1261201">64-Bit Mode</para>
      </th>
     <th><para unique="1261203">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><col width="97.55712pt"/>
   <col width="110.66760000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.15424000000002pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261207">66 0F 2C /r</para>
      <para unique="1261208">CVTTPD2PI mm, xmm/m128</para>
      </td>
     <td><para unique="1261212">RM</para>
      </td>
     <td><para unique="1261214">Valid</para>
      </td>
     <td><para unique="1261216">Valid</para>
      </td>
     <td><para unique="1261218">Convert two packer double precision floating-point values from xmm/m128 to two packed signed doubleword integers in mm using truncation.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261219">
   <col width="42.4152pt"/>
   <col width="119.30688pt"/>
   <col width="119.07288000000001pt"/>
   <col width="113.08247999999999pt"/>
   <col width="116.59248pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261221">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261223">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261225">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261227">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261229">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261231">RM</para>
      </td>
     <td valign="middle"><para unique="1261233">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261235">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261237">N/A</para>
