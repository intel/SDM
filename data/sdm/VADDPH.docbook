    <tr>
     <td><para unique="1046429">EVEX.128.NP.MAP5.W0 58 /r</para>
      <para unique="1046430">VADDPH xmm1{k1}{z}, xmm2, xmm3/m128/m16bcst</para>
      </td>
     <td><para unique="1046432">A</para>
      </td>
     <td><para unique="1046434">V/V</para>
      </td>
     <td><para unique="1046436">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+406625"/></para>
      </td>
     <td><para unique="1046441">Add packed FP16 value from xmm3/m128/m16bcst to xmm2, and store result in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046418">EVEX.256.NP.MAP5.W0 58 /r</para>
      <para unique="1046419">VADDPH ymm1{k1}{z}, ymm2, ymm3/m256/m16bcst</para>
