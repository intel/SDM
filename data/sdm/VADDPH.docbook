    <tr>
     <td><para unique="1046407">EVEX.256.NP.MAP5.W0 58 /r</para>
      <para unique="1046408">VADDPH ymm1{k1}{z}, ymm2, ymm3/m256/m16bcst {er}</para>
      </td>
     <td><para unique="1046410">A</para>
      </td>
     <td><para unique="1046412">V/V</para>
      </td>
     <td><para unique="1046414">AVX10.2<superscript>1</superscript></para>
      </td>
     <td><para unique="1046416">Add packed FP16 value from ymm3/m256/m16bcst to ymm2, and store result in ymm1 subject to writemask k1.</para>
      </td>
