    <tr>
     <td colspan="2"><para unique="1046865">EVEX.128.F3.0F38.W0 31 /r</para>
      <para unique="1046866">VPMOVDB xmm1/m32 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046870">A</para>
      </td>
     <td><para unique="1046872">V/V</para>
      </td>
     <td><para unique="1046874">(AVX512VL AND AVX512F) OR AVX10.1<anchor id="+833101"/></para>
      </td>
     <td><para unique="1046882">Converts 4 packed double-word integers from xmm2 into 4 packed byte integers in xmm1/m32 with truncation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046849">EVEX.128.F3.0F38.W0 21 /r</para>
      <para unique="1046850">VPMOVSDB xmm1/m32 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046854">A</para>
      </td>
     <td><para unique="1046856">V/V</para>
      </td>
     <td><para unique="1046858">(AVX512VL AND AVX512F) OR AVX10.1<anchor id="+795783"/></para>
      </td>
     <td><para unique="1046863">Converts 4 packed signed double-word integers from xmm2 into 4 packed signed byte integers in xmm1/m32 using signed saturation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046833">EVEX.128.F3.0F38.W0 11 /r</para>
