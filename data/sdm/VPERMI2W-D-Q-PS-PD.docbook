 <operand_table><table unique="1046337">
   <col width="41.15448000000001pt"/>
   <col width="71.154pt"/>
   <col width="95.58144pt"/>
   <col width="101.29032pt"/>
   <col width="101.30976000000001pt"/>
   <col width="101.37024000000001pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1046339">Op/En</para>
      </th>
     <th valign="middle"><para unique="1046341">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1046343">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1046345">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1046347">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1046349">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1046351">A</para>
      </td>
     <td valign="middle"><para unique="1046353">Full Mem</para>
      </td>
     <td valign="middle"><para unique="1046355">ModRM:reg (r,w)</para>
      </td>
     <td valign="middle"><para unique="1046357">EVEX.vvvv (r)</para>
      </td>
     <td valign="middle"><para unique="1046359">ModRM:r/m (r)</para>
      </td>
