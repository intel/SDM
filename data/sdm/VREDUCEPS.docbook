 <shortdesc>Perform Reduction Transformation on Packed Float32 Values</shortdesc>
 <encoding_table><table unique="1046080">
   <col width="55.30896pt"/>
   <col width="78.69095999999999pt"/>
   <col width="28.499760000000002pt"/>
