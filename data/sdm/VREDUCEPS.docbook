   <col width="221.5008pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046082">Opcode/</para>
      <para unique="1046083">Instruction</para>
      </th>
     <th><para unique="1046087">Op / En</para>
      </th>
     <th><para unique="1046089">64/32 bit Mode Support</para>
      </th>
