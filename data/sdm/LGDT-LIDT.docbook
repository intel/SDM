    <tr>
     <td><para unique="1261230">0F 01 /2</para>
      </td>
     <td><para unique="1261232">LGDT m16&amp;64</para>
      </td>
     <td><para unique="1261234">M</para>
      </td>
     <td><para unique="1261236">Valid</para>
      </td>
     <td><para unique="1261238">N.E.</para>
      </td>
