    <tr>
     <td><para unique="1261242">0F 01 /3</para>
      </td>
     <td><para unique="1261244">LIDT m16&amp;64</para>
      </td>
     <td><para unique="1261246">M</para>
      </td>
     <td><para unique="1261248">Valid</para>
