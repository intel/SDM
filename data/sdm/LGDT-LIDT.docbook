    <listitem><para unique="1261345">If a memory address referencing the SS segment is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1261346">If the current privilege level is not 0.</para>
     </listitem>
    <listitem><para unique="1261347">If the memory address is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1261348">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#PF(fault-code)</term>
    <listitem><para unique="1261349">If a page fault occurs.</para>
