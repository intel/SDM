 <shortdesc>Load Global/Interrupt Descriptor Table Register</shortdesc>
 <encoding_table><table unique="1261192">
   <thead><tr>
     <th><para unique="1261194">Opcode</para>
      </th>
     <th><para unique="1261196">Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64-Bit Mode</para>
      </th>
     <th><para unique="1261202">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td><para unique="1261206">0F 01 /2</para>
      </td>
     <td><para unique="1261208">LGDT m16&amp;32</para>
      </td>
     <td><para unique="1261210">M</para>
      </td>
     <td><para unique="1261212">N.E.</para>
      </td>
     <td><para unique="1261214">Valid</para>
      </td>
     <td><para unique="1261216">Load m into GDTR.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261218">0F 01 /3</para>
