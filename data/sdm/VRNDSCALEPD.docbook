       <line x1="511.27301502227783" y1="8.25" x2="511.27301502227783" y2="0" stroke="gray"/><line x1="591.2730150222778" y1="8.25" x2="591.2730150222778" y2="0" stroke="gray"/><text x="551.2730150222778" y="6.25" font-family="Verdana" font-size="7.5" fill="gray" text-anchor="middle">2</text>
       <rect x="591.2730150222778" y="8.25" width="160" height="15" fill="whitesmoke" stroke="dimgray"/>
       <text x="671.2730150222778" y="18.72" font-family="Verdana" font-size="9.9" fill="black" text-anchor="middle">RC</text>
       <line x1="591.2730150222778" y1="8.25" x2="591.2730150222778" y2="0" stroke="gray"/><line x1="751.2730150222778" y1="8.25" x2="751.2730150222778" y2="0" stroke="gray"/><text x="593.2730150222778" y="6.25" font-family="Verdana" font-size="7.5" fill="gray">1</text>
       <text x="749.2730150222778" y="6.25" font-family="Verdana" font-size="7.5" fill="gray" text-anchor="end">0</text>
       <text x="77.90069103240967" y="8.25" font-family="Verdana" font-size="9.9" fill="black"><tspan x="77.90069103240967" dy="11.88" font-family="Verdana" text-anchor="start">imm8</tspan></text>
       <text x="36.372323989868164" y="53" font-family="Verdana" font-size="9.9" fill="black"><tspan x="36.372323989868164" dy="11.88" font-family="Verdana" text-anchor="start">Fixed Point Length</tspan><tspan x="36.372323989868164" dy="11.88" font-family="Verdana" text-anchor="start">Number of fixed points to preserve</tspan></text>
       <text x="226.20566749572754" y="53" font-family="Verdana" font-size="9.9" fill="black"><tspan x="226.20566749572754" dy="11.88" font-family="Verdana" text-anchor="start">Suppress Precision Exceptions (SPE)</tspan><tspan x="226.20566749572754" dy="11.88" font-family="Verdana" text-anchor="start">imm8[3] = 0b0 : Use MXCSR exception mask</tspan><tspan x="226.20566749572754" dy="11.88" font-family="Verdana" text-anchor="start">imm8[3] = 0b1 : Suppress</tspan></text>
       <text x="473.2960147857666" y="53" font-family="Verdana" font-size="9.9" fill="black"><tspan x="473.2960147857666" dy="11.88" font-family="Verdana" text-anchor="start">Round Select (RS)</tspan><tspan x="473.2960147857666" dy="11.88" font-family="Verdana" text-anchor="start">imm8[2] = 0b0 : Use imm8[1:0]</tspan><tspan x="473.2960147857666" dy="11.88" font-family="Verdana" text-anchor="start">imm8[2] = 0b1 : Use MXCSR</tspan></text>
       <text x="657.2293491363525" y="53" font-family="Verdana" font-size="9.9" fill="black"><tspan x="657.2293491363525" dy="11.88" font-family="Verdana" text-anchor="start">Round Control Override (RC)</tspan><tspan x="657.2293491363525" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b00 : Round nearest even</tspan><tspan x="657.2293491363525" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b01 : Round down</tspan><tspan x="657.2293491363525" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b10 : Round up</tspan><tspan x="657.2293491363525" dy="11.88" font-family="Verdana" text-anchor="start">imm8[1:0] = 0b11 : Truncate</tspan></text>
       <line x1="271.27301502227783" y1="23.25" x2="53.755658340454104" y2="53" stroke="white" stroke-width="2.7" opacity="70%"/><line x1="271.27301502227783" y1="23.25" x2="53.755658340454104" y2="53" stroke="dimgray" stroke-width="0.7" fill="transparent"/><line x1="471.27301502227783" y1="23.25" x2="249.01470222473145" y2="53" stroke="white" stroke-width="2.7" opacity="70%"/><line x1="471.27301502227783" y1="23.25" x2="249.01470222473145" y2="53" stroke="dimgray" stroke-width="0.7" fill="transparent"/><line x1="551.2730150222778" y1="23.25" x2="489.7893482208252" y2="53" stroke="white" stroke-width="2.7" opacity="70%"/><line x1="551.2730150222778" y1="23.25" x2="489.7893482208252" y2="53" stroke="dimgray" stroke-width="0.7" fill="transparent"/><line x1="671.2730150222778" y1="23.25" x2="677.7610172271728" y2="53" stroke="white" stroke-width="2.7" opacity="70%"/><line x1="671.2730150222778" y1="23.25" x2="677.7610172271728" y2="53" stroke="dimgray" stroke-width="0.7" fill="transparent"/></svg></td>
