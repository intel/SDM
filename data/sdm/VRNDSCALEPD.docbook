       <line x1="111.27301502227783" y1="8.25" x2="111.27301502227783" y2="0" stroke="gray"/><line x1="431.27301502227783" y1="8.25" x2="431.27301502227783" y2="0" stroke="gray"/><text x="113.27301502227783" y="6.25" font-family="Verdana" font-size="7.5" fill="gray">7</text>
       <text x="429.27301502227783" y="6.25" font-family="Verdana" font-size="7.5" fill="gray" text-anchor="end">4</text>
       <rect x="431.27301502227783" y="8.25" width="80" height="15" fill="whitesmoke" stroke="dimgray"/>
       <text x="471.27301502227783" y="18.72" font-family="Verdana" font-size="9.9" fill="black" text-anchor="middle">SPE</text>
       <line x1="431.27301502227783" y1="8.25" x2="431.27301502227783" y2="0" stroke="gray"/><line x1="511.27301502227783" y1="8.25" x2="511.27301502227783" y2="0" stroke="gray"/><text x="471.27301502227783" y="6.25" font-family="Verdana" font-size="7.5" fill="gray" text-anchor="middle">3</text>
       <rect x="511.27301502227783" y="8.25" width="80" height="15" fill="whitesmoke" stroke="dimgray"/>
