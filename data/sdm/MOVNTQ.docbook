    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091428">MR</para>
      </td>
     <td valign="middle"><para unique="1091430">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091432">ModRM:reg (r)</para>
