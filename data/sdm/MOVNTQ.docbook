 <shortdesc>Store of Quadword Using Non-Temporal Hint</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th><para unique="1091392">Opcode</para>
      </th>
     <th><para unique="1091394">Instruction</para>
      </th>
     <th><para unique="1091396">Op/ En</para>
      </th>
     <th><para unique="1091398">64-Bit Mode</para>
      </th>
     <th><para unique="1091400">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.15424000000002pt"/>
   <tbody>
    <tr>
     <td><para unique="1091404">NP 0F E7 /r</para>
      </td>
     <td><para unique="1091406">MOVNTQ m64, mm</para>
      </td>
     <td><para unique="1091408">MR</para>
      </td>
     <td><para unique="1091410">Valid</para>
      </td>
     <td><para unique="1091412">Valid</para>
      </td>
     <td><para unique="1091414">Move quadword from mm to m64 using non-temporal hint.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091416">
   <col width="45.827999999999996pt"/>
   <col width="118.95552pt"/>
