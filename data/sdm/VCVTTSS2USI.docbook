<instruction name="VCVTTSS2USI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert With Truncation Scalar Single Precision Floating-Point Value to Unsigned Integer</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="81.41544pt"/>
   <col width="81.41544pt"/>
