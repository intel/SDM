 <shortdesc>Convert With Truncation Packed Double Precision Floating-Point Values to Packed Unsigned Quadword Integers</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="55.6812pt"/>
   <col width="79.21872pt"/>
   <col width="29.7pt"/>
   <col width="48.74976pt"/>
