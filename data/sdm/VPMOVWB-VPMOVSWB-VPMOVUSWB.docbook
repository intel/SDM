    <tr>
     <td colspan="2"><para unique="1046820">EVEX.128.F3.0F38.W0 30 /r</para>
      <para unique="1046821">VPMOVWB xmm1/m64 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046825">A</para>
      </td>
     <td><para unique="1046827">V/V</para>
      </td>
     <td><para unique="1046829">(AVX512VL AND</para>
      <para unique="1046830">AVX512BW) OR AVX10.1<anchor id="+893651"/></para>
      </td>
     <td><para unique="1046835">Converts 8 packed word integers from xmm2 into 8 packed bytes in xmm1/m64 with truncation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046806">EVEX.128.F3.0F38.W0 20 /r</para>
      <para unique="1046807">VPMOVSWB xmm1/m64 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046811">A</para>
      </td>
     <td><para unique="1046813">V/V</para>
      </td>
     <td><para unique="1046815">(AVX512VL AND</para>
      <para unique="1046816">AVX512BW) OR AVX10.1<anchor id="+550106"/></para>
      </td>
     <td><para unique="1046818">Converts 8 packed signed word integers from xmm2 into 8 packed signed bytes in xmm1/m64 using signed saturation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046792">EVEX.128.F3.0F38.W0 10 /r</para>
