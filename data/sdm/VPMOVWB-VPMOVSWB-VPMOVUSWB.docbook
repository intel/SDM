 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046376">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046381">EVEX-encoded instruction, see <link unique="1046379" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#70360: 06_Table: Table 2-53. Type E6 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;55, &#8220;Type E6 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046382">Additionally:</para>
  <para unique="1046383" format="xIndent1">#UD 	If EVEX.vvvv != 1111B.</para>
  </subsection>
 </instruction>
