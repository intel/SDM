<instruction name="FSUB/FSUBP/FISUB">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Subtract</shortdesc>
 <encoding_table><table unique="1261193">
   <thead><tr>
     <th><para unique="1261195">Opcode</para>
      </th>
     <th><para unique="1261197">Instruction</para>
      </th>
     <th><para unique="1261199">64-Bit Mode</para>
      </th>
     <th><para unique="1261201">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261203">Description</para>
      </th>
     </tr>
    </thead><col width="76.22424pt"/>
