      </td>
     <td><para unique="1261214">CET_SS</para>
      </td>
     <td><para unique="1261216">Increment SSP by 4 * r32[7:0].</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261218">F3 REX.W 0F AE /5</para>
      <para unique="1261219">INCSSPQ r64</para>
      </td>
     <td><para unique="1261223">R</para>
      </td>
     <td><para unique="1261225">V/N.E.</para>
      </td>
     <td><para unique="1261227">CET_SS</para>
      </td>
     <td><para unique="1261229">Increment SSP by 8 * r64[7:0].</para>
      </td>
     </tr>
