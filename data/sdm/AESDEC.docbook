   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 38 DE /r </para>
      <para unique="1261207"><sans>AESDEC xmm1, xmm2/m128</sans></para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">AES</para>
      </td>
     <td><para unique="1261217">Perform one round of an AES decryption flow, using the Equivalent Inverse Cipher, using one 128-bit data (state) from xmm1 with one 128-bit round key from xmm2/m128.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.66.0F38.WIG DE /r</para>
      <para unique="1261220">VAESDEC xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1261224">B</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261228">AES </para>
      <para unique="1261229">AVX</para>
      </td>
     <td><para unique="1261231">Perform one round of an AES decryption flow, using the Equivalent Inverse Cipher, using one 128-bit data (state) from xmm2 with one 128-bit round key from xmm3/m128; store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261233">VEX.256.66.0F38.WIG DE /r </para>
      <para unique="1261234">VAESDEC ymm1, ymm2, ymm3/m256</para>
      </td>
     <td><para unique="1261238">B</para>
      </td>
     <td><para unique="1261240">V/V</para>
      </td>
     <td><para unique="1261242">VAES</para>
      </td>
     <td><para unique="1261244">Perform one round of an AES decryption flow, using the Equivalent Inverse Cipher, using two 128-bit data (state) from ymm2 with two 128-bit round keys from ymm3/m256; store the result in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261443">EVEX.128.66.0F38.WIG DE /r</para>
      <para unique="1261444">VAESDEC xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1261448">C</para>
      </td>
     <td><para unique="1261450">V/V</para>
      </td>
     <td><para unique="1261452">VAES </para>
      <para unique="1261453">(AVX512VL OR AVX10.1<anchor id="+401256"/>)</para>
      </td>
     <td><para unique="1261458">Perform one round of an AES decryption flow, using the Equivalent Inverse Cipher, using one 128-bit data (state) from xmm2 with one 128-bit round key from xmm3/m128; store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261429">EVEX.256.66.0F38.WIG DE /r</para>
      <para unique="1261430">VAESDEC ymm1, ymm2, ymm3/m256</para>
      </td>
     <td><para unique="1261434">C</para>
      </td>
     <td><para unique="1261436">V/V</para>
      </td>
     <td><para unique="1261438">VAES </para>
      <para unique="1261439">(AVX512VL OR AVX10.1<anchor id="+831659"/>)</para>
      </td>
     <td><para unique="1261441">Perform one round of an AES decryption flow, using the Equivalent Inverse Cipher, using two 128-bit data (state) from ymm2 with two 128-bit round keys from ymm3/m256; store the result in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261415">EVEX.512.66.0F38.WIG DE /r</para>
      <para unique="1261416">VAESDEC zmm1, zmm2, zmm3/m512</para>
