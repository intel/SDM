     <td><para unique="1261777">AVX512F</para>
      <para unique="1261781">OR AVX10.1<anchor id="+928369"/></para>
      </td>
     <td><para unique="1261783">Convert one signed doubleword integer from r/m32 to one single precision floating-point value in xmm1.</para>
      </td>
