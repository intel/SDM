<instruction name="WBNOINVD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Write Back and Do Not Invalidate Cache</shortdesc>
 <encoding_table><table unique="1012542">
   <thead><tr>
     <th colspan="2"><para unique="1012544">Opcode /</para>
      <para unique="1012545">Instruction</para>
      </th>
     <th><para unique="1012549">Op/ En</para>
      </th>
     <th><para unique="1012551">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1012553">CPUID Feature Flag</para>
      </th>
     <th><para unique="1012555">Description</para>
      </th>
     </tr>
    </thead><col width="93.27024pt"/>
   <col width="105.80472pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="49.72824pt"/>
   <col width="190.85399999999998pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1012557">F3 0F 09</para>
      <para unique="1012558">WBNOINVD</para>
      </td>
     <td><para unique="1012562">ZO</para>
      </td>
     <td><para unique="1012564">V/V</para>
      </td>
     <td><para unique="1012566">WBNOINVD</para>
      </td>
     <td><para unique="1012568">Write back and do not flush internal caches; initiate writing-back without flushing of external caches.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012570">
   <col width="51.98472pt"/>
   <col width="51.98472pt"/>
