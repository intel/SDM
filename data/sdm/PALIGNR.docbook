<instruction name="PALIGNR">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Packed Align Right</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th colspan="2"><para unique="1091392">Opcode/</para>
      <para unique="1091393">Instruction</para>
