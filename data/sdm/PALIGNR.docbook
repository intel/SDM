 <subsection title="Intel C/C++ Compiler Intrinsic Equivalents">
  <programlisting><string>PALIGNR __m64 _mm_alignr_pi8 (__m64 a, __m64 b, int n)</string><string>
</string><string>(V)PALIGNR __m128i _mm_alignr_epi8 (__m128i a, __m128i b, int n)</string><string>
</string><string>VPALIGNR		 __m256i _mm256_alignr_epi8 (__m256i a, __m256i b, const int n)</string><string>
</string><string>VPALIGNR __m512i _mm512_alignr_epi8 (__m512i a, __m512i b, const int n)</string><string>
</string><string>VPALIGNR __m512i _mm512_mask_alignr_epi8 (__m512i s, __mmask64 m, __m512i a, __m512i b, const int n)</string><string>
</string><string>VPALIGNR __m512i _mm512_maskz_alignr_epi8 ( __mmask64 m, __m512i a, __m512i b, const int n)</string><string>
</string><string>VPALIGNR __m256i _mm256_mask_alignr_epi8 (__m256i s, __mmask32 m, __m256i a, __m256i b, const int n)</string><string>
</string><string>VPALIGNR __m256i _mm256_maskz_alignr_epi8 (__mmask32 m, __m256i a, __m256i b, const int n)</string><string>
</string><string>VPALIGNR __m128i _mm_mask_alignr_epi8 (__m128i s, __mmask16 m, __m128i a, __m128i b, const int n)</string><string>
</string><string>VPALIGNR __m128i _mm_maskz_alignr_epi8 (__mmask16 m, __m128i a, __m128i b, const int n)</string><string>
</string></programlisting>
