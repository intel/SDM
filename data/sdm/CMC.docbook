 <longdesc><para unique="1261240">Complements the CF flag in the EFLAGS register. CMC operation is the same in non-64-bit modes and 64-bit mode.</para>
  </longdesc>
 <operation>
  <programlisting>EFLAGS.CF[bit 0] := NOT EFLAGS.CF[bit 0];</programlisting>
  </operation>
 <subsection title="Flags Affected">
  <para unique="1261244">The CF flag contains the complement of its original value. The OF, ZF, SF, AF, and PF flags are unaffected.</para>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261246">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
