<instruction name="CMC">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Complement Carry Flag</shortdesc>
 <longdesc><para unique="1261240">
   <string>Complements the CF flag in the EFLAGS register. CMC operation is the same in non-64-bit modes and 64-bit mode.</string></para>
  </longdesc>
 <subsection title="Flags Affected">
  <para unique="1261244">
   <string>The CF flag contains the complement of its original value. The OF, ZF, SF, AF, and PF flags are unaffected.</string></para>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
