     <th valign="middle"><para unique="1091426">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091428">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091430">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091432">Operand 4</para>
      </th>
