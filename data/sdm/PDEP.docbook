<instruction name="PDEP">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Parallel Bits Deposit</shortdesc>
 <encoding_table><table unique="1091390">
   <col width="52.2648pt"/>
   <col width="74.35943999999999pt"/>
   <col width="31.52448pt"/>
   <col width="39.00024pt"/>
