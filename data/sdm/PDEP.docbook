   <col width="273.00023999999996pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1091392">Opcode/</para>
      <para unique="1091393">Instruction</para>
      </th>
     <th><para unique="1091397">Op/ En</para>
      </th>
     <th><para unique="1091399">64/32-bit Mode</para>
      </th>
     <th><para unique="1091401">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091403">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091405">VEX.LZ.F2.0F38.W0 F5 /r</para>
      <para unique="1091406">PDEP r32a, r32b, r/m32</para>
      </td>
     <td><para unique="1091410">RVM</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">BMI2</para>
      </td>
     <td><para unique="1091416">Parallel deposit of bits from r32b using mask in r/m32, result is written to r32a.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.LZ.F2.0F38.W1 F5 /r</para>
      <para unique="1091419">PDEP r64a, r64b, r/m64</para>
      </td>
     <td><para unique="1091423">RVM</para>
      </td>
     <td><para unique="1091425">V/N.E.</para>
      </td>
     <td><para unique="1091427">BMI2</para>
      </td>
     <td><para unique="1091429">Parallel deposit of bits from r64b using mask in r/m64, result is written to r64a.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091431">
   <col width="44.48448pt"/>
   <col width="111.74759999999999pt"/>
