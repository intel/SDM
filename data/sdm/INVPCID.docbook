    <tr>
     <td colspan="2"><para unique="1261219">66 0F 38 82 /r</para>
      <para unique="1261220">INVPCID r64, m128</para>
      </td>
     <td><para unique="1261224">RM</para>
      </td>
     <td><para unique="1261226">V/N.E.</para>
      </td>
     <td><para unique="1261228">INVPCID</para>
      </td>
     <td><para unique="1261230">Invalidates entries in the TLBs and paging-structure caches based on invalidation type in r64 and descrip&#173;tor in m128.</para>
      </td>
