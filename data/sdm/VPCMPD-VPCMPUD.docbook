    <tr>
     <td colspan="2"><para unique="1046702">EVEX.512.66.0F3A.W0 1F /r ib</para>
      <para unique="1046703">VPCMPD k1 {k2}, zmm2, zmm3/m512/m32bcst, imm8</para>
      </td>
     <td><para unique="1046707">A</para>
