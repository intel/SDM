     </tr>
    <tr>
     <td colspan="2"><para unique="1046685">EVEX.128.66.0F3A.W0 1E /r ib</para>
      <para unique="1046686">VPCMPUD k1 {k2}, xmm2, xmm3/m128/m32bcst, imm8</para>
