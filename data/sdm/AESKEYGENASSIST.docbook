 <shortdesc>AES Round Key Generation Assist</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64/32-bit Mode</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="99.02304000000001pt"/>
   <col width="112.33008000000001pt"/>
   <col width="24.69528pt"/>
   <col width="47.859120000000004pt"/>
   <col width="46.5912pt"/>
   <col width="180.12527999999998pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 3A DF /r ib</para>
      <para unique="1261207"><sans>AESKEYGENASSIST xmm1, xmm2/m128, imm8</sans></para>
      </td>
     <td><para unique="1261211">RMI</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">AES</para>
      </td>
     <td><para unique="1261217">Assist in AES round key generation using an 8 bits Round Constant (RCON) specified in the immediate byte, operating on 128 bits of data specified in xmm2/m128 and stores the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.66.0F3A.WIG DF /r ib</para>
      <para unique="1261220"><sans>VAESKEYGENASSIST xmm1, xmm2/m128, imm8</sans></para>
      </td>
     <td><para unique="1261224">RMI</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261228">Both AES and</para>
      <para unique="1261229">AVX flags</para>
      </td>
     <td><para unique="1261231">Assist in AES round key generation using 8 bits Round Constant (RCON) specified in the immediate byte, operating on 128 bits of data specified in xmm2/m128 and stores the result in xmm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261233">
