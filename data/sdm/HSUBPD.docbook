    <tr>
     <td colspan="2"><para unique="1261206">66 0F 7D /r</para>
      <para unique="1261207">HSUBPD xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261211">RM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE3</para>
      </td>
     <td><para unique="1261217">Horizontal subtract packed double precision floating-point values from xmm2/m128 to xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.66.0F.WIG 7D /r</para>
      <para unique="1261220">VHSUBPD xmm1,xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1261224">RVM</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261228">AVX</para>
      </td>
     <td><para unique="1261230">Horizontal subtract packed double precision floating-point values from xmm2 and xmm3/mem.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261232">VEX.256.66.0F.WIG 7D /r</para>
      <para unique="1261233">VHSUBPD ymm1, ymm2, ymm3/m256</para>
      </td>
     <td><para unique="1261237">RVM</para>
      </td>
     <td><para unique="1261239">V/V</para>
      </td>
     <td><para unique="1261241">AVX</para>
      </td>
     <td><para unique="1261243">Horizontal subtract packed double precision floating-point values from ymm2 and ymm3/mem.</para>
      </td>
     </tr>
