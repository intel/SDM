    <tr>
     <td colspan="2"><para unique="1045901">VEX.LIG.66.0F38.W0 99 /r </para>
      <para unique="1045902">VFMADD132SS xmm1, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1045906">A</para>
      </td>
     <td><para unique="1045908">V/V</para>
      </td>
     <td><para unique="1045910">FMA</para>
      </td>
     <td><para unique="1045912">Multiply scalar single precision floating-point value from xmm1 and xmm3/m32, add to xmm2 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045914">VEX.LIG.66.0F38.W0 A9 /r </para>
      <para unique="1045915">VFMADD213SS xmm1, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1045919">A</para>
      </td>
     <td><para unique="1045921">V/V</para>
      </td>
     <td><para unique="1045923">FMA</para>
      </td>
     <td><para unique="1045925">Multiply scalar single precision floating-point value from xmm1 and xmm2, add to xmm3/m32 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045927">VEX.LIG.66.0F38.W0 B9 /r </para>
      <para unique="1045928">VFMADD231SS xmm1, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1045932">A</para>
      </td>
     <td><para unique="1045934">V/V</para>
      </td>
     <td><para unique="1045936">FMA</para>
      </td>
     <td><para unique="1045938">Multiply scalar single precision floating-point value from xmm2 and xmm3/m32, add to xmm1 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046476">EVEX.LLIG.66.0F38.W0 99 /r </para>
      <para unique="1046477">VFMADD132SS xmm1 {k1}{z}, xmm2, xmm3/m32{er}</para>
      </td>
     <td><para unique="1046481">B</para>
      </td>
     <td><para unique="1046483">V/V</para>
      </td>
     <td><para unique="1046488">AVX512F</para>
      <para unique="1046492">OR AVX10.1<anchor id="+658677"/></para>
      </td>
     <td><para unique="1046494">Multiply scalar single precision floating-point value from xmm1 and xmm3/m32, add to xmm2 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046459">EVEX.LLIG.66.0F38.W0 A9 /r </para>
      <para unique="1046460">VFMADD213SS xmm1 {k1}{z}, xmm2, xmm3/m32{er}</para>
      </td>
     <td><para unique="1046464">B</para>
      </td>
     <td><para unique="1046466">V/V</para>
