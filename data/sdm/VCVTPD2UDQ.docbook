    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046405">EVEX.128.0F.W1 79 /r</para>
      <para unique="1046406">VCVTPD2UDQ xmm1 {k1}{z}, xmm2/m128/m64bcst</para>
      </td>
     <td><para unique="1046410">A</para>
      </td>
     <td><para unique="1046412">V/V</para>
      </td>
     <td><para unique="1046414">(AVX512VL AND</para>
      <para unique="1046418">AVX512F) OR AVX10.1<anchor id="+894078"/></para>
      </td>
     <td><para unique="1046423">Convert two packed double precision floating-point values in xmm2/m128/m64bcst to two unsigned doubleword integers in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046388">EVEX.256.0F.W1 79 /r</para>
      <para unique="1046389">VCVTPD2UDQ xmm1 {k1}{z}, ymm2/m256/m64bcst</para>
      </td>
     <td><para unique="1046393">A</para>
      </td>
     <td><para unique="1046395">V/V</para>
      </td>
     <td><para unique="1046397">(AVX512VL AND</para>
      <para unique="1046401">AVX512F) OR AVX10.1</para>
      </td>
     <td><para unique="1046403">Convert four packed double precision floating-point values in ymm2/m256/m64bcst to four unsigned doubleword integers in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046375">EVEX.256.NP.0F.W1 79 /r</para>
      <para unique="1046376">VCVTPD2UDQ xmm1 {k1}{z}, ymm2/m256/m64bcst {er}</para>
      </td>
     <td><para unique="1046380">A</para>
      </td>
     <td><para unique="1046382">V/V</para>
      </td>
     <td><para unique="1046384">AVX10.2<superscript>1</superscript></para>
      </td>
     <td><para unique="1046386">Convert four packed double precision floating-point values in ymm2/m256/m64bcst to four unsigned doubleword integers in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046358">EVEX.512.0F.W1 79 /r</para>
      <para unique="1046359">VCVTPD2UDQ ymm1 {k1}{z}, zmm2/m512/m64bcst {er}</para>
      </td>
     <td><para unique="1046363">A</para>
      </td>
     <td><para unique="1046365">V/V</para>
      </td>
     <td><para unique="1046370">AVX512F </para>
      <para unique="1046371">OR AVX10.1</para>
      </td>
     <td><para unique="1046373">Convert eight packed double precision floating-point values in zmm2/m512/m64bcst to eight unsigned doubleword integers in ymm1 subject to writemask k1.</para>
      </td>
     </tr>
