 <shortdesc>Convert Packed Double Precision Floating-Point Values to Packed Unsigned Doubleword Integers</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="74.62368000000001pt"/>
   <col width="74.62368000000001pt"/>
   <col width="28.494pt"/>
   <col width="48.74976pt"/>
