<instruction name="CLWB">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Cache Line Write Back</shortdesc>
 <encoding_table><table unique="1261192">
   <col width="60.53976pt"/>
   <col width="60.54048pt"/>
   <col width="26.994239999999998pt"/>
   <col width="52.54992pt"/>
   <col width="66.2256pt"/>
   <col width="238.31064pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261194">Opcode/</para>
      <para unique="1261195">Instruction</para>
      </th>
     <th><para unique="1261199">Op/ En</para>
      </th>
     <th><para unique="1261201">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261203">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261207">66 0F AE /6</para>
      <para unique="1261208">CLWB m8</para>
      </td>
     <td><para unique="1261212">M</para>
      </td>
     <td><para unique="1261214">V/V</para>
      </td>
     <td><para unique="1261216">CLWB</para>
      </td>
     <td><para unique="1261218">Writes back modified cache line containing m8, and may retain the line in cache hierarchy in non-modified state.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261220">
   <col width="66.25296pt"/>
   <col width="110.23776pt"/>
   <col width="109.29312pt"/>
   <col width="112.5576pt"/>
   <col width="112.12776000000001pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261222">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261224">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261226">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261228">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261230">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261232">M</para>
      </td>
     <td valign="middle"><para unique="1261234">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1261236">N/A</para>
      </td>
     <td valign="middle"><para unique="1261238">N/A</para>
      </td>
