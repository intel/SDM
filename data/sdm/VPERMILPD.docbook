    <tr>
     <td colspan="2"><para unique="1047072">VEX.128.66.0F38.W0 0D /r</para>
      <para unique="1047073">VPERMILPD xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1047077">A</para>
      </td>
     <td><para unique="1047079">V/V</para>
      </td>
     <td><para unique="1047084">AVX</para>
      </td>
     <td><para unique="1047086">Permute double precision floating-point values in xmm2 using controls from xmm3/m128 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1047056">VEX.256.66.0F38.W0 0D /r</para>
      <para unique="1047057">VPERMILPD ymm1, ymm2, ymm3/m256</para>
