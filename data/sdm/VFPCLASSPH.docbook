      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046420">EVEX.128.NP.0F3A.W0 66 /r /ib</para>
      <para unique="1046421">VFPCLASSPH k1{k2}, xmm1/m128/m16bcst, imm8</para>
      </td>
     <td><para unique="1046423">A</para>
      </td>
     <td><para unique="1046425">V/V</para>
      </td>
     <td><para unique="1046427">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+844940"/></para>
      </td>
     <td><para unique="1046432">Test the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046409">EVEX.256.NP.0F3A.W0 66 /r /ib</para>
      <para unique="1046410">VFPCLASSPH k1{k2}, ymm1/m256/m16bcst, imm8</para>
      </td>
     <td><para unique="1046412">A</para>
      </td>
     <td><para unique="1046414">V/V</para>
      </td>
     <td><para unique="1046416">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+485729"/></para>
      </td>
     <td><para unique="1046418">Test the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046397">EVEX.512.NP.0F3A.W0 66 /r /ib</para>
      <para unique="1046398">VFPCLASSPH k1{k2}, zmm1/m512/m16bcst, imm8</para>
      </td>
     <td><para unique="1046400">A</para>
      </td>
     <td><para unique="1046402">V/V</para>
      </td>
     <td><para unique="1046404">AVX512_FP16 </para>
      <para unique="1046405">OR AVX10.1<anchor id="+611012"/></para>
      </td>
     <td><para unique="1046407">Test the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
