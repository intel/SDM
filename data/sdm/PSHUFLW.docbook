   <tbody>
    <tr>
     <td colspan="2"><para unique="1091405">F2 0F 70 /r ib</para>
      <para unique="1091406">PSHUFLW xmm1, xmm2/m128, imm8</para>
      </td>
     <td><para unique="1091410">A</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE2</para>
      </td>
     <td><para unique="1091416">Shuffle the low words in xmm2/m128 based on the encoding in imm8 and store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.F2.0F.WIG 70 /r ib</para>
