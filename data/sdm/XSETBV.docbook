<instruction name="XSETBV">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Set Extended Control Register</shortdesc>
 <encoding_table><table unique="1012543">
   <thead><tr>
     <th><para unique="1012545">Opcode</para>
      </th>
     <th><para unique="1012547">Instruction</para>
      </th>
     <th><para unique="1012549">Op/ En</para>
      </th>
     <th><para unique="1012551">64-Bit Mode</para>
      </th>
     <th><para unique="1012553">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1012555">Description</para>
      </th>
     </tr>
    </thead><col width="98.6112pt"/>
   <col width="111.86352000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td><para unique="1012557">NP 0F 01 D1</para>
      </td>
     <td><para unique="1012560"><indexterm><primary>XSETBV</primary></indexterm>XSETBV</para>
      </td>
     <td><para unique="1012562">ZO</para>
      </td>
     <td><para unique="1012564">Valid</para>
      </td>
     <td><para unique="1012566">Valid</para>
      </td>
     <td><para unique="1012568">Write the value in EDX:EAX to the XCR specified by ECX.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012570">
   <col width="46.12032pt"/>
   <col width="115.81128pt"/>
