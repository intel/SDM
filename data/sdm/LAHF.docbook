     <td><para unique="1261214">Valid<anchor id="+718118"/><footnote><para unique="1261213" format="TableFootnote">Invalid if CPUID.80000001H:ECX.LAHF_SAHF_64 is enumerated as 0<anchor id="+933799"/>.</para>
        </footnote></para>
      </td>
