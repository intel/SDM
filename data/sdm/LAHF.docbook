 <longdesc><para unique="1261243">This instruction executes as described above in compatibility mode and legacy mode. It is valid in 64-bit mode only if CPUID.80000001H:ECX.LAHF_SAHF_64[0] = 1. </para>
  </longdesc>
 <operation>
  <programlisting>IF 64-Bit Mode
	THEN
		IF CPUID.80000001H:ECX.LAHF_SAHF_64[0] = 1;
			THEN AH := RFLAGS(SF:ZF:0:AF:0:PF:1:CF);
			ELSE #UD;
		FI;
	ELSE
		AH := EFLAGS(SF:ZF:0:AF:0:PF:1:CF);
FI;</programlisting>
  </operation>
 <subsection title="Flags Affected">
  <para unique="1261247">None. The state of the flags in the EFLAGS register is not affected.</para>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261249">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261251" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261253" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261255" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1261257">If CPUID.80000001H:ECX.LAHF_SAHF_64[0] = 0.</para>
     </listitem>
    <listitem><para unique="1261258">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
