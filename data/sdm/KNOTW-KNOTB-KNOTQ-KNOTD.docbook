 <longdesc><para unique="1261274">Performs a bitwise NOT of vector mask k2 and writes the result into vector mask k1.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1261276">KNOTW</title>
   <programlisting>DEST[15:0] := BITWISE NOT SRC[15:0]
DEST[MAX_KL-1:16] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261280">KNOTB</title>
   <programlisting>DEST[7:0] := BITWISE NOT SRC[7:0]
DEST[MAX_KL-1:8] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261284">KNOTQ</title>
   <programlisting>DEST[63:0] := BITWISE NOT SRC[63:0]
DEST[MAX_KL-1:64] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261288">KNOTD</title>
   <programlisting>DEST[31:0] := BITWISE NOT SRC[31:0]
DEST[MAX_KL-1:32] := 0</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>KNOTW __mmask16 _mm512_knot(__mmask16 a);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1261294">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1261296">None.</para>
  </subsection>
