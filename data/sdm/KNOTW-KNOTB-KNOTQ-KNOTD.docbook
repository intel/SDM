<instruction name="KNOTW/KNOTB/KNOTQ/KNOTD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>NOT Mask Register</shortdesc>
 <longdesc><para unique="1261274">
   <string>Performs a bitwise NOT of vector mask k2 and writes the result into vector mask k1.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>KNOTW __mmask16 _mm512_knot(__mmask16 a);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1261294">
   <string>None.</string></para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1261296">
   <string>None.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1261301" format="xIndent1">
   <string>See </string><link linkend="42536: 06_Table: Table 2-63. TYPE K20 Exception Definition (VEX-Encoded OpMask"><string>Table&#160;2&#8209;65, &#8220;TYPE K20 Exception Definition (VEX-Encoded OpMask Instructions w/o Memory Arg).&#8221;</string></link></para>
  </subsection>
 </instruction>
