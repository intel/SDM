    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046315">EVEX.LLIG.F3.0F.W0 7B /r</para>
      <para unique="1046316">VCVTUSI2SS xmm1, xmm2, r/m32{er}</para>
      </td>
     <td><para unique="1046320">A</para>
      </td>
     <td><para unique="1046322">V/V</para>
      </td>
     <td><para unique="1046327">AVX512F</para>
      <para unique="1046331">OR AVX10.1<anchor id="+973334"/></para>
      </td>
     <td><para unique="1046333">Convert one unsigned doubleword integer from r/m32 to one single precision floating-point value in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046295">EVEX.LLIG.F3.0F.W1 7B /r</para>
      <para unique="1046296">VCVTUSI2SS xmm1, xmm2, r/m64{er}</para>
      </td>
     <td><para unique="1046300">A</para>
      </td>
     <td><para unique="1046305">V/N.E.<footnote><para unique="1046304" format="TableFootnote">For this specific instruction, EVEX.W in non-64 bit is ignored; the instruction behaves as if the W0 version is used.</para>
        </footnote></para>
      </td>
     <td><para unique="1046310">AVX512F</para>
      <para unique="1046311">OR AVX10.1<anchor id="+960927"/></para>
      </td>
     <td><para unique="1046313">Convert one unsigned quadword integer from r/m64 to one single precision floating-point value in xmm1.</para>
      </td>
