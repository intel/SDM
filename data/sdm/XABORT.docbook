    <tr>
     <td colspan="2"><para unique="1012556">C6 F8 ib</para>
      <para unique="1012557">XABORT imm8</para>
      </td>
     <td><para unique="1012561">A</para>
      </td>
     <td><para unique="1012563">V/V</para>
      </td>
     <td><para unique="1012565">RTM</para>
      </td>
     <td><para unique="1012567">Causes an RTM abort if in RTM execution.</para>
