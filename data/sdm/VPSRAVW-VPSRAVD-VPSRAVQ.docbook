 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046464">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046469" format="xIndent1">Non-EVEX-encoded instruction, see <link unique="1046467" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046473" format="xIndent1">EVEX-encoded instruction, see <link unique="1046471" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#79250: 06_Table: Table 2-49. Type E4 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;51, &#8220;Type E4 Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
