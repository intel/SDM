      </td>
     <td><para unique="1091414">SSE4_1</para>
      </td>
     <td><para unique="1091416">Find the minimum unsigned word in xmm2/m128 and place its value in the low word of xmm1 and its index in the second-lowest word of xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.66.0F38.WIG 41 /r</para>
      <para unique="1091419">VPHMINPOSUW xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091423">RM</para>
      </td>
     <td><para unique="1091425">V/V</para>
      </td>
     <td><para unique="1091427">AVX</para>
      </td>
     <td><para unique="1091429">Find the minimum unsigned word in xmm2/m128 and place its value in the low word of xmm1 and its index in the second-lowest word of xmm1.</para>
      </td>
     </tr>
