    <tr>
     <td><para unique="1046272">EVEX.LLIG.NP.MAP5.W0 2F /r</para>
      <para unique="1046273">VCOMISH xmm1, xmm2/m16 {sae}</para>
      </td>
     <td><para unique="1046275">A</para>
      </td>
     <td><para unique="1046277">V/V</para>
      </td>
     <td><para unique="1046279">AVX512_FP16 </para>
      <para unique="1046283">OR AVX10.1<anchor id="+559543"/></para>
      </td>
     <td><para unique="1046285">Compare low FP16 values in xmm1 and xmm2/m16, and set the EFLAGS flags accordingly.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045910">
   <col width="43.01352pt"/>
   <col width="61.01352pt"/>
