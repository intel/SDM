    </thead><col width="98.6112pt"/>
   <col width="111.86352000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="47.999520000000004pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td><para unique="1261207">FA</para>
      </td>
     <td><para unique="1261209">CLI</para>
      </td>
     <td><para unique="1261211">ZO</para>
      </td>
     <td><para unique="1261213">Valid</para>
      </td>
     <td><para unique="1261215">Valid</para>
      </td>
     <td><para unique="1261217">Clear interrupt flag; interrupts disabled when interrupt flag cleared.</para>
