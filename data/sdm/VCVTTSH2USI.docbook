<instruction name="VCVTTSH2USI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert with Truncation Low FP16 Value to an Unsigned Integer</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="29.2752pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="198.77472pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046278">EVEX.LLIG.F3.MAP5.W0 78 /r</para>
      <para unique="1046279">VCVTTSH2USI r32, xmm1/m16 {sae}</para>
      </td>
     <td><para unique="1046281">A</para>
      </td>
     <td><para unique="1046286">V/V<footnote><para unique="1046285" format="TableFootnote">Outside of 64b mode, the EVEX.W field is ignored. The instruction behaves as if W=0 was used.</para>
        </footnote></para>
      </td>
     <td><para unique="1046288">AVX512_FP16 </para>
      <para unique="1046292">OR AVX10.1<anchor id="+243560"/></para>
      </td>
     <td><para unique="1046294">Convert FP16 value in the low element of xmm1/m16 to an unsigned doubleword integer and store the result in r32 using truncation.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046266">EVEX.LLIG.F3.MAP5.W1 78 /r</para>
      <para unique="1046267">VCVTTSH2USI r64, xmm1/m16 {sae}</para>
      </td>
     <td><para unique="1046269">A</para>
      </td>
     <td><para unique="1046271">V/N.E.</para>
      </td>
     <td><para unique="1046273">AVX512_FP16 </para>
      <para unique="1046274">OR AVX10.1<anchor id="+606733"/></para>
      </td>
     <td><para unique="1046276">Convert FP16 value in the low element of xmm1/m16 to an unsigned quadword integer and store the result in r64 using truncation.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045924">
