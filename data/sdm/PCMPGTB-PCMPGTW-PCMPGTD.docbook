</string><string>PCMPGTW 		__m64 _mm_cmpgt_pi16 (__m64 m1, __m64 m2)</string><string>
</string><string>PCMPGTD 		__m64 _mm_cmpgt_pi32 (__m64 m1, __m64 m2)</string><string>
</string><string>(V)PCMPGTB 		__m128i _mm_cmpgt_epi8 ( __m128i a, __m128i b)</string><string>
