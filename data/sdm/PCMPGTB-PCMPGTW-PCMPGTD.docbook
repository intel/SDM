</string><string>VPCMPGTW __mmask8 _mm_cmpgt_epi16_mask(__m128i a, __m128i b);</string><string>
</string><string>VPCMPGTW __mmask8 _mm_mask_cmpgt_epi16_mask(__mmask8 k, __m128i a, __m128i b);</string><string>
