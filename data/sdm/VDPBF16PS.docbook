     <td colspan="2"><para unique="1046390">EVEX.128.F3.0F38.W0 52 /r</para>
      <para unique="1046391">VDPBF16PS xmm1{k1}{z}, xmm2, xmm3/m128/m32bcst</para>
      </td>
     <td><para unique="1046395">A</para>
      </td>
     <td><para unique="1046397">V/V</para>
      </td>
     <td><para unique="1046399">(AVX512_BF16 AND AVX512VL) OR AVX10.1<anchor id="+945794"/></para>
      </td>
     <td><para unique="1046404">Multiply BF16 pairs from xmm2 and xmm3/m128, and accumulate the resulting packed single precision results in xmm1 with writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046377">EVEX.256.F3.0F38.W0 52 /r</para>
      <para unique="1046378">VDPBF16PS ymm1{k1}{z}, ymm2, ymm3/m256/m32bcst</para>
      </td>
     <td><para unique="1046382">A</para>
      </td>
     <td><para unique="1046384">V/V</para>
      </td>
     <td><para unique="1046386">(AVX512_BF16 AND AVX512VL) OR AVX10.1<anchor id="+347520"/></para>
      </td>
     <td><para unique="1046388">Multiply BF16 pairs from ymm2 and ymm3/m256, and accumulate the resulting packed single precision results in ymm1 with writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046364">EVEX.512.F3.0F38.W0 52 /r</para>
      <para unique="1046365">VDPBF16PS zmm1{k1}{z}, zmm2, zmm3/m512/m32bcst</para>
      </td>
     <td><para unique="1046369">A</para>
      </td>
     <td><para unique="1046371">V/V</para>
      </td>
     <td><para unique="1046373">(AVX512_BF16 AND AVX512F) OR AVX10.1<anchor id="+341428"/></para>
      </td>
     <td><para unique="1046375">Multiply BF16 pairs from zmm2 and zmm3/m512, and accumulate the resulting packed single precision results in zmm1 with writemask k1.</para>
      </td>
     </tr>
