   <col width="46.728pt"/>
   <col width="199.404pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261205">NP 0F 01 CA</para>
      <para unique="1261206">CLAC</para>
      </td>
     <td><para unique="1261210">ZO</para>
      </td>
     <td><para unique="1261212">V/V</para>
      </td>
     <td><para unique="1261214">SMAP</para>
      </td>
     <td><para unique="1261216">Clear the AC flag in the EFLAGS register.</para>
      </td>
