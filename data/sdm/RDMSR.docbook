      </th>
     <th><para unique="1093156">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1093158">CPUID Feature Flag</para>
      </th>
     <th><para unique="1093160">Description</para>
      </th>
     </tr>
    </thead><col width="151.99992pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="57.6pt"/>
   <col width="182.15424000000002pt"/>
   <tbody>
    <tr>
     <td><para unique="1093162">0F 32</para>
      <para unique="1093163">RDMSR</para>
      </td>
