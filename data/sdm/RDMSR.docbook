 <shortdesc>Read From Model Specific Register</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th><para unique="1093151">Opcode<footnote><para unique="1093150" format="TableFootnote">See the IA-32 Architecture Compatibility section below.</para>
        </footnote>/</para>
      <para unique="1093152">Instruction</para>
      </th>
