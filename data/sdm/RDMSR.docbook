      </td>
     <td><para unique="1093167">Valid </para>
      </td>
     <td><para unique="1093169"/>
      </td>
     <td><para unique="1093171">Read MSR specified by ECX into EDX:EAX.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1093173">VEX.128.F2.MAP7:W0.F6 11:000:bbb</para>
