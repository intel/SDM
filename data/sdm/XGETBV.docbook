      </th>
     <th><para unique="1012552">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1012554">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td><para unique="1012556">NP 0F 01 D0</para>
      </td>
     <td><para unique="1012559"><indexterm><primary>XGETBV</primary></indexterm>XGETBV</para>
      </td>
     <td><para unique="1012561">ZO</para>
      </td>
     <td><para unique="1012563">Valid</para>
      </td>
     <td><para unique="1012565">Valid</para>
      </td>
     <td><para unique="1012567">Reads an XCR specified by ECX into EDX:EAX.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012569">
