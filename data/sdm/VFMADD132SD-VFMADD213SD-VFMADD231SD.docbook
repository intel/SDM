    <tr>
     <td colspan="2"><para unique="1045901">VEX.LIG.66.0F38.W1 99 /r </para>
      <para unique="1045902">VFMADD132SD xmm1, xmm2, xmm3/m64</para>
      </td>
     <td><para unique="1045906">A</para>
      </td>
     <td><para unique="1045908">V/V</para>
      </td>
     <td><para unique="1045910">FMA</para>
      </td>
     <td><para unique="1045912">Multiply scalar double precision floating-point value from xmm1 and xmm3/m64, add to xmm2 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045914">VEX.LIG.66.0F38.W1 A9 /r </para>
      <para unique="1045915">VFMADD213SD xmm1, xmm2, xmm3/m64</para>
      </td>
     <td><para unique="1045919">A</para>
      </td>
     <td><para unique="1045921">V/V</para>
      </td>
     <td><para unique="1045923">FMA</para>
      </td>
     <td><para unique="1045925">Multiply scalar double precision floating-point value from xmm1 and xmm2, add to xmm3/m64 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045927">VEX.LIG.66.0F38.W1 B9 /r</para>
      <para unique="1045928">VFMADD231SD xmm1, xmm2, xmm3/m64</para>
      </td>
     <td><para unique="1045932">A</para>
      </td>
     <td><para unique="1045934">V/V</para>
      </td>
     <td><para unique="1045936">FMA</para>
      </td>
     <td><para unique="1045938">Multiply scalar double precision floating-point value from xmm2 and xmm3/m64, add to xmm1 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046469">EVEX.LLIG.66.0F38.W1 99 /r </para>
      <para unique="1046470">VFMADD132SD xmm1 {k1}{z}, xmm2, xmm3/m64{er}</para>
      </td>
     <td><para unique="1046474">B</para>
      </td>
