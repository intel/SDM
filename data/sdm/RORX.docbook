    <tr>
     <td colspan="2"><para unique="1091405">VEX.LZ.F2.0F3A.W0 F0 /r ib</para>
      <para unique="1091406">RORX r32, r/m32, imm8</para>
      </td>
     <td><para unique="1091410">RMI</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">BMI2</para>
      </td>
     <td><para unique="1091416">Rotate 32-bit r/m32 right imm8 times and load into r32 without affecting arithmetic flags.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.LZ.F2.0F3A.W1 F0 /r ib</para>
      <para unique="1091419">RORX r64, r/m64, imm8</para>
      </td>
     <td><para unique="1091423">RMI</para>
      </td>
     <td><para unique="1091425">V/N.E.</para>
      </td>
     <td><para unique="1091427">BMI2</para>
      </td>
     <td><para unique="1091429">Rotate 64-bit r/m64 right imm8 times and load into r64 without affecting arithmetic flags.</para>
      </td>
     </tr>
    </tbody>
   </table>
