   <col width="44.24976pt"/>
   <col width="260.50104pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1091392">Opcode/&#8232;Instruction</para>
      </th>
     <th><para unique="1091396">Op/En</para>
      </th>
     <th><para unique="1091398">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1091400">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091404">NP 0F 38 CC /r </para>
      <para unique="1091405">SHA256MSG1 xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091409">RM</para>
      </td>
     <td><para unique="1091411">V/V</para>
      </td>
     <td><para unique="1091413">SHA</para>
      </td>
     <td><para unique="1091415">Performs an intermediate calculation for the next four SHA256 message dwords using previous message dwords from xmm1 and xmm2/m128, storing the result in xmm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
