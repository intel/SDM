<instruction name="SHA256MSG1">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform an Intermediate Calculation for the Next Four SHA256 Message Dwords</shortdesc>
 <encoding_table><table unique="1091390">
   <col width="50.66568pt"/>
   <col width="72.08424pt"/>
   <col width="37.49976pt"/>
