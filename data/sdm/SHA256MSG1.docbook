 <longdesc><para unique="1091435">The SHA256MSG1 instruction is one of two SHA256 message scheduling instructions. The instruction performs an intermediate calculation for the next four SHA256 message dwords.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1091437">SHA256MSG1 </title>
   <programlisting>W4 := SRC2[31: 0] ;
W3 := SRC1[127:96] ;
W2 := SRC1[95:64] ;
W1 := SRC1[63: 32] ;
W0 := SRC1[31: 0] ;
DEST[127:96] := W3 + &#963;0( W4);
DEST[95:64] := W2 + &#963;0( W3);
DEST[63:32] := W1 + &#963;0( W2);
DEST[31:0] := W0 + &#963;0( W1);</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>SHA256MSG1 __m128i _mm_sha256msg1_epu32(__m128i, __m128i);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1091451">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1091453">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
