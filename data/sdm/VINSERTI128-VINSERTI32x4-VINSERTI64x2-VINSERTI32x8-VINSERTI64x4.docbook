 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046201">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046206" format="xIndent1">VEX-encoded instruction, see <link unique="1046204" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#57777: 06_Table: Table 2-23. Type 6 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;23, &#8220;Type 6 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046207" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1046208">If VEX.L = 0.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  <para unique="1046212" format="xIndent1">EVEX-encoded instruction, see <link unique="1046210" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#46133: 06_Table: Table 2-54. Type E6NF Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;56, &#8220;Type E6NF Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
