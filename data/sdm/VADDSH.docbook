  </operand_table>
 <longdesc><para unique="1045937">This instruction adds the low FP16 value from the source operands and stores the FP16 result in the destination operand.</para>
  <para unique="1045938">Bits 127:16 of the destination operand are copied from the corresponding bits of the first source operand. Bits MAXVL-1:128 of the destination operand are zeroed. The low FP16 element of the destination is updated according to the writemask.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1045940">VADDSH (EVEX Encoded Versions) </title>
   <programlisting>IF EVEX.b = 1 and SRC2 is a register:
	SET_RM(EVEX.RC)
ELSE
	SET_RM(MXCSR.RC)
IF k1[0] OR *no writemask*:
	DEST.fp16[0] := SRC1.fp16[0] + SRC2.fp16[0]
ELSE	IF *zeroing*:
	DEST.fp16[0] := 0
// else dest.fp16[0] remains unchanged
DEST[127:16] := SRC1[127:16]
DEST[MAXVL-1:128] := 0</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>VADDSH __m128h _mm_add_round_sh (__m128h a, __m128h b, int rounding);
VADDSH ___m128h _mm_mask_add_round_sh (__m128h src, __mmask8 k, __m128h a, __m128h b, int rounding);
VADDSH ___m128h _mm_maskz_add_round_sh (__mmask8 k, __m128h a, __m128h b, int rounding);
VADDSH ___m128h _mm_add_sh (__m128h a, __m128h b);
VADDSH ___m128h _mm_mask_add_sh (__m128h src, __mmask8 k, __m128h a, __m128h b);
VADDSH ___m128h _mm_maskz_add_sh (__mmask8 k, __m128h a, __m128h b);</programlisting>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1045960">Invalid, Underflow, Overflow, Precision, Denormal.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1045965">EVEX-encoded instructions, see <link unique="1045963" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#63155: 06_Table: Table 2-47. Type E3 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;49, &#8220;Type E3 Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
