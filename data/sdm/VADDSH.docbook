 <shortdesc>Add Scalar FP16 Values</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="30.52512pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="198.14976pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046245">EVEX.LLIG.F3.MAP5.W0 58 /r</para>
      <para unique="1046246">VADDSH xmm1{k1}{z}, xmm2, xmm3/m16 {er}</para>
      </td>
     <td><para unique="1046248">A</para>
      </td>
     <td><para unique="1046250">V/V</para>
      </td>
     <td><para unique="1046252">AVX512_FP16 </para>
      <para unique="1046256">OR AVX10.1<anchor id="+511930"/></para>
      </td>
     <td><para unique="1046258">Add the low FP16 value from xmm3/m16 to xmm2, and store the result in xmm1 subject to writemask k1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045910">
