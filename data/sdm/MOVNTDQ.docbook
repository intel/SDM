    <tr>
     <td colspan="2"><para unique="1091405">66 0F E7 /r</para>
      <para unique="1091406">MOVNTDQ m128, xmm1</para>
      </td>
     <td><para unique="1091410">A</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE2</para>
      </td>
     <td><para unique="1091416">Move packed integer values in xmm1 to m128 using non-temporal hint.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.66.0F.WIG E7 /r</para>
