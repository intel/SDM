    <term>#SS(0)</term>
    <listitem><para unique="1261388">If a memory address referencing the SS segment is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1261389">If the memory address is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
