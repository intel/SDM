   <tbody>
    <tr>
     <td colspan="2"><para unique="1092649">F3 0F 38 F8 11:rrr:bbb</para>
      <para unique="1092650">UWRMSR r64, r64 </para>
      </td>
     <td><para unique="1092654">RM</para>
      </td>
