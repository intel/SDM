 <shortdesc>User Write to Model-Specific Register</shortdesc>
 <encoding_table><table unique="1092634">
   <thead><tr>
     <th colspan="2"><para unique="1092636">Opcode /</para>
      <para unique="1092637">Instruction</para>
      </th>
