   <col width="208.16712pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1045888">Opcode/</para>
      <para unique="1045889">Instruction</para>
      </th>
     <th><para unique="1045893">Op / En</para>
      </th>
     <th><para unique="1045895">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045897">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045899">Description</para>
