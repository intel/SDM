 <shortdesc>Convert Packed Unsigned Doubleword Integers to Packed Double Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="61.56288pt"/>
   <col width="87.58728pt"/>
   <col width="28.949759999999998pt"/>
