  <variablelist>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1091508">If a memory operand effective address is outside the CS, DS, ES, FS, or GS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
