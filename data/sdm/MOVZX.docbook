    <tr>
     <td valign="middle"><para unique="1091479">RM</para>
      </td>
     <td valign="middle"><para unique="1091481">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091483">ModRM:r/m (r)</para>
      </td>
