    <listitem><para unique="1091509">If a memory operand effective address is outside the SS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#PF(fault-code)</term>
    <listitem><para unique="1091510">If a page fault occurs.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#AC(0)</term>
    <listitem><para unique="1091511">If alignment checking is enabled and an unaligned memory reference is made.</para>
