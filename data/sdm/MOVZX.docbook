    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1091514" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#SS(0)</term>
    <listitem><para unique="1091516">If a memory address referencing the SS segment is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#GP(0)</term>
    <listitem><para unique="1091517">If the memory address is in a non-canonical form.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#PF(fault-code)</term>
    <listitem><para unique="1091518">If a page fault occurs.</para>
