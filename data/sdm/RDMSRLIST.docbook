<instruction name="RDMSRLIST">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Read List of Model Specific Registers</shortdesc>
 <encoding_table><table unique="1262506">
   <thead><tr>
     <th colspan="2"><para unique="1262508">Opcode /</para>
      <para unique="1262509">Instruction</para>
      </th>
