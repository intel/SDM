     <th><para unique="1262519">Description</para>
      </th>
     </tr>
    </thead><col width="76.33368pt"/>
   <col width="86.59152pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.00024pt"/>
   <col width="104.49936pt"/>
   <col width="171.954pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1262521">F2 0F 01 C6</para>
      <para unique="1262522">RDMSRLIST</para>
      </td>
     <td><para unique="1262526">ZO</para>
      </td>
     <td><para unique="1262528">V/N.E.</para>
      </td>
     <td><para unique="1262530">MSRLIST</para>
      </td>
     <td><para unique="1262532">Read the requested list of MSRs, and store the read values to memory.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1262534">
   <col width="45.8964pt"/>
   <col width="112.16592pt"/>
   <col width="115.80696pt"/>
   <col width="116.94456000000001pt"/>
   <col width="121.90608pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1262536">Op/En</para>
      </th>
     <th valign="middle"><para unique="1262538">Operand 1</para>
      </th>
