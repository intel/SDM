      </td>
     <td><para unique="1261349" format="CellBodyL">
       <string>CMPSD x</string><string>mm1, xmm2, 2</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261351" format="CellBodyL">
       <string>CMPUNORDSD x</string><string>mm1, xmm2</string></para>
      </td>
     <td><para unique="1261353" format="CellBodyL">
