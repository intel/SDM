     <td><para unique="1261343">CMPLTSD xmm1, xmm2</para>
      </td>
     <td><para unique="1261345">CMPSD xmm1, xmm2, 1</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261347">CMPLESD xmm1, xmm2</para>
      </td>
     <td><para unique="1261349">CMPSD xmm1, xmm2, 2</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261351">CMPUNORDSD xmm1, xmm2</para>
      </td>
     <td><para unique="1261353">CMPSD xmm1, xmm2, 3</para>
      </td>
     </tr>
