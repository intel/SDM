      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1261339">CMPEQSD xmm1, xmm2</para>
      </td>
     <td><para unique="1261341">CMPSD xmm1, xmm2, 0</para>
      </td>
     </tr>
