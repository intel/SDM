    <tr>
     <td colspan="2"><para unique="1262003">EVEX.LLIG.F2.0F.W1 C2 /r ib</para>
      <para unique="1262004">VCMPSD k1 {k2}, xmm2, xmm3/m64{sae}, imm8</para>
