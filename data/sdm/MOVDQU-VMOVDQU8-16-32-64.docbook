	i := j * 8
	IF k1[j] OR *no writemask*
		THEN DEST[i+7:i] :=
			SRC[i+7:i]
		ELSE 	*DEST[i+7:i] remains unchanged*									; merging-masking
	FI;
ENDFOR;</programlisting>
   </section>
