 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1092167">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1092172" format="xIndent1">Non-EVEX-encoded instruction, see <link unique="1092170" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions" xrefstyle="Table All - no page-period">Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1092176" format="xIndent1">EVEX-encoded instruction, see Exceptions Type E4.nb in <link unique="1092174" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#79250: 06_Table: Table 2-49. Type E4 Class Exception Conditions" xrefstyle="Table All - no page-period">Table&#160;2&#8209;51, &#8220;Type E4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1092177" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1092178">If EVEX.vvvv != 1111B or VEX.vvvv != 1111B.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
