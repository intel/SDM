<instruction name="CLUI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Clear User Interrupt Flag</shortdesc>
 <encoding_table><table unique="1261190">
   <col width="62.346959999999996pt"/>
   <col width="88.704pt"/>
   <col width="26.70048pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="206.84952pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261192">Opcode/</para>
      <para unique="1261193">Instruction</para>
      </th>
     <th><para unique="1261197">Op/</para>
      <para unique="1261198">En</para>
      </th>
     <th><para unique="1261200">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F3 0F 01 EE</para>
      <para unique="1261207">CLUI</para>
      </td>
     <td><para unique="1261211">ZO</para>
      </td>
     <td><para unique="1261213">V/I</para>
      </td>
     <td><para unique="1261215">UINTR</para>
      </td>
     <td><para unique="1261217">Clear user interrupt flag; user interrupts blocked when user interrupt flag cleared.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261219">
   <col width="40.61376pt"/>
   <col width="48.41352pt"/>
