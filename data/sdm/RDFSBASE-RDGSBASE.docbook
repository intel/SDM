    <tr>
     <td colspan="2"><para unique="1091432">F3 0F AE /1</para>
      <para unique="1091433">RDGSBASE r32</para>
      </td>
     <td><para unique="1091437">M</para>
      </td>
     <td><para unique="1091439">V/I</para>
