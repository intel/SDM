      </td>
     <td><para unique="1091450">M</para>
      </td>
     <td><para unique="1091452">V/I</para>
      </td>
     <td><para unique="1091454">FSGSBASE</para>
      </td>
     <td><para unique="1091456">Load the 64-bit destination register with the GS base address.</para>
