    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091470">M</para>
      </td>
     <td valign="middle"><para unique="1091472">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091474">N/A</para>
