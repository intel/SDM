      </th>
     <th><para unique="1091404">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091406">F3 0F AE /0</para>
      <para unique="1091407">RDFSBASE r32</para>
      </td>
     <td><para unique="1091411">M</para>
      </td>
     <td><para unique="1091413">V/I</para>
      </td>
     <td><para unique="1091415">FSGSBASE</para>
      </td>
     <td><para unique="1091417">Load the 32-bit destination register with the FS base address.</para>
      </td>
     </tr>
    <tr>
