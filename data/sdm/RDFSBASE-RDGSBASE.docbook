   <thead><tr>
     <th colspan="2"><para unique="1091393">Opcode/</para>
      <para unique="1091394">Instruction</para>
      </th>
     <th><para unique="1091398">Op/ En</para>
      </th>
     <th><para unique="1091400">64/32-bit Mode</para>
      </th>
