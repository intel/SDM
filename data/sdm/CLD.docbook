 <longdesc><para unique="1261241">Clears the DF flag in the EFLAGS register. When the DF flag is set to 0, string operations increment the index regis&#173;ters (ESI and/or EDI). Operation is the same in all modes.</para>
  </longdesc>
 <operation>
  <programlisting>DF := 0;</programlisting>
  </operation>
 <subsection title="Flags Affected">
  <para unique="1261245">The DF flag is set to 0. The CF, OF, ZF, SF, AF, and PF flags are unaffected.</para>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261247">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
