 <shortdesc>Convert Scalar Single Precision Floating-Point Value to Scalar Double Precision Floating-Point Value</shortdesc>
 <encoding_table><table unique="1261192">
   <col width="76.45608pt"/>
   <col width="76.45608pt"/>
   <col width="31.04424pt"/>
   <col width="48.74976pt"/>
   <col width="59.74992pt"/>
   <col width="219.91752pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261194">Opcode/</para>
      <para unique="1261195">Instruction</para>
      </th>
     <th><para unique="1261199">Op / En</para>
      </th>
     <th><para unique="1261201">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261203">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261207">F3 0F 5A /r</para>
      <para unique="1261208">CVTSS2SD xmm1, xmm2/m32</para>
      </td>
     <td><para unique="1261212">A</para>
      </td>
     <td><para unique="1261214">V/V</para>
      </td>
     <td><para unique="1261216">SSE2</para>
      </td>
     <td><para unique="1261218">Convert one single precision floating-point value in xmm2/m32 to one double precision floating-point value in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261220">VEX.LIG.F3.0F.WIG 5A /r</para>
      <para unique="1261221">VCVTSS2SD xmm1, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1261225">B</para>
      </td>
     <td><para unique="1261227">V/V</para>
      </td>
     <td><para unique="1261232">AVX</para>
      </td>
     <td><para unique="1261234">Convert one single precision floating-point value in xmm3/m32 to one double precision floating-point value and merge with high bits of xmm2.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261684">EVEX.LLIG.F3.0F.W0 5A /r</para>
      <para unique="1261685">VCVTSS2SD xmm1 {k1}{z}, xmm2, xmm3/m32{sae}</para>
      </td>
     <td><para unique="1261689">C</para>
      </td>
     <td><para unique="1261691">V/V</para>
      </td>
     <td><para unique="1261696">AVX512F</para>
      <para unique="1261700">OR AVX10.1<anchor id="+546708"/> </para>
      </td>
     <td><para unique="1261702">Convert one single precision floating-point value in xmm3/m32 to one double precision floating-point value and merge with high bits of xmm2 under writemask k1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
