      <para unique="1046756">VPBROADCASTQ ymm1 {k1}{z}, r64</para>
      </td>
     <td><para unique="1046760">A</para>
      </td>
     <td><para unique="1046762">V/N.E.<superscript><link unique="1047495" linkend="#79551: TableFootnote: 1. EVEX.W in non-64 bit is ignored; the instruction b" xrefstyle="Footnote">1</link></superscript></para>
      </td>
     <td><para unique="1046764">(AVX512VL AND</para>
      <para unique="1046768">AVX512F) OR AVX10.1<anchor id="+925088"/></para>
      </td>
