    <tr>
     <td colspan="2"><para unique="1046910">EVEX.128.66.0F38.W0 7A /r</para>
      <para unique="1046911">VPBROADCASTB xmm1 {k1}{z}, reg</para>
      </td>
     <td><para unique="1046915">A</para>
      </td>
     <td><para unique="1046917">V/V</para>
      </td>
     <td><para unique="1046919">(AVX512VL AND</para>
      <para unique="1046920">AVX512BW) OR AVX10.1<anchor id="+348516"/></para>
      </td>
     <td><para unique="1046925">Broadcast an 8-bit value from a GPR to all bytes in the 128-bit destination subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
