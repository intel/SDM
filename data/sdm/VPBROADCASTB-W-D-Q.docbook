    <tr>
     <td colspan="2"><para unique="1046772">EVEX.128.66.0F38.W1 7C /r</para>
      <para unique="1046773">VPBROADCASTQ xmm1 {k1}{z}, r64</para>
      </td>
     <td><para unique="1046777">A</para>
      </td>
     <td><para unique="1046779">V/N.E.<footnote><para unique="1047484" format="TableFootnote"><anchor id="79551: TableFootnote: 1. EVEX.W in non-64 bit is ignored; the instruction b"/>EVEX.W in non-64 bit is ignored; the instruction behaves as if the W0 version is used.</para>
        </footnote></para>
