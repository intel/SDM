     <td colspan="2"><para unique="1261205">F2 0F 2A /r</para>
      <para unique="1261206">CVTSI2SD xmm1, r32/m32</para>
      </td>
     <td><para unique="1261210">A</para>
      </td>
     <td><para unique="1261212">V/V</para>
      </td>
     <td><para unique="1261214">SSE2</para>
      </td>
     <td><para unique="1261216">Convert one signed doubleword integer from r32/m32 to one double precision floating-point value in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261218">F2 REX.W 0F 2A /r</para>
      <para unique="1261219">CVTSI2SD xmm1, r/m64</para>
      </td>
     <td><para unique="1261223">A</para>
