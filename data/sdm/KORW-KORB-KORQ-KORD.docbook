 <shortdesc>Bitwise Logical OR Masks</shortdesc>
 <encoding_table><table unique="1261190">
   <col width="53.10792pt"/>
   <col width="75.55896000000001pt"/>
   <col width="42.75pt"/>
   <col width="48.74976pt"/>
   <col width="60.2496pt"/>
   <col width="232.00056pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261192">Opcode/&#8232;Instruction</para>
      </th>
     <th><para unique="1261196">Op/En</para>
      </th>
     <th><para unique="1261198">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261200">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261202">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261204">VEX.L1.0F.W0 45 /r </para>
      <para unique="1261205">KORW k1, k2, k3</para>
      </td>
     <td><para unique="1261209">RVR</para>
      </td>
     <td><para unique="1261211">V/V</para>
      </td>
     <td><para unique="1261632">AVX512F</para>
      <para unique="1261633">OR AVX10.1</para>
      </td>
     <td><para unique="1261218">Bitwise OR 16 bits masks k2 and k3 and place result in k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261220">VEX.L1.66.0F.W0 45 /r </para>
      <para unique="1261221">KORB k1, k2, k3</para>
      </td>
     <td><para unique="1261225">RVR</para>
      </td>
     <td><para unique="1261227">V/V</para>
      </td>
     <td><para unique="1261635">AVX512DQ</para>
      <para unique="1261636">OR AVX10.1</para>
      </td>
     <td><para unique="1261231">Bitwise OR 8 bits masks k2 and k3 and place result in k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261233">VEX.L1.0F.W1 45 /r </para>
      <para unique="1261234">KORQ k1, k2, k3</para>
      </td>
     <td><para unique="1261238">RVR</para>
      </td>
     <td><para unique="1261240">V/V</para>
      </td>
     <td><para unique="1261638">AVX512BW</para>
      <para unique="1261639">OR AVX10.1</para>
      </td>
     <td><para unique="1261244">Bitwise OR 64 bits masks k2 and k3 and place result in k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261246">VEX.L1.66.0F.W1 45 /r </para>
      <para unique="1261247">KORD k1, k2, k3</para>
      </td>
     <td><para unique="1261251">RVR</para>
      </td>
     <td><para unique="1261253">V/V</para>
      </td>
     <td><para unique="1261641">AVX512BW</para>
      <para unique="1261642">OR AVX10.1</para>
      </td>
     <td><para unique="1261257">Bitwise OR 32 bits masks k2 and k3 and place result in k1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261259">
   <col width="61.092pt"/>
   <col width="138.71952pt"/>
   <col width="142.84944pt"/>
   <col width="169.1532pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261261">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261263">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261265">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261267">Operand 3</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261269">RVR</para>
      </td>
     <td valign="middle"><para unique="1261271">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261273">VEX.1vvv (r)</para>
      </td>
     <td valign="middle"><para unique="1261275">ModRM:r/m (r, ModRM:[7:6] must be 11b)</para>
      </td>
     </tr>
    </tbody>
   <caption unique="1261276">Instruction Operand Encoding</caption>
   </table>
  </operand_table>
 <longdesc><para unique="1261278">Performs a bitwise OR between the vector mask k2 and the vector mask k3, and writes the result into vector mask k1 (three-operand form).</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1261280">KORW</title>
   <programlisting>DEST[15:0] := SRC1[15:0] BITWISE OR SRC2[15:0]
DEST[MAX_KL-1:16] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261284">KORB</title>
   <programlisting>DEST[7:0] := SRC1[7:0] BITWISE OR SRC2[7:0]
DEST[MAX_KL-1:8] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261288">KORQ</title>
   <programlisting>DEST[63:0] := SRC1[63:0] BITWISE OR SRC2[63:0]
DEST[MAX_KL-1:64] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1261292">KORD</title>
   <programlisting>DEST[31:0] := SRC1[31:0] BITWISE OR SRC2[31:0]
DEST[MAX_KL-1:32] := 0</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>KORW __mmask16 _mm512_kor(__mmask16 a, __mmask16 b);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1261298">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1261300">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1261305" format="xIndent1">See <link unique="1261303" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#42536: 06_Table: Table 2-63. TYPE K20 Exception Definition (VEX-Encoded OpMask" xrefstyle="Table All - no page-period">Table&#160;2&#8209;65, &#8220;TYPE K20 Exception Definition (VEX-Encoded OpMask Instructions w/o Memory Arg).&#8221;</link></para>
  </subsection>
 </instruction>
