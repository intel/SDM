   <col width="174.65472pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1262679">F3 0F 01 C6</para>
      <para unique="1262680">WRMSRLIST</para>
      </td>
     <td><para unique="1262684">ZO</para>
      </td>
     <td><para unique="1262686">V/N.E.</para>
      </td>
     <td><para unique="1262688">MSRLIST</para>
      </td>
     <td><para unique="1262690">Write requested list of MSRs with the values specified in memory.</para>
      </td>
     </tr>
