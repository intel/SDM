   <col width="114.40656pt"/>
   <col width="121.62599999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1262694">Op/En</para>
      </th>
     <th valign="middle"><para unique="1262696">Operand 1</para>
      </th>
