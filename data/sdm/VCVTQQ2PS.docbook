    <tr>
     <td colspan="2"><para unique="1046377">EVEX.128.0F.W1 5B /r</para>
      <para unique="1046378">VCVTQQ2PS xmm1 {k1}{z}, xmm2/m128/m64bcst </para>
      </td>
     <td><para unique="1046382">A</para>
      </td>
     <td><para unique="1046384">V/V</para>
      </td>
     <td><para unique="1046386">(AVX512VL AND</para>
      <para unique="1046387">AVX512DQ) OR AVX10.1<anchor id="+338546"/></para>
      </td>
     <td><para unique="1046392">Convert two packed quadword integers from xmm2/mem to packed single precision floating-point values in xmm1 with writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046363">EVEX.256.0F.W1 5B /r</para>
      <para unique="1046364">VCVTQQ2PS xmm1 {k1}{z}, ymm2/m256/m64bcst</para>
      </td>
     <td><para unique="1046368">A</para>
      </td>
     <td><para unique="1046370">V/V</para>
      </td>
     <td><para unique="1046372">(AVX512VL AND</para>
      <para unique="1046373">AVX512DQ) OR AVX10.1<anchor id="+889079"/></para>
      </td>
     <td><para unique="1046375">Convert four packed quadword integers from ymm2/mem to packed single precision floating-point values in xmm1 with writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046350">EVEX.256.NP.0F.W1 5B /r</para>
      <para unique="1046351">VCVTQQ2PS xmm1 {k1}{z}, ymm2/m256/m64bcst {er}</para>
      </td>
     <td><para unique="1046355">A</para>
      </td>
     <td><para unique="1046357">V/V</para>
      </td>
     <td><para unique="1046359">AVX10.2<superscript>1</superscript></para>
      </td>
     <td><para unique="1046361">Convert four packed quadword integers from ymm2/mem to packed single precision floating-point values in xmm1 with writemask k1.</para>
