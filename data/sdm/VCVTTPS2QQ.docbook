   <col width="99.47735999999999pt"/>
   <col width="102.57336000000001pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1045942">Op/En</para>
      </th>
     <th valign="middle"><para unique="1045944">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1045946">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1045948">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1045950">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1045952">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1045954">A</para>
      </td>
     <td valign="middle"><para unique="1045956">Half</para>
      </td>
     <td valign="middle"><para unique="1045958">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1045960">ModRM:r/m (r)</para>
      </td>
