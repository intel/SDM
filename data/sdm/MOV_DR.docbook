 <operand_table><table unique="1091458">
   <col width="48.007439999999995pt"/>
   <col width="112.47048pt"/>
   <col width="121.13568pt"/>
   <col width="111.80376pt"/>
   <col width="117.8028pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091460">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091462">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091464">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091466">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091468">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091470">MR</para>
      </td>
     <td valign="middle"><para unique="1091472">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091474">ModRM:reg (r)</para>
      </td>
     <td valign="middle"><para unique="1091476">N/A</para>
      </td>
     <td valign="middle"><para unique="1091478">N/A</para>
      </td>
     </tr>
    <tr>
     <td valign="middle"><para unique="1091480">RM</para>
      </td>
     <td valign="middle"><para unique="1091482">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091484">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1091486">N/A</para>
