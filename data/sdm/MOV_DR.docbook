 <shortdesc>Move to/from Debug Registers</shortdesc>
 <encoding_table><table unique="1091391">
   <thead><tr>
     <th><para unique="1091393">Opcode</para>
      </th>
     <th><para unique="1091396">Instruction</para>
      </th>
     <th><para unique="1091398">Op/ En</para>
      </th>
     <th><para unique="1091400">64-Bit Mode</para>
      </th>
     <th><para unique="1091402">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091404">Description</para>
      </th>
     </tr>
    </thead><col width="98.784pt"/>
   <col width="112.104pt"/>
   <col width="24.696pt"/>
   <col width="47.952000000000005pt"/>
   <col width="46.656pt"/>
   <col width="181.152pt"/>
   <tbody>
    <tr>
     <td><para unique="1091406">0F 21/r</para>
      </td>
     <td><para unique="1091407">MOV r32, DR0&#8211;DR7</para>
      </td>
     <td><para unique="1091411">MR</para>
      </td>
     <td><para unique="1091413">N.E.</para>
      </td>
     <td><para unique="1091415">Valid</para>
      </td>
     <td><para unique="1091417">Move debug register to r32.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091419">0F 21/r</para>
      </td>
     <td><para unique="1091420">MOV r64, DR0&#8211;DR7</para>
      </td>
     <td><para unique="1091424">MR</para>
      </td>
     <td><para unique="1091426">Valid</para>
      </td>
     <td><para unique="1091428">N.E.</para>
      </td>
     <td><para unique="1091430">Move extended debug register to r64. </para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091432">0F 23 /r</para>
      </td>
     <td><para unique="1091433">MOV DR0&#8211;DR7, r32</para>
      </td>
     <td><para unique="1091437">RM</para>
      </td>
     <td><para unique="1091439">N.E.</para>
      </td>
     <td><para unique="1091441">Valid</para>
      </td>
     <td><para unique="1091443">Move r32 to debug register.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091445">0F 23 /r</para>
      </td>
     <td><para unique="1091446">MOV DR0&#8211;DR7, r64</para>
      </td>
     <td><para unique="1091450">RM</para>
      </td>
     <td><para unique="1091452">Valid </para>
      </td>
     <td><para unique="1091454">N.E.</para>
      </td>
     <td><para unique="1091456">Move r64 to extended debug register. </para>
      </td>
