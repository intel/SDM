    <tr>
     <td colspan="2"><para unique="1045901">VEX.128.66.0F38.W1 9C /r </para>
      <para unique="1045902">VFNMADD132PD xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1045906">A</para>
      </td>
     <td><para unique="1045908">V/V</para>
      </td>
     <td><para unique="1045910">FMA</para>
      </td>
     <td><para unique="1045912">Multiply packed double precision floating-point values from xmm1 and xmm3/mem, negate the multiplication result and add to xmm2 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045914">VEX.128.66.0F38.W1 AC /r </para>
      <para unique="1045915">VFNMADD213PD xmm1, xmm2, xmm3/m128</para>
