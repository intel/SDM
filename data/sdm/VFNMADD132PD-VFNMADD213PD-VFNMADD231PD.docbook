FI;
FOR j := 0 TO KL-1
	i := j * 64
	IF k1[j] OR *no writemask*
		THEN 	DEST[i+63:i] :=
			RoundFPControl(-(SRC2[i+63:i]*DEST[i+63:i]) + SRC3[i+63:i])
		ELSE
			IF *merging-masking*								; merging-masking
				THEN *DEST[i+63:i] remains unchanged*
				ELSE 							; zeroing-masking
					DEST[i+63:i] := 0
			FI
	FI;
ENDFOR
DEST[MAXVL-1:VL] := 0</programlisting>
   </section>
  <section level="7">
   <title unique="1046295">VFNMADD213PD DEST, SRC2, SRC3 (EVEX encoded version, when src3 operand is a memory source)</title>
   <programlisting>(KL, VL) = (2, 128), (4, 256), (8, 512)
FOR j := 0 TO KL-1
	i := j * 64
