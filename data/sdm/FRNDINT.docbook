<instruction name="FRNDINT">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Round to Integer</shortdesc>
 <longdesc><para unique="1261215">
   <string>Rounds the source value in the ST(0) register to the nearest integral value, depending on the current rounding mode (setting of the RC field of the FPU control word), and stores the result in ST(0).</string></para>
  <para unique="1261216">
   <string>If the source value is </string><string>&#8734;, the value is not changed. If the source value is not an integral value, the floating-point inexact-result exception (#P) is generated.</string></para>
  <para unique="1261217">
   <string>This instruction&#8217;s operation is the same in non-64-bit modes and 64-bit mode.</string></para>
  </longdesc>
 <subsection title="FPU Flags Affected">
  <variablelist>
   <variablelistentry>
    <term><string>C1</string></term>
    <listitem><string>Set to 0 if stack underflow occurred.</string></listitem>
    <listitem><string>Set if result was rounded up; cleared otherwise.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>C0, C2, C3 </string></term>
    <listitem><string>Undefined.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Floating-Point Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#IS</string></term>
    <listitem><string>Stack underflow occurred.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#IA</string></term>
    <listitem><string>Source operand is an SNaN value or unsupported format.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#D</string></term>
    <listitem><string>Source operand is a denormal value.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#P</string></term>
    <listitem><string>Source operand is not an integral value.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#NM</string></term>
    <listitem><string>CR0.EM[bit 2] or CR0.TS[bit 3] = 1.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#MF </string></term>
    <listitem><string>If there is a pending x87 FPU exception.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261234" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261236" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261238" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261240" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 </instruction>
