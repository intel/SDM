   <col width="103.85784pt"/>
   <col width="102.5676pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1045912">Op/En</para>
      </th>
     <th valign="middle"><para unique="1045914">Tuple</para>
      </th>
     <th valign="middle"><para unique="1045916">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1045918">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1045920">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1045922">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1045924">A</para>
      </td>
