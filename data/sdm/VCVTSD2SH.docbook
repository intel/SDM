<instruction name="VCVTSD2SH">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Low FP64 Value to an FP16 Value</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="28.65024pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="199.39968pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046280">EVEX.LLIG.F2.MAP5.W1 5A /r</para>
      <para unique="1046281">VCVTSD2SH xmm1{k1}{z}, xmm2, xmm3/m64 {er}</para>
      </td>
     <td><para unique="1046283">A</para>
      </td>
     <td><para unique="1046285">V/V</para>
      </td>
     <td><para unique="1046287">AVX512_FP16 </para>
      <para unique="1046291">OR AVX10.1<anchor id="+984230"/></para>
      </td>
     <td><para unique="1046293">Convert the low FP64 value in xmm3/m64 to an FP16 value and store the result in the low element of xmm1 subject to writemask k1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045910">
   <col width="43.01352pt"/>
   <col width="61.01352pt"/>
