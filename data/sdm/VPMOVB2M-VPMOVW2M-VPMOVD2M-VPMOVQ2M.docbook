    <tr>
     <td colspan="2"><para unique="1046824">EVEX.128.F3.0F38.W0 29 /r </para>
      <para unique="1046825">VPMOVB2M k1, xmm1</para>
      </td>
     <td><para unique="1046829">RM</para>
      </td>
     <td><para unique="1046831">V/V</para>
      </td>
     <td><para unique="1046833">(AVX512VL AND</para>
      <para unique="1046834">AVX512BW) OR AVX10.1<anchor id="+397133"/></para>
      </td>
     <td><para unique="1046839">Sets each bit in k1 to 1 or 0 based on the value of the most significant bit of the corresponding byte in XMM1. </para>
      </td>
