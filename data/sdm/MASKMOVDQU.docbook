<instruction name="MASKMOVDQU">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Store Selected Bytes of Double Quadword</shortdesc>
 <encoding_table><table unique="1091389">
   <thead><tr>
     <th colspan="2"><para unique="1091391">Opcode/</para>
      <para unique="1091392">Instruction</para>
      </th>
     <th><para unique="1091396">Op/ En</para>
      </th>
     <th><para unique="1091398">64/32-bit Mode</para>
      </th>
     <th><para unique="1091400">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="75.42pt"/>
   <col width="85.55543999999999pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="231.15384pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091404">66 0F F7 /r</para>
      <para unique="1091405">MASKMOVDQU xmm1, xmm2</para>
      </td>
     <td><para unique="1091409">RM</para>
      </td>
     <td><para unique="1091411">V/V</para>
      </td>
     <td><para unique="1091413">SSE2</para>
      </td>
     <td><para unique="1091415">Selectively write bytes from xmm1 to memory location using the byte mask in xmm2. The default memory location is specified by DS:DI/EDI/RDI.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091417">VEX.128.66.0F.WIG F7 /r</para>
      <para unique="1091418">VMASKMOVDQU xmm1, xmm2</para>
      </td>
     <td><para unique="1091422">RM</para>
      </td>
     <td><para unique="1091424">V/V</para>
      </td>
     <td><para unique="1091426">AVX</para>
      </td>
     <td><para unique="1091428">Selectively write bytes from xmm1 to memory location using the byte mask in xmm2. The default memory location is specified by DS:DI/EDI/RDI.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091430">
