    <tr>
     <td colspan="2"><para unique="1091407">F3 0F 1E /1 (mod=11)</para>
      <para unique="1091408">RDSSPD r32</para>
      </td>
     <td><para unique="1091412">R</para>
      </td>
     <td><para unique="1091414">V/V</para>
      </td>
     <td><para unique="1091416">CET_SS</para>
      </td>
     <td><para unique="1091418">Copy low 32 bits of shadow stack pointer (SSP) to r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091420">F3 REX.W 0F 1E /1 (mod=11)</para>
      <para unique="1091421">RDSSPQ r64</para>
      </td>
     <td><para unique="1091425">R</para>
      </td>
     <td><para unique="1091427">V/N.E.</para>
      </td>
     <td><para unique="1091429">CET_SS</para>
      </td>
     <td><para unique="1091431">Copies shadow stack pointer (SSP) to r64.</para>
      </td>
     </tr>
    </tbody>
