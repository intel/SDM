 <longdesc><para unique="1091456">Copies the current shadow stack pointer (SSP) register to the register destination. This opcode is a NOP when CET shadow stacks are not enabled and on processors that do not support CET.</para>
  </longdesc>
 <operation>
  <programlisting>IF CPL = 3
	IF CR4.CET &amp; IA32_U_CET.SH_STK_EN
		IF (operand size is 64 bit)
			THEN
				Dest := SSP;
			ELSE
				Dest := SSP[31:0];
		FI;
	FI;
ELSE
	IF CR4.CET &amp; IA32_S_CET.SH_STK_EN
		IF (operand size is 64 bit)
			THEN
				Dest := SSP;
			ELSE
				Dest := SSP[31:0];
		FI;
	FI;
FI;</programlisting>
  </operation>
 <subsection title="Flags Affected">
  <para unique="1091478">None.</para>
  </subsection>
 <subsection title="C/C++ Compiler Intrinsic Equivalent">
  <programlisting>RDSSPD	__int32 _rdsspd_i32(void);
RDSSPQ	__int64 _rdsspq_i64(void);</programlisting>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1091483">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
