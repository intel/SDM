<instruction name="RDSSPD/RDSSPQ">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Read Shadow Stack Pointer</shortdesc>
 <longdesc><para unique="1091456">
   <string>Copies the current shadow stack pointer (SSP) register to the register destination. This opcode is a NOP when CET shadow stacks are not enabled and on processors that do not support CET.</string></para>
  </longdesc>
 <subsection title="Flags Affected">
  <para unique="1091478">
   <string>None.</string></para>
  </subsection>
 <subsection title="C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>RDSSPD	__int32 _rdsspd_i32(void);</string><string>
</string><string>RDSSPQ	__int64 _rdsspq_i64(void);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
