 <shortdesc>Compute Reciprocals of Packed Single Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1091392">
   <thead><tr>
     <th colspan="2"><para unique="1091394">Opcode*/</para>
      <para unique="1091395">Instruction</para>
      </th>
     <th><para unique="1091399">Op/ En</para>
      </th>
     <th><para unique="1091401">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1091403">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091405">Description</para>
      </th>
     </tr>
    </thead><col width="98.6112pt"/>
   <col width="111.86352000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="180.65448pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091407">NP 0F 53 /r</para>
      <para unique="1091408">RCPPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091412">RM</para>
      </td>
     <td><para unique="1091414">V/V</para>
      </td>
     <td><para unique="1091416">SSE</para>
      </td>
     <td><para unique="1091418">Computes the approximate reciprocals of the packed single precision floating-point values in xmm2/m128 and stores the results in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091420">VEX.128.0F.WIG 53 /r</para>
      <para unique="1091421">VRCPPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091425">RM</para>
      </td>
     <td><para unique="1091427">V/V</para>
      </td>
     <td><para unique="1091429">AVX</para>
      </td>
     <td><para unique="1091431">Computes the approximate reciprocals of packed single precision values in xmm2/mem and stores the results in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091433">VEX.256.0F.WIG 53 /r</para>
      <para unique="1091434">VRCPPS ymm1, ymm2/m256</para>
      </td>
     <td><para unique="1091438">RM</para>
      </td>
     <td><para unique="1091440">V/V</para>
      </td>
     <td><para unique="1091442">AVX</para>
      </td>
     <td><para unique="1091444">Computes the approximate reciprocals of packed single precision values in ymm2/mem and stores the results in ymm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091446">
