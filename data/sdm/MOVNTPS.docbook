      </td>
     <td><para unique="1091414">SSE</para>
      </td>
     <td><para unique="1091416">Move packed single precision values xmm1 to mem using non-temporal hint.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.0F.WIG 2B /r</para>
