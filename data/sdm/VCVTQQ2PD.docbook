 <shortdesc>Convert Packed Quadword Integers to Packed Double Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="52.21368pt"/>
   <col width="74.28672pt"/>
   <col width="29.7pt"/>
