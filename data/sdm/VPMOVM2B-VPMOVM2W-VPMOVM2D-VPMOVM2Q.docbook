    <tr>
     <td colspan="2"><para unique="1046826">EVEX.128.F3.0F38.W0 28 /r </para>
      <para unique="1046827">VPMOVM2B xmm1, k1</para>
      </td>
     <td><para unique="1046831">RM</para>
      </td>
     <td><para unique="1046833">V/V</para>
      </td>
     <td><para unique="1046835">(AVX512VL AND</para>
      <para unique="1046836">AVX512BW) OR AVX10.1<anchor id="+282024"/></para>
      </td>
     <td><para unique="1046841">Sets each byte in XMM1 to all 1&#8217;s or all 0&#8217;s based on the value of the corresponding bit in k1. </para>
      </td>
     </tr>
    <tr>
