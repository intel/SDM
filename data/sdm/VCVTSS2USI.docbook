<instruction name="VCVTSS2USI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Scalar Single Precision Floating-Point Value to Unsigned Doubleword Integer</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="79.08192pt"/>
   <col width="79.08192pt"/>
   <col width="28.494pt"/>
