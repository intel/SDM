   <col width="207.08424000000002pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1045888">Opcode/</para>
      <para unique="1045889">Instruction</para>
      </th>
     <th><para unique="1045893">Op / En</para>
      </th>
     <th><para unique="1045895">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045897">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045899">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046314">EVEX.LLIG.F3.0F.W0 79 /r</para>
      <para unique="1046315">VCVTSS2USI r32, xmm1/m32{er}</para>
      </td>
     <td><para unique="1046319">A</para>
      </td>
     <td><para unique="1046321">V/V</para>
      </td>
     <td><para unique="1046326">AVX512F</para>
      <para unique="1046330">OR AVX10.1<anchor id="+241925"/></para>
      </td>
     <td><para unique="1046332">Convert one single precision floating-point value from xmm1/m32 to one unsigned doubleword integer in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046294">EVEX.LLIG.F3.0F.W1 79 /r</para>
      <para unique="1046295">VCVTSS2USI r64, xmm1/m32{er}</para>
      </td>
     <td><para unique="1046299">A</para>
      </td>
     <td><para unique="1046304">V/N.E.<footnote><para unique="1046303" format="TableFootnote">EVEX.W1 in non-64 bit is ignored; the instruction behaves as if the W0 version is used.</para>
        </footnote></para>
      </td>
     <td><para unique="1046309">AVX512F</para>
      <para unique="1046310">OR AVX10.1<anchor id="+222380"/> </para>
      </td>
     <td><para unique="1046312">Convert one single precision floating-point value from xmm1/m32 to one unsigned quadword integer in r64.</para>
      </td>
     </tr>
