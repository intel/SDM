  </operand_table>
 <longdesc><para unique="1091435">The SHA1MSG1 instruction is one of two SHA1 message scheduling instructions. The instruction performs an inter&#173;mediate calculation for the next four SHA1 message dwords.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1091437">SHA1MSG1 </title>
   <programlisting>W0 := SRC1[127:96] ;
W1 := SRC1[95:64] ;
W2 := SRC1[63: 32] ;
W3 := SRC1[31: 0] ;
W4 := SRC2[127:96] ;
W5 := SRC2[95:64] ;
DEST[127:96] := W2 XOR W0;
DEST[95:64] := W3 XOR W1;
DEST[63:32] := W4 XOR W2;
DEST[31:0] := W5 XOR W3;</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>SHA1MSG1 __m128i _mm_sha1msg1_epu32(__m128i, __m128i);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1091452">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1091454">None.</para>
  </subsection>
