     <td><para unique="1046584">(AVX512VL AND</para>
      <para unique="1046588">AVX512F) OR AVX10.1<anchor id="+263113"/></para>
      </td>
     <td><para unique="1046593">Compress packed doubleword integer values from xmm2 to xmm1/m128 using control mask k1.</para>
