     <td colspan="2"><para unique="1046575">EVEX.128.66.0F38.W0 8B /r</para>
      <para unique="1046576">VPCOMPRESSD xmm1/m128 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046580">A</para>
