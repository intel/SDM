    <tr>
     <td colspan="2"><para unique="1261207">F2 0F 38 F8 !(11):rrr:bbb</para>
      <para unique="1261208">ENQCMD r32/r64, m512</para>
      </td>
     <td><para unique="1261212">A</para>
      </td>
     <td><para unique="1261214">V/V</para>
      </td>
     <td><para unique="1261216">ENQCMD</para>
      </td>
     <td><para unique="1261218">Atomically enqueue 64-byte user command from source memory operand to destination offset in ES segment specified in register operand as offset in ES segment.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
