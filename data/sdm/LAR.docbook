 <operand_table><table unique="1261243">
   <col width="59.92344pt"/>
   <col width="114.80976000000001pt"/>
   <col width="113.07744pt"/>
   <col width="111.16584pt"/>
   <col width="113.74343999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261245">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261247">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261249">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261251">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261253">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261255">RM</para>
      </td>
     <td valign="middle"><para unique="1261257">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261259">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261261">N/A</para>
