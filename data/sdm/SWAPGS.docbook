   <col width="210.90384pt"/>
   <tbody>
    <tr>
     <td><para unique="1091406">0F 01 F8</para>
      </td>
     <td><para unique="1091408">SWAPGS</para>
      </td>
     <td><para unique="1091410">ZO</para>
      </td>
     <td><para unique="1091412">Valid</para>
      </td>
     <td><para unique="1091414">Invalid</para>
      </td>
     <td><para unique="1092091">Exchanges the current GS base register value with the IA32_KERNEL_GS_BASE MSR.</para>
      </td>
