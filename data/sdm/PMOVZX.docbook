      <para unique="1092689">VPMOVZXDQ zmm1 {k1}{z}, ymm2/m256</para>
      </td>
     <td><para unique="1092693">B</para>
      </td>
     <td><para unique="1092695">V/V</para>
      </td>
     <td><para unique="1092700">AVX512F </para>
      <para unique="1092701">OR AVX10.1</para>
      </td>
     <td><para unique="1092703">Zero extend 8 packed 32-bit integers in ymm2/m256 to 8 packed 64-bit integers in zmm1 using writemask k1.</para>
      </td>
     </tr>
    </tbody>
   </table>
