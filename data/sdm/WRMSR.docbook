<instruction name="WRMSR">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Write to Model Specific Register</shortdesc>
 <encoding_table><table unique="1012542">
   <thead><tr>
     <th><para unique="1012544">Opcode</para>
      </th>
     <th><para unique="1012546">Instruction</para>
      </th>
     <th><para unique="1012548">Op/ En</para>
      </th>
     <th><para unique="1012550">64-Bit Mode</para>
      </th>
     <th><para unique="1012552">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1012554">Description</para>
      </th>
     </tr>
    </thead><col width="97.90848pt"/>
   <col width="111.06576000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="180.65448pt"/>
   <tbody>
    <tr>
     <td><para unique="1012556">0F 30</para>
      </td>
     <td><para unique="1012558">WRMSR</para>
      </td>
     <td><para unique="1012560">ZO</para>
      </td>
     <td><para unique="1012562">Valid </para>
      </td>
     <td><para unique="1012564">Valid</para>
      </td>
     <td><para unique="1012566">Write the value in EDX:EAX to MSR specified by ECX.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1012568">
   <col width="46.32624pt"/>
   <col width="112.54823999999999pt"/>
