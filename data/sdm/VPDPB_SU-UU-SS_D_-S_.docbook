     <th valign="middle"><para unique="1047083">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1047085">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1047087">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1047089">Operand 3</para>
      </th>
