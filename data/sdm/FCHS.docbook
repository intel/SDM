<instruction name="FCHS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Change Sign</shortdesc>
 <longdesc><para unique="1261215">
   <string>Complements the sign bit of ST(0). This operation changes a positive value into a negative value of equal magni&#173;tude or vice versa. The following table shows the results obtained when changing the sign of various classes of numbers.</string></para>
  <table>
   <caption>Table 3-22.  FCHS Results</caption>
   <colgroup><col/>
    <col/>
    <col/>
    <col/>
    <col/>
    <col/>
    <col/>
    <col/>
    </colgroup>
   <tbody>
    <tr>
     <th><para unique="1261222" format="CellColHead">
       <string>ST(0) SRC</string></para>
      </th>
     <th><para unique="1261224" format="CellColHead">
       <string>ST(0) DEST</string></para>
      </th>
     </tr>
    <tr>
     <td><para unique="1261226" format="CellBodyL">
       <string>&#8722; </string><string>&#8734;</string></para>
      </td>
     <td><para unique="1261228" format="CellBodyL">
       <string>+ </string><string>&#8734;</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261230" format="CellBodyL">
       <string>&#8722; </string><sans><string>F</string></sans></para>
      </td>
     <td><para unique="1261232" format="CellBodyL">
       <string>+ F</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261234" format="CellBodyL">
       <string>&#8722; 0</string></para>
      </td>
     <td><para unique="1261236" format="CellBodyL">
       <string>+ 0</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261238" format="CellBodyL">
       <string>+ 0</string></para>
      </td>
     <td><para unique="1261240" format="CellBodyL">
       <string>&#8722; </string><sans><string>0</string></sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261242" format="CellBodyL">
       <string>+ F</string></para>
      </td>
     <td><para unique="1261244" format="CellBodyL">
       <string>&#8722; </string><sans><string>F</string></sans></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261246" format="CellBodyL">
       <string>+ </string><string>&#8734;</string></para>
      </td>
     <td><para unique="1261248" format="CellBodyL">
       <string>&#8722; </string><string>&#8734;</string></para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261250" format="CellBodyL">
       <string>NaN</string></para>
      </td>
     <td><para unique="1261252" format="CellBodyL">
       <sans><string>NaN </string></sans></para>
      </td>
     </tr>
    </tbody>
   <tfoot><tr>
     <td colspan="2"><para unique="1261254" format="TableFootnoteBLUE">
       <string>NOTES:</string></para>
      <para unique="1261255" format="TableFootnote">
       <string>*	F means finite floating-point value.</string></para>
      </td>
     </tr>
    </tfoot></table>
  <para unique="1261259">
   <string>This instruction&#8217;s operation is the same in non-64-bit modes and 64-bit mode.</string></para>
  </longdesc>
 <subsection title="FPU Flags Affected">
  <variablelist>
   <variablelistentry>
    <term><string>C1</string></term>
    <listitem><string>Set to 0.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>C0, C2, C3 </string></term>
    <listitem><string>Undefined.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Floating-Point Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#IS</string></term>
    <listitem><string>Stack underflow occurred.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#NM</string></term>
    <listitem><string>CR0.EM[bit 2] or CR0.TS[bit 3] = 1.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261271" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261273" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261275" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261277" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 </instruction>
