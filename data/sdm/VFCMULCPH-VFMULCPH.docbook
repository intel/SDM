 <subsection title="Other Exceptions">
  <para unique="1046108" format="xIndent1">EVEX-encoded instructions, see <link unique="1046106" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#79250: 06_Table: Table 2-49. Type E4 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;51, &#8220;Type E4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046109" format="xIndent1">Additionally:</para>
  <para unique="1046110" format="xIndent1">#UD 	If (dest_reg == src1_reg) or (dest_reg == src2_reg).</para>
  </subsection>
