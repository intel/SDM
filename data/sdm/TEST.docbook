     <td><para unique="1091484">MI</para>
      </td>
     <td><para unique="1091486">Valid </para>
      </td>
     <td><para unique="1091488">Valid</para>
      </td>
     <td><para unique="1091490">AND imm16 with r/m16; set SF, ZF, PF according to result.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091492">F7 /0 id</para>
      </td>
     <td><para unique="1091494">TEST r/m32, imm32</para>
