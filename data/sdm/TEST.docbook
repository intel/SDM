   <tbody>
    <tr>
     <td><para unique="1091405">A8&#160;&#160;ib</para>
      </td>
     <td><para unique="1091407">TEST AL, imm8</para>
      </td>
     <td><para unique="1091409">I</para>
      </td>
     <td><para unique="1091411">Valid </para>
      </td>
     <td><para unique="1091413">Valid</para>
      </td>
     <td><para unique="1091415">AND imm8 with AL; set SF, ZF, PF according to result.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091417">A9 iw</para>
      </td>
     <td><para unique="1091419">TEST AX, imm16</para>
      </td>
     <td><para unique="1091421">I</para>
      </td>
     <td><para unique="1091423">Valid </para>
      </td>
     <td><para unique="1091425">Valid</para>
      </td>
     <td><para unique="1091427">AND imm16 with AX; set SF, ZF, PF according to result.</para>
      </td>
