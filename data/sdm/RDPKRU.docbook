<instruction name="RDPKRU">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Read Protection Key Rights for User Pages</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th><para unique="1091392">Opcode*</para>
      </th>
     <th><para unique="1091394">Instruction</para>
