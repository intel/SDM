      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="90.21096pt"/>
   <col width="93.26304pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="210.50424pt"/>
   <tbody>
    <tr>
     <td><para unique="1091404">NP 0F 01 EE</para>
      </td>
     <td><para unique="1091406">RDPKRU</para>
      </td>
     <td><para unique="1091408">ZO</para>
      </td>
     <td><para unique="1091410">V/V</para>
      </td>
     <td><para unique="1091412">OSPKE</para>
      </td>
     <td><para unique="1091414">Reads PKRU into EAX.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091416">
   <col width="42.73704pt"/>
