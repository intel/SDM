 <shortdesc>Store Global Descriptor Table Register</shortdesc>
 <encoding_table><table unique="1091392">
   <thead><tr>
     <th><para unique="1091397">Opcode<footnote><para unique="1091396" format="TableFootnote">See the IA-32 Architecture Compatibility section below.</para>
        </footnote></para>
      </th>
     <th><para unique="1091399">Instruction</para>
      </th>
     <th><para unique="1091401">Op/ En</para>
      </th>
     <th><para unique="1091403">64-Bit Mode</para>
      </th>
     <th><para unique="1091405">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091407">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.65392pt"/>
   <tbody>
    <tr>
     <td><para unique="1091409">0F 01 /0</para>
      </td>
     <td><para unique="1091411">SGDT <italic>m</italic></para>
      </td>
     <td><para unique="1091413">M</para>
      </td>
     <td><para unique="1091415">Valid </para>
      </td>
     <td><para unique="1091417">Valid</para>
      </td>
     <td><para unique="1091419">Store GDTR to <italic>m.</italic></para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091421">
   <col width="45.98424pt"/>
   <col width="120.72024pt"/>
   <col width="112.25016pt"/>
   <col width="119.35296pt"/>
   <col width="112.91184pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091423">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091425">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091427">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091429">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091431">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091433">M</para>
      </td>
     <td valign="middle"><para unique="1091435">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091437">N/A</para>
      </td>
     <td valign="middle"><para unique="1091439">N/A</para>
      </td>
