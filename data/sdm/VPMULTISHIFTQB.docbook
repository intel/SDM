      </td>
     <td><para unique="1046526">A</para>
      </td>
     <td><para unique="1046528">V/V</para>
      </td>
     <td><para unique="1046530">(AVX512VL</para>
      <para unique="1046531">AVX512_VBMI) OR AVX10.1<anchor id="+486232"/></para>
      </td>
     <td><para unique="1046533">Select unaligned bytes from qwords in ymm3/m256/m64bcst using control bytes in ymm2, write byte results to ymm1 under k1.</para>
