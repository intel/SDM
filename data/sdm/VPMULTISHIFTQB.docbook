    <tr>
     <td><para unique="1046535">EVEX.128.66.0F38.W1 83 /r</para>
      <para unique="1046536">VPMULTISHIFTQB xmm1 {k1}{z}, xmm2,xmm3/m128/m64bcst</para>
      </td>
     <td><para unique="1046538">A</para>
      </td>
     <td><para unique="1046540">V/V</para>
      </td>
     <td><para unique="1046542">(AVX512VL AND</para>
      <para unique="1046543">AVX512_VBMI) OR AVX10.1<anchor id="+666901"/></para>
      </td>
     <td><para unique="1046548">Select unaligned bytes from qwords in xmm3/m128/m64bcst using control bytes in xmm2, write byte results to xmm1 under k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046523">EVEX.256.66.0F38.W1 83 /r</para>
