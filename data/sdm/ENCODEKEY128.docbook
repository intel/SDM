     <td valign="middle"><para unique="1261235">A</para>
      </td>
     <td valign="middle"><para unique="1261237">N/A</para>
      </td>
     <td valign="middle"><para unique="1261239">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261241">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261243">Implicit XMM0 (r, w)</para>
      </td>
     <td valign="middle"><para unique="1261245">Implicit XMM1&#8212;2 (w)</para>
      </td>
     <td valign="middle"><para unique="1261247">Implicit XMM4&#8212;6 (w)</para>
