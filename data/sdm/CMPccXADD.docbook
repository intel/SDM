   <thead><tr>
     <th><para unique="1261783">Opcode/</para>
      <para unique="1261784">Instruction</para>
      </th>
     <th><para unique="1261786">Op/</para>
      <para unique="1261787">En</para>
      </th>
     <th><para unique="1261789">64/32 bit Mode Support</para>
      </th>
