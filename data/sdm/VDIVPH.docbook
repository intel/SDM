     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046339">EVEX.128.NP.MAP5.W0 5E /r</para>
      <para unique="1046340">VDIVPH xmm1{k1}{z}, xmm2, xmm3/m128/m16bcst</para>
      </td>
     <td><para unique="1046342">A</para>
      </td>
     <td><para unique="1046344">V/V</para>
      </td>
     <td><para unique="1046346">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+946323"/></para>
      </td>
     <td><para unique="1046351">Divide packed FP16 values in xmm2 by packed FP16 values in xmm3/m128/m16bcst, and store the result in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046328">EVEX.256.NP.MAP5.W0 5E /r</para>
      <para unique="1046329">VDIVPH ymm1{k1}{z}, ymm2, ymm3/m256/m16bcst</para>
      </td>
     <td><para unique="1046331">A</para>
      </td>
     <td><para unique="1046333">V/V</para>
      </td>
     <td><para unique="1046335">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+765400"/></para>
      </td>
     <td><para unique="1046337">Divide packed FP16 values in ymm2 by packed FP16 values in ymm3/m256/m16bcst, and store the result in ymm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046316">EVEX.512.NP.MAP5.W0 5E /r</para>
      <para unique="1046317">VDIVPH zmm1{k1}{z}, zmm2, zmm3/m512/m16bcst {er}</para>
      </td>
     <td><para unique="1046319">A</para>
      </td>
     <td><para unique="1046321">V/V</para>
      </td>
     <td><para unique="1046323">AVX512_FP16</para>
      <para unique="1046324">OR AVX10.1<anchor id="+186366"/></para>
      </td>
     <td><para unique="1046326">Divide packed FP16 values in zmm2 by packed FP16 values in zmm3/m512/m16bcst, and store the result in zmm1 subject to writemask k1.</para>
      </td>
     </tr>
    </tbody>
   </table>
