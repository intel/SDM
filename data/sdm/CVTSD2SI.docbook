      </td>
     <td><para unique="1261265">Convert one double precision floating-point value from xmm1/m64 to one signed quadword integer sign-extended into r64.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261898">EVEX.LLIG.F2.0F.W0 2D /r</para>
      <para unique="1261899">VCVTSD2SI r32, xmm1/m64{er}</para>
