    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F2 0F 2D /r</para>
      <para unique="1261207">CVTSD2SI r32, xmm1/m64</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE2</para>
      </td>
     <td><para unique="1261217">Convert one double precision floating-point value from xmm1/m64 to one signed doubleword integer r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">F2 REX.W 0F 2D /r</para>
      <para unique="1261220">CVTSD2SI r64, xmm1/m64</para>
