<instruction name="VFPCLASSSH">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Test Types of Scalar FP16 Values</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="29.2752pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="198.77472pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046276">EVEX.LLIG.NP.0F3A.W0 67 /r /ib</para>
      <para unique="1046277">VFPCLASSSH k1{k2}, xmm1/m16, imm8</para>
      </td>
     <td><para unique="1046279">A</para>
      </td>
     <td><para unique="1046281">V/V</para>
      </td>
     <td><para unique="1046283">AVX512_FP16 </para>
      <para unique="1046287">OR AVX10.1<anchor id="+861440"/></para>
      </td>
     <td><para unique="1046289">Test the input for the following categories:&#160; NaN, +0, -0, +Infinity, -Infinity, denormal, finite negative. &#160;The immediate field provides a mask bit for each of these category tests. &#160;The masked test results are OR-ed together to form a mask result.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045910">
   <col width="43.01352pt"/>
   <col width="61.01352pt"/>
   <col width="95.65272pt"/>
   <col width="104.62608pt"/>
   <col width="103.85784pt"/>
   <col width="102.5676pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1045912">Op/En</para>
      </th>
     <th valign="middle"><para unique="1045914">Tuple</para>
      </th>
     <th valign="middle"><para unique="1045916">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1045918">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1045920">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1045922">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1045924">A</para>
      </td>
     <td valign="middle"><para unique="1045926">Scalar</para>
      </td>
     <td valign="middle"><para unique="1045928">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1045930">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1045932">imm8 (r)</para>
      </td>
     <td valign="middle"><para unique="1045934">N/A</para>
      </td>
     </tr>
    </tbody>
   <caption unique="1045935">Instruction Operand Encoding</caption>
   </table>
  </operand_table>
 <longdesc><para unique="1045937">This instruction checks the low FP16 value in the source operand for special categories, specified by the set bits in the imm8 byte. Each set bit in imm8 specifies a category of floating-point values that the input data element is clas&#173;sified against; see <link unique="1045939" linkend="&lt;c&gt;VFPCLASSPH-Test-Types-of-Packed-FP16-Values.fm#48994: 06_Table: Table 1-18. Classifier Operations for VFPCLASSPH/VFPCLASSSH" xrefstyle="TableNum">Table 5&#8209;12</link> for the categories. The classified results of all specified categories of an input value are ORed together to form the final boolean result for the input element. The result is written to the low bit in the destination mask register according to the writemask. The other bits in the destination mask register are zeroed.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1045942">VFPCLASSSH dest{k2}, src, imm8 </title>
   <programlisting>IF k2[0] or *no writemask*:
	DEST.bit[0] := check_fp_class_fp16(src.fp16[0], imm8) 															// see VFPCLASSPH
ELSE:
	DEST.bit[0] := 0
DEST[MAXKL-1:1] := 0</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <para unique="1045950">VFPCLASSSH __mmask8 _mm_fpclass_sh_mask (__m128h a, int imm8);</para>
  <para unique="1045951">VFPCLASSSH __mmask8 _mm_mask_fpclass_sh_mask (__mmask8 k1, __m128h a, int imm8);</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1045953">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1045958" format="xIndent1">EVEX-encoded instructions, see <link unique="1045956" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#31368: 06_Table: Table 2-58. Type E10 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;60, &#8220;Type E10 Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
