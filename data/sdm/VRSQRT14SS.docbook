<instruction name="VRSQRT14SS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Compute Approximate Reciprocal of Square Root of Scalar Float32 Value</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="71.6652pt"/>
   <col width="71.6652pt"/>
   <col width="28.494pt"/>
   <col width="48.74976pt"/>
   <col width="64.7496pt"/>
   <col width="227.83391999999998pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046088">Op / En</para>
      </th>
     <th><para unique="1046090">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046092">CPUID Feature Flag</para>
      </th>
     <th><para unique="1046094">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046555">EVEX.LLIG.66.0F38.W0 4F /r</para>
      <para unique="1046556">VRSQRT14SS xmm1 {k1}{z}, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1046560">A</para>
      </td>
     <td><para unique="1046562">V/V</para>
      </td>
     <td><para unique="1046567">AVX512F</para>
      <para unique="1046571">OR AVX10.1<anchor id="+941979"/></para>
      </td>
     <td><para unique="1046573">Computes the approximate reciprocal square root of the scalar single-precision floating-point value in xmm3/m32 and stores the result in the low doubleword element of xmm1 using writemask k1. Bits[127:32] of xmm2 is copied to xmm1[127:32]. </para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1046112">
   <col width="35.15112pt"/>
   <col width="67.5504pt"/>
   <col width="98.55864pt"/>
   <col width="106.10784pt"/>
   <col width="103.94063999999999pt"/>
   <col width="99.1116pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1046114">Op/En</para>
      </th>
     <th valign="middle"><para unique="1046116">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1046118">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1046120">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1046122">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1046124">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1046126">A</para>
      </td>
     <td valign="middle"><para unique="1046128">Tuple1 Scalar</para>
      </td>
     <td valign="middle"><para unique="1046130">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1046132">VEX.vvvv (r)</para>
