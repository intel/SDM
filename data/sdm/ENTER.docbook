 <operand_table><table unique="1261241">
   <col width="48.437999999999995pt"/>
   <col width="110.35008pt"/>
   <col width="116.34048pt"/>
   <col width="116.70624pt"/>
   <col width="120.1356pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261243">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261245">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261247">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261249">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261251">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261253">II</para>
      </td>
     <td valign="middle"><para unique="1261255">iw</para>
      </td>
     <td valign="middle"><para unique="1261257">imm8</para>
      </td>
