    <tr>
     <td colspan="2"><para unique="1046918">EVEX.128.F3.0F38.W0 26 /r</para>
      <para unique="1046919">VPTESTNMB k2 {k1}, xmm2, xmm3/m128</para>
      <para unique="1046920"/>
      </td>
     <td><para unique="1046924">A</para>
      </td>
     <td><para unique="1046926">V/V </para>
      </td>
     <td><para unique="1046928">(AVX512VL AND</para>
      <para unique="1046929">AVX512BW) OR AVX10.1<anchor id="+223194"/></para>
      </td>
     <td><para unique="1046934">Bitwise NAND of packed byte integers in xmm2 and xmm3/m128 and set mask k2 to reflect the zero/non-zero status of each element of the result, under writemask k1.</para>
      </td>
     </tr>
    <tr>
