<instruction name="VCVTNEEBF162PS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Even Elements of Packed BF16 Values to FP32 Values</shortdesc>
 <encoding_table><table unique="1047410">
   <col width="65.23631999999999pt"/>
   <col width="92.81448pt"/>
   <col width="39.900240000000004pt"/>
