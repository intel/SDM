    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1049122">VEX.128.F3.0F38.W0 B0 !(11):rrr:bbb</para>
      <para unique="1049123">VCVTNEEBF162PS xmm1, m128</para>
      </td>
     <td><para unique="1048638">A</para>
      </td>
     <td><para unique="1048640">V/V</para>
      </td>
     <td><para unique="1048642">AVX_NE_&#8232;CONVERT</para>
      </td>
     <td><para unique="1049136">Convert even elements of packed BF16 values from m128 to FP32 values and store in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1049127">VEX.256.F3.0F38.W0 B0 !(11):rrr:bbb</para>
      <para unique="1049128">VCVTNEEBF162PS ymm1, m256</para>
      </td>
     <td><para unique="1048651">A</para>
      </td>
     <td><para unique="1048653">V/V</para>
      </td>
     <td><para unique="1048655">AVX_NE_&#8232;CONVERT</para>
      </td>
     <td><para unique="1049138">Convert even elements of packed BF16 values from m256 to FP32 values and store in ymm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
