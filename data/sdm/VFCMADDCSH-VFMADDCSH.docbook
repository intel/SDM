 <shortdesc>Complex Multiply and Accumulate Scalar FP16 Values</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="29.90016pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="198.14976pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046319">EVEX.LLIG.F2.MAP6.W0 57 /r</para>
      <para unique="1046320">VFCMADDCSH xmm1{k1}{z}, xmm2, xmm3/m32 {er}</para>
      </td>
     <td><para unique="1046322">A</para>
      </td>
     <td><para unique="1046324">V/V</para>
      </td>
     <td><para unique="1046326">AVX512_FP16 </para>
      <para unique="1046330">OR AVX10.1<anchor id="+726394"/></para>
      </td>
     <td><para unique="1046332">Complex multiply a pair of FP16 values from xmm2 and xmm3/m32, add to xmm1 and store the result in xmm1 subject to writemask k1. Bits 127:32 of xmm2 are copied to xmm1[127:32].</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046307">EVEX.LLIG.F3.MAP6.W0 57 /r</para>
      <para unique="1046308">VFMADDCSH xmm1{k1}{z}, xmm2, xmm3/m32 {er}</para>
      </td>
     <td><para unique="1046310">A</para>
      </td>
     <td><para unique="1046312">V/V</para>
      </td>
     <td><para unique="1046314">AVX512_FP16 </para>
      <para unique="1046315">OR AVX10.1<anchor id="+240274"/></para>
      </td>
     <td><para unique="1046317">Complex multiply a pair of FP16 values from xmm2 and the complex conjugate of xmm3/m32, add to xmm1 and store the result in xmm1 subject to writemask k1. Bits 127:32 of xmm2 are copied to xmm1[127:32].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1045921">
   <col width="43.01352pt"/>
