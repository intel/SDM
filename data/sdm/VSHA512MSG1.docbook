<instruction name="VSHA512MSG1">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform an Intermediate Calculation for the Next Four SHA512 Message Qwords</shortdesc>
 <encoding_table><table unique="1047050">
   <col width="62.346959999999996pt"/>
   <col width="88.704pt"/>
   <col width="39.900240000000004pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="190.64952pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1047052">Opcode/</para>
      <para unique="1047053">Instruction</para>
      </th>
     <th><para unique="1047057">Op/</para>
      <para unique="1047058">En</para>
      </th>
     <th><para unique="1047060">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1047062">CPUID Feature Flag</para>
      </th>
     <th><para unique="1047064">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1047066">VEX.256.F2.0F38.W0 CC 11:rrr:bbb</para>
      <para unique="1047067">VSHA512MSG1 ymm1, xmm2</para>
      </td>
     <td><para unique="1047071">A</para>
      </td>
     <td><para unique="1047073">V/V</para>
      </td>
     <td><para unique="1047075">AVX</para>
      <para unique="1047076">SHA512</para>
      </td>
     <td><para unique="1047078">Performs an intermediate calculation for the next four SHA512 message qwords using previous message qwords from ymm1 and xmm2, storing the result in ymm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
