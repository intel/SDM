    <tr>
     <td colspan="2"><para unique="1046901">EVEX.256.66.0F3A.W0 23 /r ib</para>
      <para unique="1046902">VSHUFF32X4 ymm1{k1}{z}, ymm2, ymm3/m256/m32bcst, imm8</para>
      </td>
     <td><para unique="1046906">A</para>
      </td>
     <td><para unique="1046908">V/V</para>
      </td>
     <td><para unique="1046910">(AVX512VL AND</para>
      <para unique="1046914">AVX512F) OR AVX10.1<anchor id="+668257"/></para>
      </td>
     <td><para unique="1046919">Shuffle 128-bit packed single-precision floating-point values selected by imm8 from ymm2 and ymm3/m256/m32bcst and place results in ymm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046884">EVEX.512.66.0F3A.W0 23 /r ib</para>
      <para unique="1046885">VSHUFF32x4 zmm1{k1}{z}, zmm2, zmm3/m512/m32bcst, imm8</para>
      </td>
     <td><para unique="1046889">A</para>
      </td>
     <td><para unique="1046891">V/V</para>
      </td>
     <td><para unique="1046896">AVX512F </para>
      <para unique="1046897">OR AVX10.1<anchor id="+772514"/></para>
      </td>
     <td><para unique="1046899">Shuffle 128-bit packed single-precision floating-point values selected by imm8 from zmm2 and zmm3/m512/m32bcst and place results in zmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046867">EVEX.256.66.0F3A.W1 23 /r ib</para>
