   <tbody>
    <tr>
     <td colspan="2"><para unique="1046096">VEX.256.66.0F3A.W0 06 /r ib</para>
      <para unique="1046097">VPERM2F128 ymm1, ymm2, ymm3/m256, imm8</para>
      </td>
     <td><para unique="1046101">RVMI</para>
      </td>
