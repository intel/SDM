     <td><para unique="1046549">EVEX.128.NP.MAP5.W0 59 /r</para>
      <para unique="1046550">VMULPH xmm1{k1}{z}, xmm2, xmm3/m128/m16bcst</para>
      </td>
     <td><para unique="1046552">A</para>
      </td>
     <td><para unique="1046554">V/V</para>
      </td>
     <td><para unique="1046556">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+273492"/></para>
      </td>
     <td><para unique="1046561">Multiply packed FP16 values from xmm3/m128/m16bcst to xmm2 and store the result in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046538">EVEX.256.NP.MAP5.W0 59 /r</para>
      <para unique="1046539">VMULPH ymm1{k1}{z}, ymm2, ymm3/m256/m16bcst</para>
      </td>
     <td><para unique="1046541">A</para>
      </td>
     <td><para unique="1046543">V/V</para>
      </td>
     <td><para unique="1046545">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+180918"/></para>
      </td>
     <td><para unique="1046547">Multiply packed FP16 values from ymm3/m256/m16bcst to ymm2 and store the result in ymm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046526">EVEX.512.NP.MAP5.W0 59 /r</para>
      <para unique="1046527">VMULPH zmm1{k1}{z}, zmm2, zmm3/m512/m16bcst {er}</para>
      </td>
     <td><para unique="1046529">A</para>
      </td>
     <td><para unique="1046531">V/V</para>
      </td>
     <td><para unique="1046533">AVX512_FP16</para>
      <para unique="1046534">OR AVX10.1<anchor id="+581717"/></para>
      </td>
     <td><para unique="1046536">Multiply packed FP16 values in zmm3/m512/m16bcst with zmm2 and store the result in zmm1 subject to writemask k1.</para>
      </td>
     </tr>
