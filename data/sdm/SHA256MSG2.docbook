   <caption unique="1091433">Instruction Operand Encoding</caption>
   </table>
  </operand_table>
 <longdesc><para unique="1091435">The SHA256MSG2 instruction is one of two SHA2 message scheduling instructions. The instruction performs the final calculation for the next four SHA256 message dwords.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1091437">SHA256MSG2 </title>
   <programlisting>W14 := SRC2[95:64] ;
W15 := SRC2[127:96] ;
W16 := SRC1[31: 0] + &#963;1( W14) ;
W17 := SRC1[63: 32] + &#963;1( W15) ;
W18 := SRC1[95: 64] + &#963;1( W16) ;
W19 := SRC1[127: 96] + &#963;1( W17) ;
DEST[127:96] := W19 ;
DEST[95:64] := W18 ;
DEST[63:32] := W17 ;
DEST[31:0] := W16;</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>SHA256MSG2 __m128i _mm_sha256msg2_epu32(__m128i, __m128i);</programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1091452">None.</para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1091454">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1091459">See <link unique="1091457" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions" xrefstyle="Table All - no page-period">Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
