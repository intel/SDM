<instruction name="SHA256MSG2">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform a Final Calculation for the Next Four SHA256 Message Dwords</shortdesc>
 <encoding_table><table unique="1091389">
   <col width="50.66568pt"/>
   <col width="72.08424pt"/>
   <col width="37.49976pt"/>
   <col width="48.74976pt"/>
   <col width="44.24976pt"/>
   <col width="258.70104pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1091391">Opcode/&#8232;Instruction</para>
      </th>
     <th><para unique="1091395">Op/En</para>
      </th>
     <th><para unique="1091397">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1091399">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091401">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091403">NP 0F 38 CD /r </para>
      <para unique="1091404">SHA256MSG2 xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1091408">RM</para>
      </td>
     <td><para unique="1091410">V/V</para>
      </td>
     <td><para unique="1091412">SHA</para>
      </td>
     <td><para unique="1091414">Performs the final calculation for the next four SHA256 message dwords using previous message dwords from xmm1 and xmm2/m128, storing the result in xmm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091416">
   <col width="65.89224pt"/>
   <col width="147.14352pt"/>
   <col width="151.79327999999998pt"/>
   <col width="147.88656pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091418">Op/En</para>
      </th>
