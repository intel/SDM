   <col width="47.81376pt"/>
   <col width="46.54728pt"/>
   <col width="181.44072pt"/>
   <tbody>
    <tr>
     <td><para unique="1261206">0F C8+<italic>rd</italic></para>
      </td>
     <td><para unique="1261208">BSWAP <italic>r32</italic></para>
      </td>
     <td><para unique="1261210">O</para>
      </td>
     <td><para unique="1261212">Valid*</para>
      </td>
     <td><para unique="1261214">Valid</para>
      </td>
     <td><para unique="1261216">Reverses the byte order of a 32-bit register.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261218">REX.W + 0F C8+<italic>rd</italic></para>
      </td>
     <td><para unique="1261220">BSWAP <italic>r64</italic></para>
      </td>
     <td><para unique="1261222">O</para>
      </td>
     <td><para unique="1261224">Valid</para>
      </td>
     <td><para unique="1261226">N.E.</para>
      </td>
     <td><para unique="1261228">Reverses the byte order of a 64-bit register.</para>
      </td>
     </tr>
    <tr>
     <td colspan="6"><para unique="1261230">NOTES:</para>
      <para unique="1261231">*	See IA-32 Architecture Compatibility section below.</para>
