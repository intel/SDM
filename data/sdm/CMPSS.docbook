      </td>
     <td><para unique="1261346">CMPSS xmm1, xmm2, 1</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261348">CMPLESS xmm1, xmm2</para>
      </td>
     <td><para unique="1261350">CMPSS xmm1, xmm2, 2</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261352">CMPUNORDSS xmm1, xmm2</para>
      </td>
     <td><para unique="1261354">CMPSS xmm1, xmm2, 3</para>
      </td>
     </tr>
