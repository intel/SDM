<instruction name="CMPSS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Compare Scalar Single Precision Floating-Point Value</shortdesc>
 <encoding_table><table unique="1261191">
   <col width="78.69816pt"/>
   <col width="78.69816pt"/>
   <col width="33.59376pt"/>
