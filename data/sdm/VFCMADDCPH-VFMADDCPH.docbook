    <tr>
     <td><para unique="1046458">EVEX.128.F2.MAP6.W0 56 /r</para>
      <para unique="1046459">VFCMADDCPH xmm1{k1}{z}, xmm2, xmm3/m128/m32bcst</para>
      </td>
     <td><para unique="1046461">A</para>
      </td>
     <td><para unique="1046463">V/V</para>
      </td>
     <td><para unique="1046465">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+376510"/></para>
      </td>
     <td><para unique="1046470">Complex multiply a pair of FP16 values from xmm2 and xmm3/m128/m32bcst, add to xmm1 and store the result in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046447">EVEX.256.F2.MAP6.W0 56 /r</para>
      <para unique="1046448">VFCMADDCPH ymm1{k1}{z}, ymm2, ymm3/m256/m32bcst</para>
      </td>
     <td><para unique="1046450">A</para>
      </td>
     <td><para unique="1046452">V/V</para>
      </td>
     <td><para unique="1046454">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+991019"/></para>
      </td>
     <td><para unique="1046456">Complex multiply a pair of FP16 values from ymm2 and ymm3/m256/m32bcst, add to ymm1 and store the result in ymm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046435">EVEX.512.F2.MAP6.W0 56 /r</para>
      <para unique="1046436">VFCMADDCPH zmm1{k1}{z}, zmm2, zmm3/m512/m32bcst {er}</para>
