 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046088">
   <string>Invalid, Underflow, Overflow, Precision, Denormal.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046093" format="xIndent1">
   <string>EVEX-encoded instructions, see </string><link linkend="79250: 06_Table: Table 2-49. Type E4 Class Exception Conditions"><string>Table&#160;2&#8209;51, &#8220;Type E4 Class Exception Conditions.&#8221;</string></link></para>
  <para unique="1046094" format="xIndent1">
   <string>Additionally:</string></para>
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>	If (dest_reg == src1_reg) or (dest_reg == src2_reg).</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
