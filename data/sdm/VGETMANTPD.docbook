  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046189">Denormal, Invalid.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046194" format="xIndent1">See <link unique="1046192" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#35185: 06_Table: Table 2-46. Type E2 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;48, &#8220;Type E2 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046195" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1046196">If EVEX.vvvv != 1111B.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
