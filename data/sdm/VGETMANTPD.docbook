 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046189">
   <string>Denormal, Invalid.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046194" format="xIndent1">
   <string>See </string><link linkend="35185: 06_Table: Table 2-46. Type E2 Class Exception Conditions"><string>Table&#160;2&#8209;48, &#8220;Type E2 Class Exception Conditions.&#8221;</string></link></para>
  <para unique="1046195" format="xIndent1">
   <string>Additionally:</string></para>
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If EVEX.vvvv != 1111B.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
