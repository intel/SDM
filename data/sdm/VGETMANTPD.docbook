   <tbody>
    <tr>
     <td colspan="2"><para unique="1046573">EVEX.128.66.0F3A.W1 26 /r ib</para>
      <para unique="1046574">VGETMANTPD xmm1 {k1}{z}, xmm2/m128/m64bcst, imm8</para>
      </td>
     <td><para unique="1046578">A</para>
      </td>
     <td><para unique="1046580">V/V</para>
      </td>
     <td><para unique="1046582">(AVX512VL AND AVX512F) OR AVX10.1<anchor id="+720525"/></para>
      </td>
     <td><para unique="1046590">Get Normalized Mantissa from float64 vector xmm2/m128/m64bcst and store the result in xmm1, using imm8 for sign control and mantissa interval normalization, under writemask.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046557">EVEX.256.66.0F3A.W1 26 /r ib</para>
      <para unique="1046558">VGETMANTPD ymm1 {k1}{z}, ymm2/m256/m64bcst, imm8</para>
      </td>
     <td><para unique="1046562">A</para>
      </td>
     <td><para unique="1046564">V/V</para>
      </td>
     <td><para unique="1046566">(AVX512VL AND AVX512F) OR AVX10.1<anchor id="+395519"/></para>
      </td>
     <td><para unique="1046571">Get Normalized Mantissa from float64 vector ymm2/m256/m64bcst and store the result in ymm1, using imm8 for sign control and mantissa interval normalization, under writemask.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046540">EVEX.512.66.0F3A.W1 26 /r ib</para>
      <para unique="1046541">VGETMANTPD zmm1 {k1}{z}, zmm2/m512/m64bcst{sae}, imm8</para>
      </td>
     <td><para unique="1046545">A</para>
      </td>
     <td><para unique="1046547">V/V</para>
      </td>
     <td><para unique="1046552">AVX512F </para>
      <para unique="1046553">OR AVX10.1<anchor id="+879441"/></para>
      </td>
     <td><para unique="1046555">Get Normalized Mantissa from float64 vector zmm2/m512/m64bcst and store the result in zmm1, using imm8 for sign control and mantissa interval normalization, under writemask.</para>
      </td>
     </tr>
