<instruction name="VGETMANTPD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Extract Float64 Vector of Normalized Mantissas From Float64 Vector</shortdesc>
 <encoding_table><table unique="1045885">
   <thead><tr>
     <th colspan="2"><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
