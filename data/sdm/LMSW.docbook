<instruction name="LMSW">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Load Machine Status Word</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th><para unique="1261193">Opcode</para>
      </th>
     <th><para unique="1261195">Instruction</para>
      </th>
     <th><para unique="1261197">Op/ En</para>
      </th>
     <th><para unique="1261199">64-Bit Mode</para>
      </th>
     <th><para unique="1261201">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261203">Description</para>
      </th>
     </tr>
    </thead><col width="97.20576pt"/>
   <col width="110.26872pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.90448pt"/>
   <tbody>
    <tr>
     <td><para unique="1261205">0F 01 /6</para>
      </td>
     <td><para unique="1261207">lmsw r/m16</para>
      </td>
     <td><para unique="1261209">M</para>
      </td>
     <td><para unique="1261211">Valid</para>
      </td>
     <td><para unique="1261213">Valid</para>
      </td>
     <td><para unique="1261215">Loads r/m16 in machine status word of CR0.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261217">
   <col width="50.5404pt"/>
   <col width="111.55896000000001pt"/>
   <col width="117.61488pt"/>
   <col width="112.48344pt"/>
   <col width="117.52199999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261219">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261221">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261223">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261225">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261227">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261229">M</para>
      </td>
     <td valign="middle"><para unique="1261231">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261233">N/A</para>
      </td>
     <td valign="middle"><para unique="1261235">N/A</para>
      </td>
