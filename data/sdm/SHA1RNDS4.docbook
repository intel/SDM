<instruction name="SHA1RNDS4">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform Four Rounds of SHA1 Operation</shortdesc>
 <encoding_table><table unique="1091389">
   <col width="50.66568pt"/>
   <col width="72.08424pt"/>
   <col width="37.49976pt"/>
   <col width="48.74976pt"/>
   <col width="44.24976pt"/>
   <col width="259.7508pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1091391">Opcode/&#8232;Instruction</para>
      </th>
     <th><para unique="1091395">Op/En</para>
      </th>
     <th><para unique="1091397">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1091399">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091401">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091403">NP 0F 3A CC /r ib</para>
      <para unique="1091404">SHA1RNDS4 xmm1, xmm2/m128, imm8</para>
      </td>
     <td><para unique="1091408">RMI</para>
      </td>
     <td><para unique="1091410">V/V</para>
      </td>
     <td><para unique="1091412">SHA</para>
      </td>
     <td><para unique="1091414">Performs four rounds of SHA1 operation operating on SHA1 state (A,B,C,D) from xmm1, with a pre-computed sum of the next 4 round message dwords and state variable E from xmm2/m128. The immediate byte controls logic functions and round constants.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091416">
   <col width="66.492pt"/>
   <col width="150.93431999999999pt"/>
   <col width="148.90895999999998pt"/>
   <col width="144.5796pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091418">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091420">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091422">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091424">Operand 3</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091426">RMI</para>
      </td>
     <td valign="middle"><para unique="1091428">ModRM:reg (r, w)</para>
      </td>
     <td valign="middle"><para unique="1091430">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1091432">imm8</para>
      </td>
