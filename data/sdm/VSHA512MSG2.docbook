<instruction name="VSHA512MSG2">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform a Final Calculation for the Next Four SHA512 Message Qwords</shortdesc>
 <encoding_table><table unique="1047452">
   <col width="62.346959999999996pt"/>
   <col width="88.704pt"/>
   <col width="39.900240000000004pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="190.64952pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1047454">Opcode/</para>
      <para unique="1047455">Instruction</para>
      </th>
     <th><para unique="1047459">Op/</para>
      <para unique="1047460">En</para>
      </th>
     <th><para unique="1047462">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1047464">CPUID Feature Flag</para>
      </th>
     <th><para unique="1047466">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1047468">VEX.256.F2.0F38.W0 CD 11:rrr:bbb</para>
      <para unique="1047469">VSHA512MSG2 ymm1, ymm2</para>
      </td>
     <td><para unique="1047473">A</para>
      </td>
     <td><para unique="1047475">V/V</para>
      </td>
     <td><para unique="1047477">AVX</para>
      <para unique="1047478">SHA512</para>
      </td>
     <td><para unique="1047480">Performs the final calculation for the next four SHA512 message qwords using previous message qwords from ymm1 and ymm2, storing the result in ymm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1047482">
   <col width="37.113839999999996pt"/>
   <col width="53.113679999999995pt"/>
