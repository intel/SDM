    <tr>
     <td><para unique="1046825">EVEX.128.66.MAP6.W0 9A /r</para>
      <para unique="1046826">VFMSUB132PH xmm1{k1}{z}, xmm2, xmm3/m128/m16bcst</para>
      </td>
     <td><para unique="1046828">A</para>
      </td>
     <td><para unique="1046830">V/V</para>
      </td>
     <td><para unique="1046832">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+548429"/></para>
      </td>
     <td><para unique="1046837">Multiply packed FP16 values from xmm1 and xmm3/m128/m16bcst, subtract xmm2, and store the result in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046814">EVEX.256.66.MAP6.W0 9A /r</para>
