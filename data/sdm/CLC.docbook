<instruction name="CLC">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Clear Carry Flag</shortdesc>
 <longdesc><para unique="1261240">
   <string>Clears the CF flag in the EFLAGS register. Operation is the same in all modes.</string></para>
  </longdesc>
 <subsection title="Flags Affected">
  <para unique="1261244">
   <string>The CF flag is set to 0. The OF, ZF, SF, AF, and PF flags are unaffected.</string></para>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
