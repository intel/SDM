 <longdesc><para unique="1261240">Clears the CF flag in the EFLAGS register. Operation is the same in all modes.</para>
  </longdesc>
 <operation>
  <programlisting>CF := 0;</programlisting>
  </operation>
 <subsection title="Flags Affected">
  <para unique="1261244">The CF flag is set to 0. The OF, ZF, SF, AF, and PF flags are unaffected.</para>
  </subsection>
 <subsection title="Exceptions (All Operating Modes)">
  <variablelist>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261246">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
