  <para unique="1046269">VPLZCNTD __m256i _mm256_maskz_lzcnt_epi32( __mmask8 m, __m256i a);</para>
  <para unique="1046270">VPLZCNTQ __m256i _mm256_lzcnt_epi64(__m256i a);</para>
