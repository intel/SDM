<instruction name="CVTPS2PI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Packed Single Precision Floating-Point Values to Packed Dword Integers</shortdesc>
 <encoding_table><table unique="1261192">
   <thead><tr>
     <th colspan="2"><para unique="1261194">Opcode/</para>
      <para unique="1261195">Instruction</para>
      </th>
     <th><para unique="1261199">Op/ En</para>
      </th>
     <th><para unique="1261201">64-Bit Mode</para>
      </th>
     <th><para unique="1261203">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261205">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261207">NP 0F 2D /r</para>
      <para unique="1261208">CVTPS2PI mm, xmm/m64</para>
      </td>
     <td><para unique="1261212">RM</para>
      </td>
     <td><para unique="1261214">Valid</para>
      </td>
     <td><para unique="1261216">Valid</para>
      </td>
     <td><para unique="1261218">Convert two packed single precision floating-point values from xmm/m64 to two packed signed doubleword integers in mm.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261220">
   <col width="44.418240000000004pt"/>
   <col width="116.40528pt"/>
   <col width="120.18456pt"/>
   <col width="117.34992000000001pt"/>
   <col width="112.86216pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261222">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261224">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261226">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261228">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261230">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1261232">RM</para>
      </td>
     <td valign="middle"><para unique="1261234">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261236">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261238">N/A</para>
