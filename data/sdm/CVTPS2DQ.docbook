    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261207">66 0F 5B /r</para>
      <para unique="1261208">CVTPS2DQ xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261212">A</para>
      </td>
     <td><para unique="1261214">V/V</para>
      </td>
     <td><para unique="1261216">SSE2</para>
      </td>
     <td><para unique="1261218">Convert four packed single precision floating-point values from xmm2/mem to four packed signed doubleword values in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261220">VEX.128.66.0F.WIG 5B /r</para>
      <para unique="1261221">VCVTPS2DQ xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261225">A</para>
      </td>
     <td><para unique="1261227">V/V</para>
      </td>
     <td><para unique="1261232">AVX</para>
      </td>
     <td><para unique="1261234">Convert four packed single precision floating-point values from xmm2/mem to four packed signed doubleword values in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261236">VEX.256.66.0F.WIG 5B /r</para>
      <para unique="1261237">VCVTPS2DQ ymm1, ymm2/m256</para>
      </td>
     <td><para unique="1261241">A</para>
      </td>
     <td><para unique="1261243">V/V</para>
      </td>
     <td><para unique="1261248">AVX</para>
      </td>
     <td><para unique="1261250">Convert eight packed single precision floating-point values from ymm2/mem to eight packed signed doubleword values in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261826">EVEX.128.66.0F.W0 5B /r</para>
      <para unique="1261827">VCVTPS2DQ xmm1 {k1}{z}, xmm2/m128/m32bcst</para>
      </td>
