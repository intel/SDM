 <shortdesc>Insert Scalar Single Precision Floating-Point Value</shortdesc>
 <encoding_table><table unique="1261191">
   <col width="77.74848pt"/>
   <col width="77.74848pt"/>
   <col width="37.82736pt"/>
   <col width="48.74976pt"/>
   <col width="57.58272pt"/>
   <col width="212.0832pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op / En</para>
      </th>
     <th><para unique="1261200">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 3A 21 /r ib</para>
      <para unique="1261207">INSERTPS xmm1, xmm2/m32, imm8</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE4_1</para>
      </td>
     <td><para unique="1261217">Insert a single precision floating-point value selected by imm8 from xmm2/m32 into xmm1 at the specified destination element specified by imm8 and zero out destination elements in xmm1 as indicated in imm8.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.66.0F3A.WIG 21 /r ib</para>
      <para unique="1261220">VINSERTPS xmm1, xmm2, xmm3/m32, imm8</para>
      </td>
     <td><para unique="1261224">B</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261231">AVX</para>
      </td>
     <td><para unique="1261233">Insert a single precision floating-point value selected by imm8 from xmm3/m32 and merge with values in xmm2 at the specified destination element specified by imm8 and write out the result and zero out destination elements in xmm1 as indicated in imm8.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261738">EVEX.128.66.0F3A.W0 21 /r ib</para>
      <para unique="1261739">VINSERTPS xmm1, xmm2, xmm3/m32, imm8</para>
      </td>
     <td><para unique="1261743">C</para>
      </td>
     <td><para unique="1261745">V/V</para>
      </td>
     <td><para unique="1261750">AVX512F</para>
      <para unique="1261754">OR AVX10.1<anchor id="+102254"/></para>
      </td>
     <td><para unique="1261756">Insert a single precision floating-point value selected by imm8 from xmm3/m32 and merge with values in xmm2 at the specified destination element specified by imm8 and write out the result and zero out destination elements in xmm1 as indicated in imm8.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
