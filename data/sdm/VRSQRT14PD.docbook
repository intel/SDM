 <shortdesc>Compute Approximate Reciprocals of Square Roots of Packed Float64 Values</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="71.33184pt"/>
   <col width="71.33184pt"/>
   <col width="29.244239999999998pt"/>
