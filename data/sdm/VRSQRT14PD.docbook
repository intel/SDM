   <col width="213.50016pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046088">Op / En</para>
      </th>
     <th><para unique="1046090">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046092">CPUID Feature Flag</para>
