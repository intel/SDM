    <tr>
     <td colspan="2"><para unique="1046582">EVEX.512.66.0F38.W0 50 /r</para>
      <para unique="1046583">VPDPBUSD zmm1{k1}{z}, zmm2, zmm3/m512/m32bcst</para>
