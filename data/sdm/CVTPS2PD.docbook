     <td><para unique="1261240">A</para>
      </td>
     <td><para unique="1261242">V/V</para>
      </td>
     <td><para unique="1261247">AVX</para>
      </td>
     <td><para unique="1261249">Convert four packed single precision floating-point values in xmm2/m128 to four packed double precision floating-point values in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261846">EVEX.128.0F.W0 5A /r</para>
      <para unique="1261847">VCVTPS2PD xmm1 {k1}{z}, xmm2/m64/m32bcst </para>
