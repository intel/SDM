    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">NP 0F 5A /r</para>
      <para unique="1261207">CVTPS2PD xmm1, xmm2/m64</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE2</para>
      </td>
     <td><para unique="1261217">Convert two packed single precision floating-point values in xmm2/m64 to two packed double precision floating-point values in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.0F.WIG 5A /r</para>
      <para unique="1261220">VCVTPS2PD xmm1, xmm2/m64</para>
      </td>
     <td><para unique="1261224">A</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261231">AVX</para>
      </td>
     <td><para unique="1261233">Convert two packed single precision floating-point values in xmm2/m64 to two packed double precision floating-point values in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261235">VEX.256.0F.WIG 5A /r</para>
      <para unique="1261236">VCVTPS2PD ymm1, xmm2/m128</para>
