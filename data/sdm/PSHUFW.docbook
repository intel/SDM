<instruction name="PSHUFW">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Shuffle Packed Words</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th colspan="2"><para unique="1091392">Opcode/</para>
      <para unique="1091393">Instruction</para>
      </th>
     <th><para unique="1091397">Op/ En</para>
      </th>
     <th><para unique="1091399">64-Bit Mode</para>
      </th>
     <th><para unique="1091401">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091403">Description</para>
      </th>
     </tr>
    </thead><col width="97.90848pt"/>
   <col width="111.06576000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.90448pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091405">NP 0F 70 /r ib</para>
      <para unique="1091406">PSHUFW mm1, mm2/m64, imm8</para>
      </td>
     <td><para unique="1091410">RMI</para>
      </td>
     <td><para unique="1091412">Valid </para>
      </td>
     <td><para unique="1091414">Valid</para>
      </td>
     <td><para unique="1091416">Shuffle the words in mm2/m64 based on the encoding in imm8 and store the result in mm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091418">
   <col width="44.215199999999996pt"/>
   <col width="115.0704pt"/>
   <col width="119.6316pt"/>
   <col width="112.81392pt"/>
   <col width="118.73808pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091420">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091422">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091424">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091426">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091428">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091430">RMI</para>
      </td>
     <td valign="middle"><para unique="1091432">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091434">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1091436">imm8</para>
