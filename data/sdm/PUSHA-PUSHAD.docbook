 <operand_table><table unique="1091428">
   <col width="47.516400000000004pt"/>
   <col width="116.21592pt"/>
   <col width="115.98840000000001pt"/>
   <col width="117.12744pt"/>
   <col width="115.12152pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091430">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091432">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091434">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091436">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091438">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091440">ZO</para>
      </td>
