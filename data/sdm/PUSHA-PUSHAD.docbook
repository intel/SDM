      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="97.55712pt"/>
   <col width="110.66760000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.90448pt"/>
   <tbody>
    <tr>
     <td><para unique="1091404">60</para>
      </td>
     <td><para unique="1091406">PUSHA</para>
      </td>
