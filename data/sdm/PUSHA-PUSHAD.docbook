      </td>
     <td><para unique="1091410">Invalid</para>
      </td>
     <td><para unique="1091412">Valid</para>
      </td>
     <td><para unique="1091414">Push AX, CX, DX, BX, original SP, BP, SI, and DI.</para>
      </td>
