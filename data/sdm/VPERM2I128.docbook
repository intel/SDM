     <td colspan="2"><para unique="1046096">VEX.256.66.0F3A.W0 46 /r ib</para>
      <para unique="1046097">VPERM2I128 ymm1, ymm2, ymm3/m256, imm8</para>
      </td>
     <td><para unique="1046101">RVMI</para>
      </td>
     <td><para unique="1046103">V/V</para>
      </td>
     <td><para unique="1046108">AVX2</para>
      </td>
     <td><para unique="1046110">Permute 128-bit integer data in ymm2 and ymm3/mem using controls from imm8 and store result in ymm1.</para>
      </td>
