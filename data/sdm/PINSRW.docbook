   <tbody>
    <tr>
     <td colspan="2"><para unique="1091405">NP 0F C4 /<italic>r</italic> ib<footnote><para unique="1092220" format="TableFootnote">See note in <link unique="1092234" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#27214: 02_Level: 2.4 Instruction Exception Specification" xrefstyle="SectionNum&amp;Title(,)">Section 2.5, &#8220;Intel&#174; AVX and Intel&#174; SSE Instruction Exception Classification,&#8221;</link> in the Intel&#174; 64 and IA&#8209;32 Architectures Soft&#173;ware Developer&#8217;s Manual, Volume 2A, and <link unique="1092534" linkend="&lt;c&gt;__sdm_vol3B_ch25.fm#65163: 03_Level: 19.25.3 Exception Conditions of Legacy SIMD Instruction Operating" xrefstyle="SectionNum&amp;Title(,)">Section 25.25.3, &#8220;Exception Conditions of Legacy SIMD Instructions Operating on MMX Registers,&#8221;</link> in the Intel&#174; 64 and IA&#8209;32 Architectures Software Developer&#8217;s Manual, Volume 3B.</para>
        </footnote></para>
      <para unique="1091406">PINSRW mm, r32/m16, imm8</para>
      </td>
     <td><para unique="1091410">A</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE</para>
      </td>
     <td><para unique="1091416">Insert the low word from r32 or from m16 into mm at the word position specified by imm8.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">66 0F C4 /<italic>r</italic> ib</para>
      <para unique="1091419">PINSRW xmm, r32/m16, imm8</para>
      </td>
     <td><para unique="1091423">A</para>
      </td>
     <td><para unique="1091425">V/V</para>
      </td>
     <td><para unique="1091427">SSE2</para>
      </td>
     <td><para unique="1091429">Move the low word of r32 or from m16 into xmm at the word position specified by imm8.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091431">VEX.128.66.0F.W0 C4 /r ib</para>
      <para unique="1091432">VPINSRW xmm1, xmm2, r32/m16, imm8</para>
      </td>
     <td><para unique="1091436">B</para>
      </td>
     <td><para unique="1091438">V<superscript><footnote><para unique="1092252" format="TableFootnote">In 64-bit mode, VEX.W1 is ignored for VPINSRW (similar to legacy REX.W=1 prefix in PINSRW).</para>
         </footnote></superscript>/V</para>
      </td>
     <td><para unique="1091440">AVX</para>
      </td>
     <td><para unique="1091442">Insert the word from r32/m16 at the offset indicated by imm8 into the value from xmm2 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091992">EVEX.128.66.0F.WIG C4 /r ib</para>
      <para unique="1091993">VPINSRW xmm1, xmm2, r32/m16, imm8</para>
      </td>
     <td><para unique="1091997">C</para>
      </td>
     <td><para unique="1091999">V/V</para>
      </td>
     <td><para unique="1092001">AVX512BW OR AVX10.1<anchor id="+607046"/></para>
      </td>
     <td><para unique="1092003">Insert the word from r32/m16 at the offset indicated by imm8 into the value from xmm2 and store result in xmm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
