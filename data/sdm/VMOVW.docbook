     <td><para unique="1046507">Copy word from reg/m16 to xmm1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046482">EVEX.128.66.MAP5.WIG 7E /r</para>
      <para unique="1046483">VMOVW reg/m16, xmm1</para>
