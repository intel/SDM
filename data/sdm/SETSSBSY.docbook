      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091407">F3 0F 01 E8</para>
      <para unique="1091408">SETSSBSY</para>
      </td>
     <td><para unique="1091412">ZO</para>
      </td>
     <td><para unique="1091414">V/V</para>
      </td>
     <td><para unique="1091416">CET_SS</para>
      </td>
     <td><para unique="1091418">Set busy flag in supervisor shadow stack token reference by IA32_PL0_SSP.</para>
      </td>
     </tr>
    </tbody>
