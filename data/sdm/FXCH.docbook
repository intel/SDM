<instruction name="FXCH">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Exchange Register Contents</shortdesc>
 <encoding_table><table unique="1261193">
   <thead><tr>
     <th><para unique="1261195">Opcode</para>
      </th>
     <th><para unique="1261197">Instruction</para>
      </th>
     <th><para unique="1261199">64-Bit Mode</para>
      </th>
     <th><para unique="1261201">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261203">Description</para>
      </th>
     </tr>
    </thead><col width="91.63368000000001pt"/>
   <col width="89.22240000000001pt"/>
   <col width="51.782399999999996pt"/>
   <col width="66.09960000000001pt"/>
   <col width="213.59592pt"/>
   <tbody>
    <tr>
     <td><para unique="1261205">D9 C8+i</para>
      </td>
     <td><para unique="1261207">FXCH ST(i)</para>
      </td>
     <td><para unique="1261209">Valid</para>
      </td>
     <td><para unique="1261211">Valid</para>
      </td>
     <td><para unique="1261213">Exchange the contents of ST(0) and ST(i).</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261215">D9 C9</para>
      </td>
     <td><para unique="1261217">FXCH</para>
      </td>
     <td><para unique="1261219">Valid</para>
      </td>
     <td><para unique="1261221">Valid</para>
      </td>
     <td><para unique="1261223">Exchange the contents of ST(0) and ST(1).</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <longdesc><para unique="1261226">Exchanges the contents of registers ST(0) and ST(i). If no source operand is specified, the contents of ST(0) and ST(1) are exchanged.</para>
  <para unique="1261227">This instruction provides a simple means of moving values in the FPU register stack to the top of the stack [ST(0)], so that they can be operated on by those floating-point instructions that can only operate on values in ST(0). For example, the following instruction sequence takes the square root of the third register from the top of the register stack:</para>
  <programlisting>FXCH ST(3);
	FSQRT;
	FXCH ST(3);
This instruction&#8217;s operation is the same in non-64-bit modes and 64-bit mode.</programlisting>
  </longdesc>
 <operation>
  <programlisting>IF (Number-of-operands) is 1
	THEN
		temp := ST(0);
		ST(0) := SRC;
		SRC := temp;
	ELSE
		temp := ST(0);
		ST(0) := ST(1);
		ST(1) := temp;
FI;</programlisting>
  </operation>
 <subsection title="FPU Flags Affected">
  <variablelist>
   <variablelistentry>
    <term>C1</term>
    <listitem><para unique="1261244">Set to 0.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>C0, C2, C3 </term>
    <listitem><para unique="1261245">Undefined.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Floating-Point Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#IS</term>
    <listitem><para unique="1261247">Stack underflow occurred.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term>#NM</term>
    <listitem><para unique="1261249">CR0.EM[bit 2] or CR0.TS[bit 3] = 1.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#MF </term>
    <listitem><para unique="1261250">If there is a pending x87 FPU exception.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD </term>
    <listitem><para unique="1261251">If the LOCK prefix is used.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <para unique="1261253" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <para unique="1261255" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261257" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261259" format="xIndent1">Same exceptions as in protected mode.</para>
  </subsection>
 </instruction>
