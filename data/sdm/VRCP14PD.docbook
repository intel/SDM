    <tr>
     <td><para unique="1046211" format="CellBodyL">
       <string>X &lt; -2</string><superscript><string>1022</string></superscript></para>
      </td>
     <td><para unique="1046213" format="CellBodyL">
       <string>-Underflow</string></para>
      </td>
     <td><para unique="1046215" format="CellBodyL">
       <string>Up to 18 bits of fractions are returned*</string></para>
      </td>
     </tr>
    <tr>
