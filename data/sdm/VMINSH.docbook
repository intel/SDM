    </thead><tbody>
    <tr>
     <td><para unique="1046488">EVEX.LLIG.F3.MAP5.W0 5D /r</para>
      <para unique="1046489">VMINSH xmm1{k1}{z}, xmm2, xmm3/m16 {sae}</para>
      </td>
     <td><para unique="1046491">A</para>
      </td>
     <td><para unique="1046493">V/V</para>
      </td>
     <td><para unique="1046495">AVX512_FP16 </para>
      <para unique="1046499">OR AVX10.1<anchor id="+142660"/></para>
      </td>
     <td><para unique="1046501">Return the minimum low FP16 value between xmm3/m16 and xmm2. Stores the result in xmm1 subject to writemask k1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
