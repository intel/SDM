 <shortdesc>Return Minimum Scalar FP16 Value</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="153.5976pt"/>
   <col width="30.52512pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="198.14976pt"/>
   <thead><tr>
     <th><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046086">Op/</para>
      <para unique="1046087">En</para>
      </th>
     <th><para unique="1046089">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046091">CPUID Feature Flag</para>
      </th>
