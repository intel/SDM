 <shortdesc>Packed Interleave Shuffle of Pairs of Double Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1091390">
   <col width="74.37312pt"/>
   <col width="74.37312pt"/>
   <col width="34.49376pt"/>
   <col width="48.74976pt"/>
