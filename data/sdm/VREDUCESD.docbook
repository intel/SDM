<instruction name="VREDUCESD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform a Reduction Transformation on a Scalar Float64 Value</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="52.52328pt"/>
   <col width="74.72664pt"/>
   <col width="30.749760000000002pt"/>
   <col width="50.99976pt"/>
   <col width="71.24976pt"/>
   <col width="230.00112pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046088">Op / En</para>
      </th>
     <th><para unique="1046090">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046092">CPUID Feature Flag</para>
      </th>
     <th><para unique="1046094">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046536">EVEX.LLIG.66.0F3A.W1 57</para>
      <para unique="1046537">VREDUCESD xmm1 {k1}{z}, xmm2, xmm3/m64{sae}, imm8/r </para>
      </td>
     <td><para unique="1046541">A</para>
      </td>
     <td><para unique="1046543">V/V</para>
      </td>
     <td><para unique="1046545">AVX512DQ</para>
      <para unique="1046549">OR AVX10.1<anchor id="+102753"/></para>
      </td>
     <td><para unique="1046551">Perform a reduction transformation on a scalar double precision floating-point value in xmm3/m64 by subtracting a number of fraction bits specified by the imm8 field. Also, upper double precision floating-point value (bits[127:64]) from xmm2 are copied to xmm1[127:64]. Stores the result in xmm1 register.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1046109">
   <col width="39.83472pt"/>
   <col width="83.034pt"/>
   <col width="95.45472000000001pt"/>
   <col width="103.71168pt"/>
   <col width="96.52392pt"/>
   <col width="92.29535999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1046111">Op/En</para>
      </th>
     <th valign="middle"><para unique="1046113">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1046115">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1046117">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1046119">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1046121">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1046123">A</para>
      </td>
     <td valign="middle"><para unique="1046125">Tuple1 Scalar</para>
      </td>
     <td valign="middle"><para unique="1046127">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1046129">EVEX.vvvv (r)</para>
      </td>
     <td valign="middle"><para unique="1046131">ModRM:r/m (r)</para>
