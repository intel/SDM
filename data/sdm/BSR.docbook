    <tr>
     <td valign="middle"><para unique="1261253">RM</para>
      </td>
     <td valign="middle"><para unique="1261255">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261257">ModRM:r/m (r)</para>
