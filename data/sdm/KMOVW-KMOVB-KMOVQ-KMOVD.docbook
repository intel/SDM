    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261204">VEX.L0.0F.W0 90 /r</para>
      <para unique="1261205">KMOVW k1, k2/m16</para>
      </td>
     <td><para unique="1261209">RM</para>
      </td>
     <td><para unique="1261211">V/V</para>
      </td>
     <td><para unique="1261830">AVX512F</para>
      <para unique="1261831">OR AVX10.1</para>
      </td>
     <td><para unique="1261218">Move 16 bits mask from k2/m16 and store the result in k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261220">VEX.L0.66.0F.W0 90 /r </para>
      <para unique="1261221">KMOVB k1, k2/m8</para>
