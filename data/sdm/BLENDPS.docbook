 <shortdesc>Blend Packed Single Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
