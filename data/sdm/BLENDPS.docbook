      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="97.90848pt"/>
   <col width="111.06576000000001pt"/>
   <col width="25.518240000000002pt"/>
   <col width="47.999520000000004pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">66 0F 3A 0C /r ib</para>
      <para unique="1261207">BLENDPS xmm1, xmm2/m128, imm8</para>
      </td>
     <td><para unique="1261211">RMI</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE4_1</para>
      </td>
     <td><para unique="1261217">Select packed single precision floating-point values from xmm1 and xmm2/m128 from mask specified in imm8 and store the values into xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.66.0F3A.WIG 0C /r ib</para>
      <para unique="1261220">VBLENDPS xmm1, xmm2, xmm3/m128, imm8</para>
      </td>
     <td><para unique="1261224">RVMI</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261228">AVX</para>
      </td>
     <td><para unique="1261230">Select packed single precision floating-point values from xmm2 and xmm3/m128 from mask in imm8 and store the values in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261232">VEX.256.66.0F3A.WIG 0C /r ib</para>
      <para unique="1261233">VBLENDPS ymm1, ymm2, ymm3/m256, imm8</para>
      </td>
     <td><para unique="1261237">RVMI</para>
      </td>
     <td><para unique="1261239">V/V</para>
      </td>
     <td><para unique="1261241">AVX</para>
      </td>
     <td><para unique="1261243">Select packed single precision floating-point values from ymm2 and ymm3/m256 from mask in imm8 and store the values in ymm1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
