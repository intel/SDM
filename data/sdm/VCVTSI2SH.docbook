<instruction name="VCVTSI2SH">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert a Signed Doubleword/Quadword Integer to an FP16 Value</shortdesc>
 <encoding_table><table unique="1045885">
   <col width="153.5976pt"/>
   <col width="28.02528pt"/>
   <col width="48.00024pt"/>
   <col width="81.69984pt"/>
   <col width="200.02464pt"/>
   <thead><tr>
     <th><para unique="1045887">Opcode/</para>
      <para unique="1045888">Instruction</para>
      </th>
     <th><para unique="1045890">Op/</para>
      <para unique="1045891">En</para>
      </th>
     <th><para unique="1045893">64/32 Bit Mode Support</para>
      </th>
     <th><para unique="1045895">CPUID Feature Flag</para>
      </th>
     <th><para unique="1045897">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046294">EVEX.LLIG.F3.MAP5.W0 2A /r</para>
      <para unique="1046295">VCVTSI2SH xmm1, xmm2, r32/m32 {er}</para>
      </td>
     <td><para unique="1046297">A</para>
      </td>
     <td><para unique="1046302">V/V<footnote><para unique="1046301" format="TableFootnote">Outside of 64b mode, the EVEX.W field is ignored. The instruction behaves as if W=0 was used.</para>
        </footnote></para>
      </td>
     <td><para unique="1046304">AVX512_FP16 </para>
      <para unique="1046308">OR AVX10.1<anchor id="+269366"/></para>
      </td>
     <td><para unique="1046310">Convert the signed doubleword integer in r32/m32 to an FP16 value and store the result in xmm1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046282">EVEX.LLIG.F3.MAP5.W1 2A /r</para>
      <para unique="1046283">VCVTSI2SH xmm1, xmm2, r64/m64 {er}</para>
      </td>
     <td><para unique="1046285">A</para>
      </td>
     <td><para unique="1046287">V/N.E.</para>
      </td>
     <td><para unique="1046289">AVX512_FP16 </para>
      <para unique="1046290">OR AVX10.1<anchor id="+689189"/></para>
      </td>
     <td><para unique="1046292">Convert the signed quadword integer in r64/m64 to an FP16 value and store the result in xmm1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
