<instruction name="VSM3MSG1">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Perform Initial Calculation for the Next Four SM3 Message Words</shortdesc>
 <encoding_table><table unique="1047410">
   <col width="62.346959999999996pt"/>
   <col width="88.704pt"/>
   <col width="39.900240000000004pt"/>
