<instruction name="VRNDSCALESS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Round Scalar Float32 Value to Include a Given Number of Fraction Bits</shortdesc>
 <encoding_table><table unique="1046081">
   <col width="77.6232pt"/>
   <col width="77.6232pt"/>
   <col width="29.244239999999998pt"/>
   <col width="48.74976pt"/>
   <col width="68.91624pt"/>
   <col width="209.58336pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1046083">Opcode/</para>
      <para unique="1046084">Instruction</para>
      </th>
     <th><para unique="1046088">Op / En</para>
      </th>
     <th><para unique="1046090">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1046092">CPUID Feature Flag</para>
      </th>
     <th><para unique="1046094">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1046561">EVEX.LLIG.66.0F3A.W0 0A /r ib</para>
      <para unique="1046562">VRNDSCALESS xmm1 {k1}{z}, xmm2, xmm3/m32{sae}, imm8</para>
      </td>
     <td><para unique="1046566">A</para>
      </td>
     <td><para unique="1046568">V/V</para>
      </td>
     <td><para unique="1046573">AVX512F</para>
      <para unique="1046577">OR AVX10.1<anchor id="+699939"/></para>
      </td>
     <td><para unique="1046579">Rounds scalar single-precision floating-point value in xmm3/m32 to a number of fraction bits specified by the imm8 field. Stores the result in xmm1 register under writemask.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1046112">
   <thead><tr>
     <th valign="middle"><para unique="1046114">Op/En</para>
      </th>
     <th valign="middle"><para unique="1046116">Tuple Type</para>
      </th>
     <th valign="middle"><para unique="1046118">Operand 1 </para>
      </th>
     <th valign="middle"><para unique="1046120">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1046122">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1046124">Operand 4</para>
      </th>
     </tr>
    </thead><col width="38.64960000000001pt"/>
   <col width="65.04912pt"/>
   <col width="101.56968pt"/>
   <col width="103.27392pt"/>
   <col width="100.02600000000001pt"/>
   <col width="104.6808pt"/>
   <tbody>
    <tr>
     <td valign="middle"><para unique="1046126">A</para>
      </td>
     <td valign="middle"><para unique="1046128">Tuple1 Scalar</para>
      </td>
     <td valign="middle"><para unique="1046130">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1046132">EVEX.vvvv (r)</para>
      </td>
