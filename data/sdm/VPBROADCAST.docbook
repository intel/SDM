 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1047000">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1047005" format="xIndent1">EVEX-encoded instructions, see <link unique="1047003" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#57777: 06_Table: Table 2-23. Type 6 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;23, &#8220;Type 6 Class Exception Conditions.&#8221;</link></para>
  <para unique="1047009" format="xIndent1">EVEX-encoded instructions, syntax with reg/mem operand, see <link unique="1047007" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#70360: 06_Table: Table 2-53. Type E6 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;55, &#8220;Type E6 Class Exception Conditions.&#8221;</link></para>
  <para unique="1047010" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1047011">If VEX.L = 0 for VPBROADCASTQ, VPBROADCASTI128.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  <para unique="1047012">	If EVEX.L&#8217;L = 0 for VBROADCASTI32X4/VBROADCASTI64X2.</para>
  <para unique="1047013">	If EVEX.L&#8217;L &lt; 10b for VBROADCASTI32X8/VBROADCASTI64X4.</para>
  </subsection>
 </instruction>
