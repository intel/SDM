    <tr>
     <td colspan="2"><para unique="1091945">EVEX.256.66.0F38.W1 28 /r</para>
      <para unique="1091946">VPMULDQ ymm1 {k1}{z}, ymm2, ymm3/m256/m64bcst</para>
