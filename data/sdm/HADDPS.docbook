     <td valign="middle"><para unique="1261267">RVM</para>
      </td>
     <td valign="middle"><para unique="1261269">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261271">VEX.vvvv (r)</para>
      </td>
