<instruction name="HADDPS">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Packed Single Precision Floating-Point Horizontal Add</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op/ En</para>
      </th>
     <th><para unique="1261200">64/32-bit Mode</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.90448pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F2 0F 7C /r</para>
      <para unique="1261207">HADDPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261211">RM</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE3</para>
      </td>
     <td><para unique="1261217">Horizontal add packed single precision floating-point values from xmm2/m128 to xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.F2.0F.WIG 7C /r</para>
      <para unique="1261220">VHADDPS xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1261224">RVM</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261228">AVX</para>
      </td>
     <td><para unique="1261230">Horizontal add packed single precision floating-point values from xmm2 and xmm3/mem.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261232">VEX.256.F2.0F.WIG 7C /r</para>
      <para unique="1261233">VHADDPS ymm1, ymm2, ymm3/m256</para>
      </td>
     <td><para unique="1261237">RVM</para>
      </td>
     <td><para unique="1261239">V/V</para>
      </td>
     <td><para unique="1261241">AVX</para>
      </td>
     <td><para unique="1261243">Horizontal add packed single precision floating-point values from ymm2 and ymm3/mem.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1261245">
   <col width="51.0084pt"/>
   <col width="113.38416000000001pt"/>
   <col width="118.7028pt"/>
