    <tr>
     <td colspan="2"><para unique="1046096">VEX.128.66.0F38.W0 0C /r </para>
      <para unique="1046097">VPERMILPS xmm1, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1046101">A</para>
      </td>
     <td><para unique="1046103">V/V</para>
      </td>
     <td><para unique="1046108">AVX</para>
      </td>
     <td><para unique="1046110">Permute single precision floating-point values in xmm2 using controls from xmm3/m128 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046112">VEX.128.66.0F3A.W0 04 /r ib</para>
