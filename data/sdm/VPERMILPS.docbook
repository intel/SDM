 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046583">None.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046588" format="xIndent1">Non-EVEX-encoded instruction, see <link unique="1046586" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions.&#8221;</link></para>
  <para unique="1046589" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1046590">If VEX.W = 1.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  <para unique="1046594" format="xIndent1">EVEX-encoded instruction, see <link unique="1046592" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#87496: 06_Table: Table 2-50. Type E4NF Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;52, &#8220;Type E4NF Class Exception Conditions.&#8221;</link></para>
  <para unique="1046595" format="xIndent1">Additionally:</para>
  <variablelist>
   <variablelistentry>
    <term>#UD</term>
    <listitem><para unique="1046596">If either (E)VEX.vvvv != 1111B and with imm8.</para>
     </listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
