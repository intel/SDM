</string><string>VPERMILPS __m512 _mm512_maskz_permutevar_ps( __mmask16 k, __m512i i, __m512 a);</string><string>
</string><string>VPERMILPS __m256 _mm256_mask_permutevar_ps(__m256 s, __mmask8 k, __m256 i, __m256 a);</string><string>
</string><string>VPERMILPS __m256 _mm256_maskz_permutevar_ps( __mmask8 k, __m256 i, __m256 a);</string><string>
</string><string>VPERMILPS __m128 _mm_mask_permutevar_ps(__m128 s, __mmask8 k, __m128 i, __m128 a);</string><string>
</string><string>VPERMILPS __m128 _mm_maskz_permutevar_ps( __mmask8 k, __m128 i, __m128 a);</string><string>
</string><string>VPERMILPS __m128 _mm_permute_ps (__m128 a, int control);</string><string>
</string><string>VPERMILPS __m256 _mm256_permute_ps (__m256 a, int control);</string><string>
</string><string>VPERMILPS __m128 _mm_permutevar_ps (__m128 a, __m128i control);</string><string>
</string><string>VPERMILPS __m256 _mm256_permutevar_ps (__m256 a, __m256i control);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046583">
   <string>None.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046588" format="xIndent1">
   <string>Non-EVEX-encoded instruction, see </string><link linkend="25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions"><string>Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions.&#8221;</string></link></para>
  <para unique="1046589" format="xIndent1">
   <string>Additionally:</string></para>
  <variablelist>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If VEX.W = 1.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>EVEX-encoded instruction, see </string></term>
    <listitem><link linkend="87496: 06_Table: Table 2-50. Type E4NF Class Exception Conditions"><string>Table&#160;2&#8209;52, &#8220;Type E4NF Class Exception Conditions.&#8221;</string></link></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>Additionally:</string></term>
    <listitem/>
    </variablelistentry>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If either (E)VEX.vvvv != 1111B and with imm8.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
