     <td><para unique="1092097">(AVX512VL AND</para>
      <para unique="1092101">AVX512F) OR AVX10.1</para>
      </td>
     <td><para unique="1092103">Multiply the packed dword signed integers in ymm2 and ymm3/m256/m32bcst and store the low 32 bits of each product in ymm1 under writemask k1.</para>
      </td>
