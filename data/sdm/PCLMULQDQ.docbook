  <para unique="1091682" format="xIndent1">
   <string>See </string><link linkend="25627: 06_Table: Table 2-21. Type 4 Class Exception Conditions"><string>Table&#160;2&#8209;21, &#8220;Type 4 Class Exception Conditions,&#8221;</string></link><string> additionally:</string></para>
  <variablelist>
   <variablelistentry>
    <term><string>#UD</string></term>
    <listitem><string>If VEX.L = 1.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>EVEX-encoded: See </string></term>
    <listitem><link linkend="87496: 06_Table: Table 2-50. Type E4NF Class Exception Conditions"><string>Table&#160;2&#8209;52, &#8220;Type E4NF Class Exception Conditions.&#8221;</string></link></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
