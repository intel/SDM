     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op / En</para>
      </th>
     <th><para unique="1261200">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F3 0F 2D /r</para>
      <para unique="1261207">CVTSS2SI r32, xmm1/m32</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE</para>
      </td>
     <td><para unique="1261217">Convert one single precision floating-point value from xmm1/m32 to one signed doubleword integer in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">F3 REX.W 0F 2D /r</para>
      <para unique="1261220">CVTSS2SI r64, xmm1/m32</para>
      </td>
     <td><para unique="1261224">A</para>
      </td>
     <td><para unique="1261226">V/N.E.</para>
      </td>
     <td><para unique="1261228">SSE</para>
      </td>
     <td><para unique="1261230">Convert one single precision floating-point value from xmm1/m32 to one signed quadword integer in r64.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261235">VEX.LIG.F3.0F.W0 2D /r <footnote><para unique="1261234" format="TableFootnote">Software should ensure VCVTSS2SI is encoded with VEX.L=0. Encoding VCVTSS2SI with VEX.L=1 may encounter unpredictable behavior across different processor generations.</para>
        </footnote></para>
      <para unique="1261236">VCVTSS2SI r32, xmm1/m32</para>
      </td>
     <td><para unique="1261240">A</para>
      </td>
     <td><para unique="1261242">V/V</para>
      </td>
     <td><para unique="1261247">AVX</para>
      </td>
     <td><para unique="1261249">Convert one single precision floating-point value from xmm1/m32 to one signed doubleword integer in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261251">VEX.LIG.F3.0F.W1 2D /r <superscript>1</superscript></para>
      <para unique="1261252">VCVTSS2SI r64, xmm1/m32</para>
      </td>
     <td><para unique="1261256">A</para>
      </td>
     <td><para unique="1261258">V/N.E.<footnote><para unique="1261292" format="TableFootnote">VEX.W1/EVEX.W1 in non-64 bit is ignored; the instructions behaves as if the W0 version is used.</para>
        </footnote></para>
      </td>
     <td><para unique="1261263">AVX</para>
      </td>
     <td><para unique="1261265">Convert one single precision floating-point value from xmm1/m32 to one signed quadword integer in r64.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261741">EVEX.LLIG.F3.0F.W0 2D /r</para>
      <para unique="1261742">VCVTSS2SI r32, xmm1/m32{er}</para>
      </td>
     <td><para unique="1261746">B</para>
      </td>
     <td><para unique="1261748">V/V</para>
      </td>
     <td><para unique="1261753">AVX512F</para>
      <para unique="1261757">OR AVX10.1<anchor id="+952244"/></para>
      </td>
     <td><para unique="1261759">Convert one single precision floating-point value from xmm1/m32 to one signed doubleword integer in r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261761">EVEX.LLIG.F3.0F.W1 2D /r</para>
      <para unique="1261762">VCVTSS2SI r64, xmm1/m32{er}</para>
