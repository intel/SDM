     <td><para unique="1261768">V/N.E.<superscript>2</superscript></para>
      </td>
     <td><para unique="1261773">AVX512F</para>
      <para unique="1261774">OR AVX10.1 <anchor id="+661247"/></para>
      </td>
     <td><para unique="1261776">Convert one single precision floating-point value from xmm1/m32 to one signed quadword integer in r64.</para>
      </td>
     </tr>
    </tbody>
