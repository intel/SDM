 <shortdesc>Convert Scalar Double Precision Floating-Point Value to Scalar Single Precision Floating-Point Value</shortdesc>
 <encoding_table><table unique="1261191">
   <col width="76.37328pt"/>
   <col width="76.37328pt"/>
   <col width="32.69376pt"/>
   <col width="48.74976pt"/>
   <col width="58.74984pt"/>
   <col width="219.16728pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1261193">Opcode/</para>
      <para unique="1261194">Instruction</para>
      </th>
     <th><para unique="1261198">Op / En</para>
      </th>
     <th><para unique="1261200">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1261202">CPUID Feature Flag</para>
      </th>
     <th><para unique="1261204">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">F2 0F 5A /r</para>
      <para unique="1261207">CVTSD2SS xmm1, xmm2/m64</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE2</para>
      </td>
     <td><para unique="1261217">Convert one double precision floating-point value in xmm2/m64 to one single precision floating-point value in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.LIG.F2.0F.WIG 5A /r</para>
      <para unique="1261220">VCVTSD2SS xmm1,xmm2, xmm3/m64</para>
      </td>
     <td><para unique="1261224">B</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261231">AVX</para>
      </td>
     <td><para unique="1261233">Convert one double precision floating-point value in xmm3/m64 to one single precision floating-point value and merge with high bits in xmm2.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261683">EVEX.LLIG.F2.0F.W1 5A /r</para>
      <para unique="1261684">VCVTSD2SS xmm1 {k1}{z}, xmm2, xmm3/m64{er}</para>
      </td>
     <td><para unique="1261688">C</para>
      </td>
     <td><para unique="1261690">V/V</para>
      </td>
     <td><para unique="1261695">AVX512F</para>
      <para unique="1261699">OR AVX10.1<anchor id="+312451"/></para>
      </td>
     <td><para unique="1261701">Convert one double precision floating-point value in xmm3/m64 to one single precision floating-point value and merge with high bits in xmm2 under writemask k1.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
