<instruction name="VMOVSH">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Move Scalar FP16 Value</shortdesc>
 <longdesc><para unique="1046202">
   <string>This instruction moves a FP16 value to a register or memory location.</string></para>
  <para unique="1046203">
   <string>The two register-only forms are aliases and differ only in where their operands are encoded; this is a side effect of the encodings selected.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <para unique="1046229">
   <string>VMOVSH __m128h _mm_load_sh (void const* mem_addr);</string></para>
  <para unique="1046230">
   <string>VMOVSH __m128h _mm_mask_load_sh (__m128h src, __mmask8 k, void const* mem_addr);</string></para>
  <para unique="1046231">
   <string>VMOVSH __m128h _mm_maskz_load_sh (__mmask8 k, void const* mem_addr);</string></para>
  <para unique="1046232">
   <string>VMOVSH __m128h _mm_mask_move_sh (__m128h src, __mmask8 k, __m128h a, __m128h b);</string></para>
  <para unique="1046233">
   <string>VMOVSH __m128h _mm_maskz_move_sh (__mmask8 k, __m128h a, __m128h b);</string></para>
  <para unique="1046234">
   <string>VMOVSH __m128h _mm_move_sh (__m128h a, __m128h b);</string></para>
  <para unique="1046235">
   <string>VMOVSH void _mm_mask_store_sh (void * mem_addr, __mmask8 k, __m128h a);</string></para>
  <para unique="1046236">
   <string>VMOVSH void _mm_store_sh (void * mem_addr, __m128h a);</string></para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046238">
   <string>None</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046243" format="xIndent1">
   <string>EVEX-encoded instruction, see </string><link linkend="74973: 06_Table: Table 2-51. Type E5 Class Exception Conditions"><string>Table&#160;2&#8209;53, &#8220;Type E5 Class Exception Conditions.&#8221;</string></link></para>
  </subsection>
 </instruction>
