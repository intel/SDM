     <th><para unique="1046093">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td><para unique="1046594">EVEX.LLIG.F3.MAP5.W0 10 /r</para>
      <para unique="1046595">VMOVSH xmm1{k1}{z}, m16</para>
      </td>
     <td><para unique="1046597">A</para>
      </td>
     <td><para unique="1046599">V/V</para>
      </td>
     <td><para unique="1046601">AVX512_FP16 </para>
      <para unique="1046605">OR AVX10.1<anchor id="+581137"/></para>
      </td>
     <td><para unique="1046607">Move FP16 value from m16 to xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046582">EVEX.LLIG.F3.MAP5.W0 11 /r</para>
      <para unique="1046583">VMOVSH m16{k1}, xmm1</para>
      </td>
     <td><para unique="1046585">B</para>
      </td>
     <td><para unique="1046587">V/V</para>
      </td>
     <td><para unique="1046589">AVX512_FP16 </para>
      <para unique="1046590">OR AVX10.1<anchor id="+173352"/></para>
      </td>
     <td><para unique="1046592">Move low FP16 value from xmm1 to m16 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046570">EVEX.LLIG.F3.MAP5.W0 10 /r</para>
      <para unique="1046571">VMOVSH xmm1{k1}{z}, xmm2, xmm3</para>
      </td>
     <td><para unique="1046573">C</para>
      </td>
     <td><para unique="1046575">V/V</para>
      </td>
     <td><para unique="1046577">AVX512_FP16 </para>
      <para unique="1046578">OR AVX10.1<anchor id="+496061"/></para>
      </td>
     <td><para unique="1046580">Move low FP16 values from xmm3 to xmm1 subject to writemask k1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1046558">EVEX.LLIG.F3.MAP5.W0 11 /r</para>
      <para unique="1046559">VMOVSH xmm1{k1}{z}, xmm2, xmm3</para>
      </td>
     <td><para unique="1046561">D</para>
      </td>
     <td><para unique="1046563">V/V</para>
      </td>
     <td><para unique="1046565">AVX512_FP16 </para>
      <para unique="1046566">OR AVX10.1<anchor id="+934070"/></para>
      </td>
     <td><para unique="1046568">Move low FP16 values from xmm3 to xmm1 subject to writemask k1. Bits 127:16 of xmm2 are copied to xmm1[127:16].</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
