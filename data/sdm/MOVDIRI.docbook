   <col width="215.154pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091407">NP 0F 38 F9 /r</para>
      <para unique="1091408">MOVDIRI m32, r32</para>
      </td>
     <td><para unique="1091412">A</para>
      </td>
     <td><para unique="1091414">V/V</para>
      </td>
     <td><para unique="1091416">MOVDIRI</para>
      </td>
     <td><para unique="1091418">Move doubleword from r32 to m32 using direct store.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091420">NP REX.W + 0F 38 F9 /r</para>
      <para unique="1091421">MOVDIRI m64, r64</para>
      </td>
     <td><para unique="1091425">A</para>
      </td>
     <td><para unique="1091427">V/N.E.</para>
      </td>
     <td><para unique="1091429">MOVDIRI</para>
      </td>
     <td><para unique="1091431">Move quadword from r64 to m64 using direct store. </para>
      </td>
     </tr>
    </tbody>
