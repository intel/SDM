<instruction name="KUNPCKBW/KUNPCKWD/KUNPCKDQ">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Unpack for Mask Registers</shortdesc>
 <longdesc><para unique="1261265">
   <string>Unpacks the lower 8/16/32 bits of the second and third operands (source operands) into the low part of the first operand (destination operand), starting from the low bytes. The result is zero-extended in the destination.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>KUNPCKBW __mmask16 _mm512_kunpackb(__mmask16 a, __mmask16 b);</string><string>
</string><string>KUNPCKDQ __mmask64 _mm512_kunpackd(__mmask64 a, __mmask64 b);</string><string>
</string><string>KUNPCKWD __mmask32 _mm512_kunpackw(__mmask32 a, __mmask32 b);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1261287">
   <string>None.</string></para>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1261289">
   <string>None.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1261294" format="xIndent1">
   <string>See </string><link linkend="42536: 06_Table: Table 2-63. TYPE K20 Exception Definition (VEX-Encoded OpMask"><string>Table&#160;2&#8209;65, &#8220;TYPE K20 Exception Definition (VEX-Encoded OpMask Instructions w/o Memory Arg).&#8221;</string></link></para>
  </subsection>
 </instruction>
