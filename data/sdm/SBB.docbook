  <variablelist>
   <variablelistentry>
    <term>#GP</term>
    <listitem><para unique="1091753">If a memory operand effective address is outside the CS, DS, ES, FS, or GS segment limit.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
