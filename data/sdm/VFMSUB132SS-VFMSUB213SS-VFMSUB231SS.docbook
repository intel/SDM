    <tr>
     <td colspan="2"><para unique="1045901">VEX.LIG.66.0F38.W0 9B /r </para>
      <para unique="1045902">VFMSUB132SS xmm1, xmm2, xmm3/m32</para>
      </td>
     <td><para unique="1045906">A</para>
      </td>
     <td><para unique="1045908">V/V</para>
      </td>
     <td><para unique="1045910">FMA</para>
      </td>
     <td><para unique="1045912">Multiply scalar single precision floating-point value from xmm1 and xmm3/m32, subtract xmm2 and put result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1045914">VEX.LIG.66.0F38.W0 AB /r</para>
      <para unique="1045915">VFMSUB213SS xmm1, xmm2, xmm3/m32 </para>
      </td>
