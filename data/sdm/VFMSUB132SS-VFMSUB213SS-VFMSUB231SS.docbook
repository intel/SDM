    <tr>
     <td colspan="2"><para unique="1046461">EVEX.LLIG.66.0F38.W0 AB /r </para>
      <para unique="1046462">VFMSUB213SS xmm1 {k1}{z}, xmm2, xmm3/m32{er} </para>
