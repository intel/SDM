   <tbody>
    <tr>
     <td colspan="2"><para unique="1091405">F3 0F 70 /r ib</para>
      <para unique="1091406">PSHUFHW xmm1, xmm2/m128, imm8</para>
      </td>
     <td><para unique="1091410">A</para>
      </td>
     <td><para unique="1091412">V/V</para>
      </td>
     <td><para unique="1091414">SSE2</para>
      </td>
     <td><para unique="1091416">Shuffle the high words in xmm2/m128 based on the encoding in imm8 and store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091418">VEX.128.F3.0F.WIG 70 /r ib</para>
      <para unique="1091419">VPSHUFHW xmm1, xmm2/m128, imm8</para>
      </td>
     <td><para unique="1091423">A</para>
      </td>
     <td><para unique="1091425">V/V</para>
      </td>
     <td><para unique="1091427">AVX</para>
      </td>
     <td><para unique="1091429">Shuffle the high words in xmm2/m128 based on the encoding in imm8 and store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091431">VEX.256.F3.0F.WIG 70 /r ib</para>
      <para unique="1091432">VPSHUFHW ymm1, ymm2/m256, imm8</para>
      </td>
     <td><para unique="1091436">A</para>
      </td>
     <td><para unique="1091438">V/V</para>
      </td>
     <td><para unique="1091440">AVX2</para>
      </td>
     <td><para unique="1091442">Shuffle the high words in ymm2/m256 based on the encoding in imm8 and store the result in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1092000">EVEX.128.F3.0F.WIG 70 /r ib</para>
      <para unique="1092001">VPSHUFHW xmm1 {k1}{z}, xmm2/m128, imm8</para>
      </td>
