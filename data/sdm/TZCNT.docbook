    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091457">A</para>
      </td>
     <td valign="middle"><para unique="1091459">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091461">ModRM:r/m (r)</para>
