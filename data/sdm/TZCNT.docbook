   <col width="113.64552pt"/>
   <col width="120.91464pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091447">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091449">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091451">Operand 2</para>
      </th>
