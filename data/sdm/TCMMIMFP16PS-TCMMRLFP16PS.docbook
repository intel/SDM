    <tr>
     <td colspan="2"><para unique="1092654">VEX.128.66.0F38.W0 6C 11:rrr:bbb</para>
      <para unique="1092655">TCMMIMFP16PS tmm1, tmm2, tmm3</para>
      </td>
     <td><para unique="1092659">A</para>
      </td>
     <td><para unique="1092661">V/N.E.</para>
      </td>
     <td><para unique="1092663">AMX_COMPLEX</para>
