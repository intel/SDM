    <tr>
     <td colspan="2"><para unique="1092667">VEX.128.NP.0F38.W0 6C 11:rrr:bbb</para>
      <para unique="1092668">TCMMRLFP16PS tmm1, tmm2, tmm3</para>
      </td>
     <td><para unique="1092672">A</para>
      </td>
     <td><para unique="1092674">V/N.E.</para>
      </td>
     <td><para unique="1092676">AMX_COMPLEX</para>
      </td>
     <td><para unique="1092678">Matrix multiply complex elements from tmm2 and tmm3, and accumulate the real part into single precision elements in tmm1.</para>
