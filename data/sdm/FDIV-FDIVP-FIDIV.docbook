      </th>
     <th><para unique="1261200">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261202">Description</para>
      </th>
     </tr>
    </thead><col width="85.518pt"/>
   <col width="117.16416000000001pt"/>
   <col width="42.06312pt"/>
   <col width="54.03384pt"/>
   <col width="213.09552pt"/>
   <tbody>
    <tr>
     <td><para unique="1261204">D8 /6</para>
      </td>
     <td><para unique="1261206">FDIV m32fp</para>
      </td>
