     <td><para unique="1261248">Valid</para>
      </td>
     <td><para unique="1261250">Valid</para>
      </td>
     <td><para unique="1261252">Divide ST(i) by ST(0), store result in ST(i), and pop the register stack.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261254">DE F9</para>
