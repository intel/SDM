      </td>
     <td><para unique="1261220">Valid</para>
      </td>
     <td><para unique="1261222">Divide ST(0) by m64fp and store result in ST(0).</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261224">D8 F0+i</para>
      </td>
     <td><para unique="1261226">FDIV ST(0), ST(i)</para>
      </td>
     <td><para unique="1261228">Valid</para>
