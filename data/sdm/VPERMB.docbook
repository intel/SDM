     <td colspan="2"><para unique="1046549">EVEX.128.66.0F38.W0 8D /r</para>
      <para unique="1046550">VPERMB xmm1 {k1}{z}, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1046554">A</para>
      </td>
     <td><para unique="1046556">V/V</para>
      </td>
     <td><para unique="1046558">(AVX512VL AND</para>
      <para unique="1046559">AVX512_VBMI) OR AVX10.1<anchor id="+412389"/></para>
      </td>
     <td><para unique="1046564">Permute bytes in xmm3/m128 using byte indexes in xmm2 and store the result in xmm1 using writemask k1.</para>
