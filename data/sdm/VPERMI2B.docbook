     <td colspan="2"><para unique="1046549">EVEX.128.66.0F38.W0 75 /r</para>
      <para unique="1046550">VPERMI2B xmm1 {k1}{z}, xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1046554">A</para>
      </td>
     <td><para unique="1046556">V/V</para>
      </td>
     <td><para unique="1046558">(AVX512VL AND</para>
      <para unique="1046559">AVX512_VBMI) OR AVX10.1<anchor id="+649982"/></para>
      </td>
     <td><para unique="1046564">Permute bytes in xmm3/m128 and xmm2 using byte indexes in xmm1 and store the byte results in xmm1 using writemask k1.</para>
