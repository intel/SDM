  </operand_table>
 <longdesc><para unique="1045959">This instruction converts packed FP16 values in the source operand to unsigned quadword integers in the destina&#173;tion operand.</para>
  <para unique="1045960">When a conversion is inexact, a truncated (round toward zero) value is returned. If a converted result cannot be represented in the destination format, the floating-point invalid exception is raised, and if this exception is masked, the integer value FFFFFFFF_FFFFFFFFH is returned.</para>
  <para unique="1045961">The destination elements are updated according to the writemask.</para>
  </longdesc>
 <operation>
  <section level="7">
   <title unique="1045963">VCVTTPH2UQQ dest, src</title>
   <programlisting>VL = 128, 256 or 512
KL := VL / 64
FOR j := 0 TO KL-1:
	IF k1[j] OR *no writemask*:
		IF *SRC is memory* and EVEX.b = 1:
			tsrc := SRC.fp16[0]
		ELSE
			tsrc := SRC.fp16[j]
		DEST.qword[j] := Convert_fp16_to_unsigned_integer64_truncate(tsrc)
	ELSE IF *zeroing*:
		DEST.qword[j] := 0
	// else dest.qword[j] remains unchanged
DEST[MAXVL-1:VL] := 0</programlisting>
   </section>
  </operation>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting>VCVTTPH2UQQ __m512i _mm512_cvtt_roundph_epu64 (__m128h a, int sae);
VCVTTPH2UQQ __m512i _mm512_mask_cvtt_roundph_epu64 (__m512i src, __mmask8 k, __m128h a, int sae);
VCVTTPH2UQQ __m512i _mm512_maskz_cvtt_roundph_epu64 (__mmask8 k, __m128h a, int sae);
VCVTTPH2UQQ __m128i _mm_cvttph_epu64 (__m128h a);
VCVTTPH2UQQ __m128i _mm_mask_cvttph_epu64 (__m128i src, __mmask8 k, __m128h a);
VCVTTPH2UQQ __m128i _mm_maskz_cvttph_epu64 (__mmask8 k, __m128h a);
VCVTTPH2UQQ __m256i _mm256_cvttph_epu64 (__m128h a);
VCVTTPH2UQQ __m256i _mm256_mask_cvttph_epu64 (__m256i src, __mmask8 k, __m128h a);
VCVTTPH2UQQ __m256i _mm256_maskz_cvttph_epu64 (__mmask8 k, __m128h a);
VCVTTPH2UQQ __m512i _mm512_cvttph_epu64 (__m128h a);
VCVTTPH2UQQ __m512i _mm512_mask_cvttph_epu64 (__m512i src, __mmask8 k, __m128h a);
VCVTTPH2UQQ __m512i _mm512_maskz_cvttph_epu64 (__mmask8 k, __m128h a);</programlisting>
  </subsection>
 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1045993">Invalid, Precision.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1045998" format="xIndent1">EVEX-encoded instructions, see <link unique="1045996" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#35185: 06_Table: Table 2-46. Type E2 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;48, &#8220;Type E2 Class Exception Conditions.&#8221;</link></para>
  </subsection>
 </instruction>
