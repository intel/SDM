<instruction name="RDPID">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Read Processor ID</shortdesc>
 <encoding_table><table unique="1091390">
   <col width="94.66488pt"/>
   <col width="94.66488pt"/>
   <col width="27.74376pt"/>
   <col width="39.800160000000005pt"/>
   <col width="58.49352pt"/>
   <col width="200.87712000000002pt"/>
   <thead><tr>
     <th colspan="2"><para unique="1091392">Opcode/</para>
      <para unique="1091393">Instruction</para>
      </th>
     <th><para unique="1091397">Op/ En</para>
      </th>
     <th><para unique="1091399">64/32-bit Mode</para>
      </th>
     <th><para unique="1091401">CPUID</para>
      <para unique="1091402">Feature Flag</para>
      </th>
     <th><para unique="1091404">Description</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1091406">F3 0F C7 /7</para>
      <para unique="1091407">RDPID r32</para>
      </td>
     <td><para unique="1091411">R</para>
      </td>
     <td><para unique="1091413">N.E./V</para>
      </td>
     <td><para unique="1091415">RDPID</para>
      </td>
     <td><para unique="1091417">Read IA32_TSC_AUX into r32.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091419">F3 0F C7 /7</para>
      <para unique="1091420">RDPID r64</para>
      </td>
     <td><para unique="1091424">R</para>
      </td>
     <td><para unique="1091426">V/N.E.</para>
      </td>
     <td><para unique="1091428">RDPID</para>
      </td>
     <td><para unique="1091430">Read IA32_TSC_AUX into r64.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091432">
   <col width="42.73704pt"/>
   <col width="112.00175999999999pt"/>
   <col width="115.63848pt"/>
   <col width="119.0916pt"/>
   <col width="122.5008pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091434">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091436">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091438">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091440">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091442">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091444">R</para>
      </td>
     <td valign="middle"><para unique="1091446">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091448">N/A</para>
      </td>
     <td valign="middle"><para unique="1091450">N/A</para>
