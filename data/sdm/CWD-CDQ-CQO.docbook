<instruction name="CWD/CDQ/CQO">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Convert Word to Doubleword/Convert Doubleword to Quadword</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
