 <operand_table><table unique="1091504">
   <col width="43.4952pt"/>
   <col width="117.59832pt"/>
   <col width="113.58144pt"/>
   <col width="112.42008pt"/>
   <col width="124.87464pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091506">Op/En</para>
