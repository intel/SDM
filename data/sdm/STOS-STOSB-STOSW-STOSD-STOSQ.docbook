    </variablelistentry>
   <variablelistentry>
    <term>#AC(0)</term>
    <listitem><para unique="1091615">If alignment checking is enabled and an unaligned memory reference is made.</para>
     </listitem>
    </variablelistentry>
   <variablelistentry>
    <term>#UD </term>
