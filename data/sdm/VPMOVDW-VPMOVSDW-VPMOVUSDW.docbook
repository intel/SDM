 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046403">
   <string>None.</string></para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046408">
   <string>EVEX-encoded instruction, see </string><link linkend="70360: 06_Table: Table 2-53. Type E6 Class Exception Conditions"><string>Table&#160;2&#8209;55, &#8220;Type E6 Class Exception Conditions.&#8221;</string></link></para>
  <para unique="1046409">
   <string>Additionally:</string></para>
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>	If EVEX.vvvv != 1111B.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 </instruction>
