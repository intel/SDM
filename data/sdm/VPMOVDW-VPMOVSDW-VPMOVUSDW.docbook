    <tr>
     <td colspan="2"><para unique="1046873">EVEX.128.F3.0F38.W0 33 /r</para>
      <para unique="1046874">VPMOVDW xmm1/m64 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046878">A</para>
      </td>
     <td><para unique="1046880">V/V</para>
      </td>
     <td><para unique="1046882">(AVX512VL AND</para>
      <para unique="1046886">AVX512F) OR AVX10.1<anchor id="+388305"/></para>
      </td>
     <td><para unique="1046891">Converts 4 packed double-word integers from xmm2 into 4 packed word integers in xmm1/m64 with truncation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046856">EVEX.128.F3.0F38.W0 23 /r</para>
      <para unique="1046857">VPMOVSDW xmm1/m64 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046861">A</para>
      </td>
     <td><para unique="1046863">V/V</para>
      </td>
     <td><para unique="1046865">(AVX512VL AND</para>
      <para unique="1046869">AVX512F) OR AVX10.1<anchor id="+696027"/></para>
      </td>
     <td><para unique="1046871">Converts 4 packed signed double-word integers from xmm2 into 4 packed signed word integers in ymm1/m64 using signed saturation under writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046839">EVEX.128.F3.0F38.W0 13 /r</para>
      <para unique="1046840">VPMOVUSDW xmm1/m64 {k1}{z}, xmm2</para>
      </td>
     <td><para unique="1046844">A</para>
      </td>
     <td><para unique="1046846">V/V</para>
      </td>
     <td><para unique="1046848">(AVX512VL AND</para>
      <para unique="1046852">AVX512F) OR AVX10.1<anchor id="+484015"/></para>
      </td>
     <td><para unique="1046854">Converts 4 packed unsigned double-word integers from xmm2 into 4 packed unsigned word integers in xmm1/m64 using unsigned saturation under writemask k1.</para>
      </td>
     </tr>
    <tr>
