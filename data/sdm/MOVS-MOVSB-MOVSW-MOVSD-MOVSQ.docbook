 <operand_table><table unique="1091504">
   <col width="44.69472pt"/>
   <col width="111.48552000000001pt"/>
   <col width="116.71560000000001pt"/>
   <col width="118.6416pt"/>
   <col width="118.18296pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091506">Op/En</para>
      </th>
