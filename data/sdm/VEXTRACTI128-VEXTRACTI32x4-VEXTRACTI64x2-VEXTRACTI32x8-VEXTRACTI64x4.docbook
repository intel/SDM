     <td><para unique="1046651">V/V</para>
      </td>
     <td><para unique="1046653">AVX512DQ </para>
      <para unique="1046654">OR AVX10.1<anchor id="+841678"/></para>
      </td>
     <td><para unique="1046656">Extract 256 bits of double-word integer values from zmm2 and store results in ymm1/m256 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046627">EVEX.512.66.0F3A.W1 3B /r ib</para>
      <para unique="1046628">VEXTRACTI64x4 ymm1/m256 {k1}{z}, zmm2, imm8</para>
