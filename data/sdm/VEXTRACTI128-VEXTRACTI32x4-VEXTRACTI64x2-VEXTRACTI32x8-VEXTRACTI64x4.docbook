  <section level="7">
   <title unique="1046255">VEXTRACTI128 (memory destination form)</title>
   <programlisting>CASE (imm8[0]) OF
	0: DEST[127:0] := SRC1[127:0]
	1: DEST[127:0] := SRC1[255:128]
ESAC.</programlisting>
