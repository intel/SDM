     <td><para unique="1046663">B</para>
      </td>
     <td><para unique="1046665">V/V</para>
      </td>
     <td><para unique="1046667">AVX512DQ </para>
      <para unique="1046668">OR AVX10.1<anchor id="+869058"/></para>
      </td>
     <td><para unique="1046670">Extract 128 bits of quad-word integer values from zmm2 and store results in xmm1/m128 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1046644">EVEX.512.66.0F3A.W0 3B /r ib</para>
      <para unique="1046645">VEXTRACTI32X8 ymm1/m256 {k1}{z}, zmm2, imm8</para>
