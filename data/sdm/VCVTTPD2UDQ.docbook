 <shortdesc>Convert With Truncation Packed Double Precision Floating-Point Values to Packed Unsigned Doubleword Integers</shortdesc>
 <encoding_table><table unique="1045886">
   <col width="73.99872pt"/>
   <col width="73.99872pt"/>
   <col width="28.494pt"/>
