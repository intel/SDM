    <tr>
     <td><para unique="1046840">EVEX.128.66.MAP6.W0 98 /r</para>
      <para unique="1046841">VFMADD132PH xmm1{k1}{z}, xmm2, xmm3/m128/m16bcst</para>
      </td>
     <td><para unique="1046843">A</para>
      </td>
     <td><para unique="1046845">V/V</para>
      </td>
     <td><para unique="1046847">(AVX512_FP16 AND AVX512VL) OR AVX10.1<anchor id="+884989"/></para>
      </td>
     <td><para unique="1046852">Multiply packed FP16 values from xmm1 and xmm3/m128/m16bcst, add to xmm2, and store the result in xmm1.</para>
      </td>
     </tr>
    <tr>
