      </td>
     <td valign="middle"><para unique="1261269">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1261271">VEX.vvvv (r)</para>
      </td>
     <td valign="middle"><para unique="1261273">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1261275">imm8[3:0]</para>
      </td>
