    <tr>
     <td><para unique="1091452">0F 22 /r</para>
      </td>
     <td><para unique="1091453">MOV CR0&#8211;CR7, r32</para>
      </td>
     <td><para unique="1091457">RM</para>
      </td>
     <td><para unique="1091459">N.E.</para>
      </td>
     <td><para unique="1091461">Valid</para>
      </td>
     <td><para unique="1091463">Move r32 to control register.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091465">0F 22 /r</para>
      </td>
     <td><para unique="1091466">MOV CR0&#8211;CR7, r64</para>
      </td>
     <td><para unique="1091470">RM</para>
      </td>
     <td><para unique="1091472">Valid </para>
      </td>
     <td><para unique="1091474">N.E.</para>
      </td>
     <td><para unique="1091476">Move r64 to extended control register.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091478">REX.R + 0F 22 /0</para>
      </td>
     <td><para unique="1091479">MOV CR8, r64</para>
