   <tbody>
    <tr>
     <td><para unique="1091407">0F 20/r</para>
      </td>
     <td><para unique="1091408">MOV r32, CR0&#8211;CR7</para>
      </td>
     <td><para unique="1091412">MR</para>
      </td>
     <td><para unique="1091414">N.E.</para>
      </td>
     <td><para unique="1091416">Valid</para>
      </td>
     <td><para unique="1091418">Move control register to r32.</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091420">0F 20/r</para>
      </td>
     <td><para unique="1091421">MOV r64, CR0&#8211;CR7</para>
      </td>
     <td><para unique="1091425">MR</para>
      </td>
     <td><para unique="1091427">Valid</para>
      </td>
     <td><para unique="1091429">N.E.</para>
      </td>
     <td><para unique="1091431">Move extended control register to r64. </para>
      </td>
     </tr>
    <tr>
     <td><para unique="1091433">REX.R + 0F 20 /0</para>
      </td>
     <td><para unique="1091434">MOV r64, CR8</para>
      </td>
     <td><para unique="1091438">MR</para>
      </td>
     <td><para unique="1091440">Valid </para>
      </td>
     <td><para unique="1091442">N.E.</para>
      </td>
     <td><para unique="1091450">Move extended CR8 to r64.<footnote><para unique="1091446" format="TableFootnote">MOV CR* instructions, except for MOV CR8, are serializing instructions. MOV CR8 is not architecturally defined as a serializing instruc&#173;tion. For more information, see <link unique="1091448" linkend="&lt;c&gt;__sdm_vol3A_ch11.fm#36559: H1Heading: Chapter 7 Multiple-Processor Management" xrefstyle="ChapterNum_CR">Chapter 11</link> in the Intel&#174; 64 and IA&#8209;32 Architectures Software Developer&#8217;s Manual, Volume 3A.</para>
        </footnote></para>
      </td>
