 <operand_table><table unique="1091491">
   <col width="47.103840000000005pt"/>
   <col width="112.43016pt"/>
   <col width="116.88695999999999pt"/>
   <col width="112.5684pt"/>
   <col width="121.48056pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091493">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091495">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091497">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091499">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091501">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091503">MR</para>
      </td>
     <td valign="middle"><para unique="1091505">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091507">ModRM:reg (r)</para>
      </td>
     <td valign="middle"><para unique="1091509">N/A</para>
      </td>
     <td valign="middle"><para unique="1091511">N/A</para>
      </td>
     </tr>
    <tr>
     <td valign="middle"><para unique="1091513">RM</para>
      </td>
     <td valign="middle"><para unique="1091515">ModRM:reg (w)</para>
      </td>
     <td valign="middle"><para unique="1091517">ModRM:r/m (r)</para>
      </td>
     <td valign="middle"><para unique="1091519">N/A</para>
      </td>
