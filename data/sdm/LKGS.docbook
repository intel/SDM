 <shortdesc>Load Kernel GS Base</shortdesc>
 <encoding_table><table unique="1271451">
   <thead><tr>
     <th><para unique="1271453">Opcode</para>
      </th>
     <th><para unique="1271455">Instruction</para>
      </th>
     <th><para unique="1271457">Op/ En</para>
      </th>
     <th><para unique="1271459">64-Bit Mode</para>
      </th>
     <th><para unique="1271461">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1271463">Description</para>
      </th>
     </tr>
    </thead><col width="98.25984pt"/>
   <col width="111.46464pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="182.15424000000002pt"/>
   <tbody>
    <tr>
     <td><para unique="1271465">F2 0F 00 /6</para>
      </td>
     <td><para unique="1271467">LKGS r/m16</para>
      </td>
     <td><para unique="1271469">A</para>
      </td>
     <td><para unique="1271471">Valid</para>
      </td>
     <td><para unique="1271473">N.E.</para>
      </td>
     <td><para unique="1271475">Load GS using r/m16, placing the base address instead in the IA32_KERNEL_GS_BASE MSR.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1271477">
   <col width="42.27624pt"/>
   <col width="110.98584pt"/>
   <col width="118.68336pt"/>
   <col width="116.67671999999999pt"/>
   <col width="123.34752pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1271479">Op/En</para>
      </th>
     <th valign="middle"><para unique="1271481">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1271483">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1271485">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1271487">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1271489">A</para>
      </td>
     <td valign="middle"><para unique="1271491">16-bit selector</para>
      </td>
     <td valign="middle"><para unique="1271493">N/A</para>
      </td>
     <td valign="middle"><para unique="1271495">N/A</para>
