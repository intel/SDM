    <tr>
     <td colspan="2"><para unique="1261206">NP 0F 54 /r</para>
      <para unique="1261207">ANDPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE</para>
      </td>
     <td><para unique="1261217">Return the bitwise logical AND of packed single precision floating-point values in xmm1 and xmm2/mem. </para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.0F 54 /r</para>
      <para unique="1261220">VANDPS xmm1,xmm2, xmm3/m128</para>
      </td>
