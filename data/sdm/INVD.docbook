 <operand_table><table unique="1261220">
   <col width="47.88864pt"/>
   <col width="111.65616pt"/>
   <col width="116.89416pt"/>
   <col width="115.69896pt"/>
   <col width="117.58247999999999pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1261222">Op/En</para>
      </th>
     <th valign="middle"><para unique="1261224">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1261226">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1261228">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1261230">Operand 4</para>
      </th>
