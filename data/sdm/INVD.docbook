<instruction name="INVD">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Invalidate Internal Caches</shortdesc>
 <encoding_table><table unique="1261191">
   <thead><tr>
     <th><para unique="1261196">Opcode<footnote><para unique="1261195" format="TableFootnote">See the IA-32 Architecture Compatibility section below.</para>
        </footnote></para>
      </th>
     <th><para unique="1261198">Instruction</para>
      </th>
     <th><para unique="1261200">Op/ En</para>
      </th>
     <th><para unique="1261202">64-Bit Mode</para>
      </th>
     <th><para unique="1261204">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1261206">Description</para>
      </th>
     </tr>
    </thead><col width="97.90848pt"/>
   <col width="111.06576000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="180.65448pt"/>
   <tbody>
    <tr>
     <td><para unique="1261208">0F 08</para>
      </td>
     <td><para unique="1261210">INVD</para>
      </td>
     <td><para unique="1261212">ZO</para>
      </td>
     <td><para unique="1261214">Valid</para>
      </td>
     <td><para unique="1261216">Valid</para>
      </td>
     <td><para unique="1261218">Flush internal caches; initiate flushing of external caches.</para>
      </td>
     </tr>
