     <td><para unique="1261331"/>
      </td>
     <td><para unique="1261333"/>
      </td>
     <td><para unique="1261335">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261337">&#8722;F or &#8722;I</para>
      </td>
     <td><para unique="1261339">&#8722;0</para>
      </td>
     <td><para unique="1261341">+0</para>
      </td>
     <td><para unique="1261343">+F or +I</para>
      </td>
     <td><para unique="1261345">+ &#8734;</para>
      </td>
     <td><para unique="1261347">NaN</para>
      </td>
     </tr>
    <tr>
     <td><para unique="1261349"/>
      </td>
     <td><para unique="1261351">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261353">*</para>
      </td>
     <td><para unique="1261355">+ &#8734;</para>
      </td>
     <td><para unique="1261357">+ &#8734;</para>
      </td>
     <td><para unique="1261359">+ &#8734;</para>
      </td>
     <td><para unique="1261361">+ &#8734;</para>
      </td>
     <td><para unique="1261363">+ &#8734;</para>
      </td>
     <td><para unique="1261365">NaN</para>
      </td>
     </tr>
    <tr>
     <th><para unique="1261367"/>
      </th>
