    <tr>
     <td><para unique="1261439"/>
      </td>
     <td><para unique="1261441">+ &#8734;</para>
      </td>
     <td><para unique="1261443">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261445">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261447">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261449">&#8722; &#8734;</para>
      </td>
     <td><para unique="1261451">&#8722; &#8734;</para>
      </td>
