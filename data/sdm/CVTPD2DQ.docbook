    <tr>
     <td colspan="2"><para unique="1261841">EVEX.256.F2.0F.W1 E6 /r</para>
      <para unique="1261842">VCVTPD2DQ xmm1 {k1}{z}, ymm2/m256/m64bcst {er}</para>
