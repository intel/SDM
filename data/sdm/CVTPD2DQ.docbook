      </td>
     <td><para unique="1261850">AVX10.2<superscript>1</superscript></para>
      </td>
     <td><para unique="1261852">Convert four packed double precision floating-point values in ymm2/m256/m64bcst to four signed doubleword integers in xmm1 subject to writemask k1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261824">EVEX.512.F2.0F.W1 E6 /r</para>
      <para unique="1261825">VCVTPD2DQ ymm1 {k1}{z}, zmm2/m512/m64bcst {er}</para>
      </td>
     <td><para unique="1261829">B</para>
      </td>
     <td><para unique="1261831">V/V</para>
