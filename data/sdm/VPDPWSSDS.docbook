  <para unique="1046240">VPDPWSSDS __m256i _mm256_mask_dpwssd_epi32(__m256i, __mmask8, __m256i, __m256i);</para>
  <para unique="1046241">VPDPWSSDS __m256i _mm256_maskz_dpwssd_epi32(__mmask8, __m256i, __m256i, __m256i);</para>
  <para unique="1046242">VPDPWSSDS __m512i _mm512_dpwssd_epi32(__m512i, __m512i, __m512i);</para>
  <para unique="1046243">VPDPWSSDS __m512i _mm512_mask_dpwssd_epi32(__m512i, __mmask16, __m512i, __m512i);</para>
