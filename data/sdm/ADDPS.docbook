    </thead><tbody>
    <tr>
     <td colspan="2"><para unique="1261206">NP 0F 58 /r</para>
      <para unique="1261207">ADDPS xmm1, xmm2/m128</para>
      </td>
     <td><para unique="1261211">A</para>
      </td>
     <td><para unique="1261213">V/V</para>
      </td>
     <td><para unique="1261215">SSE</para>
      </td>
     <td><para unique="1261217">Add packed single precision floating-point values from xmm2/m128 to xmm1 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261219">VEX.128.0F.WIG 58 /r</para>
      <para unique="1261220">VADDPS xmm1,xmm2, xmm3/m128</para>
      </td>
     <td><para unique="1261224">B</para>
      </td>
     <td><para unique="1261226">V/V</para>
      </td>
     <td><para unique="1261231">AVX</para>
      </td>
     <td><para unique="1261233">Add packed single precision floating-point values from xmm3/m128 to xmm2 and store result in xmm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1261235">VEX.256.0F.WIG 58 /r</para>
      <para unique="1261236">VADDPS ymm1, ymm2, ymm3/m256</para>
      </td>
     <td><para unique="1261240">B</para>
      </td>
     <td><para unique="1261242">V/V</para>
      </td>
     <td><para unique="1261247">AVX</para>
      </td>
     <td><para unique="1261249">Add packed single precision floating-point values from ymm3/m256 to ymm2 and store result in ymm1.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1263027">EVEX.128.0F.W0 58 /r</para>
      <para unique="1263028">VADDPS xmm1 {k1}{z}, xmm2, xmm3/m128/m32bcst</para>
      </td>
     <td><para unique="1263032">C</para>
      </td>
     <td><para unique="1263034">V/V</para>
      </td>
     <td><para unique="1263036">(AVX512VL AND</para>
