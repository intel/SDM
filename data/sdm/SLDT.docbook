<instruction name="SLDT">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Store Local Descriptor Table Register</shortdesc>
 <encoding_table><table unique="1091390">
   <thead><tr>
     <th><para unique="1091392">Opcode*</para>
      </th>
     <th><para unique="1091394">Instruction</para>
      </th>
     <th><para unique="1091396">Op/ En</para>
      </th>
     <th><para unique="1091398">64-Bit Mode</para>
      </th>
     <th><para unique="1091400">Compat/&#8232;Leg Mode</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="97.90848pt"/>
   <col width="111.06576000000001pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="181.404pt"/>
   <tbody>
    <tr>
     <td><para unique="1091404">0F 00 /0</para>
      </td>
     <td><para unique="1091406">SLDT <italic>r/m16</italic></para>
      </td>
     <td><para unique="1091408">M</para>
      </td>
     <td><para unique="1091410">Valid </para>
      </td>
     <td><para unique="1091412">Valid</para>
      </td>
     <td><para unique="1091414">Stores segment selector from LDTR in <italic>r/m16</italic>.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091416">
   <col width="41.48424pt"/>
   <col width="116.97048pt"/>
   <col width="112.25016pt"/>
   <col width="117.48455999999999pt"/>
   <col width="121.53024pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091418">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091420">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091422">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091424">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091426">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091428">M</para>
      </td>
     <td valign="middle"><para unique="1091430">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091432">N/A</para>
      </td>
     <td valign="middle"><para unique="1091434">N/A</para>
