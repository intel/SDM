 <subsection title="SIMD Floating-Point Exceptions">
  <para unique="1046158">Invalid, Denormal.</para>
  </subsection>
 <subsection title="Other Exceptions">
  <para unique="1046163" format="xIndent1">EVEX-encoded instructions, see <link unique="1046161" linkend="&lt;c&gt;__sdm_vol2A_ch02.fm#35185: 06_Table: Table 2-46. Type E2 Class Exception Conditions" xrefstyle="Table All - no page with period">Table&#160;2&#8209;48, &#8220;Type E2 Class Exception Conditions.&#8221;</link></para>
  </subsection>
