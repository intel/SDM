    <tr>
     <td valign="middle"><para unique="1261257">RM</para>
      </td>
     <td valign="middle"><para unique="1261259">ModRM:reg (r, w)</para>
      </td>
     <td valign="middle"><para unique="1261261">ModRM:r/m (r)</para>
