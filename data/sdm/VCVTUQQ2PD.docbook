 <shortdesc>Convert Packed Unsigned Quadword Integers to Packed Double Precision Floating-Point Values</shortdesc>
 <encoding_table><table unique="1045887">
   <col width="55.12392pt"/>
   <col width="78.426pt"/>
   <col width="30.45024pt"/>
