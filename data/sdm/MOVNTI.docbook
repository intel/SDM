<instruction name="MOVNTI">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Store Doubleword Using Non-Temporal Hint</shortdesc>
 <encoding_table><table unique="1091389">
   <thead><tr>
     <th colspan="2"><para unique="1091391">Opcode /</para>
      <para unique="1091392">Instruction</para>
      </th>
     <th><para unique="1091396">Op/ En</para>
      </th>
     <th><para unique="1091398">64/32 bit Mode Support</para>
      </th>
     <th><para unique="1091400">CPUID Feature Flag</para>
      </th>
     <th><para unique="1091402">Description</para>
      </th>
     </tr>
    </thead><col width="82.51776pt"/>
   <col width="93.6072pt"/>
   <col width="24.767999999999997pt"/>
   <col width="48.024pt"/>
   <col width="46.728pt"/>
   <col width="218.15352000000001pt"/>
   <tbody>
    <tr>
     <td colspan="2"><para unique="1091404">NP 0F C3 /<italic>r</italic></para>
      <para unique="1091405">MOVNTI <italic>m32</italic>, <italic>r32</italic></para>
      </td>
     <td><para unique="1091409">MR</para>
      </td>
     <td><para unique="1091411">V/V</para>
      </td>
     <td><para unique="1091413">SSE2</para>
      </td>
     <td><para unique="1091415">Move doubleword from <italic>r32</italic> to <italic>m32</italic> using non-temporal hint.</para>
      </td>
     </tr>
    <tr>
     <td colspan="2"><para unique="1091417">NP REX.W + 0F C3 /<italic>r</italic></para>
      <para unique="1091418">MOVNTI <italic>m64,</italic> <italic>r64</italic></para>
      </td>
     <td><para unique="1091422">MR</para>
      </td>
     <td><para unique="1091424">V/N.E.</para>
      </td>
     <td><para unique="1091426">SSE2</para>
      </td>
     <td><para unique="1091428">Move quadword from <italic>r64</italic> to <italic>m64</italic> using non-temporal hint.</para>
      </td>
     </tr>
    </tbody>
   </table>
  </encoding_table>
 <operand_table><table unique="1091430">
   <col width="45.9612pt"/>
   <col width="116.24616pt"/>
   <col width="120.0204pt"/>
   <col width="108.36864pt"/>
   <col width="119.12400000000001pt"/>
   <thead><tr>
     <th valign="middle"><para unique="1091432">Op/En</para>
      </th>
     <th valign="middle"><para unique="1091434">Operand 1</para>
      </th>
     <th valign="middle"><para unique="1091436">Operand 2</para>
      </th>
     <th valign="middle"><para unique="1091438">Operand 3</para>
      </th>
     <th valign="middle"><para unique="1091440">Operand 4</para>
      </th>
     </tr>
    </thead><tbody>
    <tr>
     <td valign="middle"><para unique="1091442">MR</para>
      </td>
     <td valign="middle"><para unique="1091444">ModRM:r/m (w)</para>
      </td>
     <td valign="middle"><para unique="1091446">ModRM:reg (r)</para>
      </td>
     <td valign="middle"><para unique="1091448">N/A</para>
      </td>
     <td valign="middle"><para unique="1091450">N/A</para>
