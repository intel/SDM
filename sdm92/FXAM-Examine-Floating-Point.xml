    </variablelistentry>
   <variablelistentry>
    <term><string>C0, C2, C3</string></term>
    <listitem><string>See </string><link linkend="26055: 06_Table: Table 3-45. FXAM Results"><string>Table 3&#8209;44</string></link><string>.</string></listitem>
    </variablelistentry>
