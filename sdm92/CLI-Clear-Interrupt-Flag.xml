 <subsection title="Compatibility Mode Exceptions">
  <para unique="1261361" format="xIndent1">
   <string>Same exceptions as in protected mode.</string></para>
  </subsection>
 <subsection title="64-Bit Mode Exceptions">
  <para unique="1261363" format="xIndent1">
