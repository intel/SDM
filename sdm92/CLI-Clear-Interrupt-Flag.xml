 <subsection title="Flags Affected">
  <para unique="1261350">
   <string>Either the IF flag or the VIF flag is cleared to 0. Other flags are unaffected.</string></para>
  </subsection>
 <subsection title="Protected Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#GP(0) </string></term>
    <listitem><string>If CPL is greater than IOPL and PVI mode is not active.</string></listitem>
    <listitem><string>If CPL is greater than IOPL and less than 3.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Real-Address Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
 <subsection title="Virtual-8086 Mode Exceptions">
  <variablelist>
   <variablelistentry>
    <term><string>#GP(0) </string></term>
    <listitem><string>If IOPL is less than 3 and VME mode is not active.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>#UD </string></term>
    <listitem><string>If the LOCK prefix is used.</string></listitem>
    </variablelistentry>
   </variablelist>
