       <string>NOTES:</string></para>
      <para unique="1261421" format="TableFootnote">
       <string>F	Means finite floating-point value.</string></para>
      <para unique="1261422" format="TableFootnote">
       <string>*	Indicates floating-point invalid-operation (#IA) exception.</string></para>
      <para unique="1261423" format="TableFootnote">
       <string>**	Indicates floating-point zero-divide (#Z) exception.</string></para>
