<instruction name="TILERELEASE">
 <copyright>Copyright (C) Intel Corporation. All Rights Reserved.</copyright>
 <shortdesc>Release Tile</shortdesc>
 <longdesc><para unique="1091444">
   <string>This instruction returns TILECFG and TILEDATA to the INIT state.</string></para>
  <para unique="1091445">
   <string>Any attempt to execute the TILERELEASE instruction inside an Intel TSX transaction will result in a transaction abort.</string></para>
  </longdesc>
 <subsection title="Intel C/C++ Compiler Intrinsic Equivalent">
  <programlisting><string>TILERELEASE			 void _tile_release(void);</string><string>
</string></programlisting>
  </subsection>
 <subsection title="Flags Affected">
  <para unique="1091453">
   <string>None.</string></para>
  </subsection>
 <subsection title="Exceptions">
  <para unique="1091458" format="xIndent1">
   <string>AMX-E6; see </string><link linkend="77014: 02_Level: 2.10 Intel&#174; AMX Instruction Exception Classes"><string>Section 2.10, &#8220;Intel&#174; AMX Instruction Exception Classes,&#8221;</string></link><string> for details.</string></para>
  </subsection>
 </instruction>
