 <subsection title="FPU Flags Affected">
  <variablelist>
   <variablelistentry>
    <term><string>C1</string></term>
    <listitem><string>Set to 0 if stack underflow occurred.</string></listitem>
    <listitem><string>Set if result was rounded up; cleared otherwise.</string></listitem>
    </variablelistentry>
   <variablelistentry>
    <term><string>C0, C2, C3 </string></term>
    <listitem><string>Undefined.</string></listitem>
    </variablelistentry>
   </variablelist>
  </subsection>
