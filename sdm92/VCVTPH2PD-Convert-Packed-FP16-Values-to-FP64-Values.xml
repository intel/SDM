</string><string>VCVTPH2PD __m512d _mm512_mask_cvt_roundph_pd (__m512d src, __mmask8 k, __m128h a, int sae);</string><string>
</string><string>VCVTPH2PD __m512d _mm512_maskz_cvt_roundph_pd (__mmask8 k, __m128h a, int sae);</string><string>
</string><string>VCVTPH2PD __m128d _mm_cvtph_pd (__m128h a);</string><string>
